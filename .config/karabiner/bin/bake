#!/bin/bash
# bake — compile karabiner.ts into karabiner.json (and raycast_bindings.json), canonicalise,
# and stage. A new Raycast binding asks "Always allow" on first use: `dotfiles raycast link prime
# <slug>` opens it once. Commit the result, then `dotfiles switch` makes it live.
#
# Every generated JSON in the repo goes through json-sort (~/.config/bin/json-sort, the one
# place JSON canonicalisation lives), so a regenerated file diffs only where the data moved.

set -euo pipefail

# The clone's karabiner directory, where this script really lives: ~/.config/karabiner/karabiner.json
# is Nix's read-only copy of the committed file, placed by the next `dotfiles switch`.
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
readonly REPO_ROOT
readonly OUT_RAW="${REPO_ROOT}/karabiner.json"
# Generated by npm run build from the same TypeScript tables; committed as an artifact for
# reading and diffing. The `dotfiles raycast link` widget runs the generator itself instead of reading it.
readonly OUT_BINDINGS="${REPO_ROOT}/karabiner.ts/src/raycast_bindings.json"
readonly OUT_TMP="${REPO_ROOT}/karabiner.json.tmp"
readonly JSON_SORT="${XDG_CONFIG_HOME}/bin/json-sort"

function main() {
	if ! command -v jq &>/dev/null; then
		echo "jq not found, refusing to bake" >&2
		exit 1
	fi

	bake::generate
	bake::parameters
	bake::sort
	bake::stage
}

function bake::generate() (
	cd "${REPO_ROOT}/karabiner.ts"

	if [[ ! -d node_modules ]]; then
		echo "Installing dependencies..." >&2
		npm install --silent
	fi

	KARABINER_JSON="${OUT_RAW}" npm run build
	echo "Generated raw output | OUT_RAW='${OUT_RAW}'" >&2
)

function bake::parameters() {
	# karabiner.ts omits complex_modifications.parameters, but Karabiner-Elements
	# rewrites the file to add these defaults whenever it loads. Emit them here so
	# the committed file already matches and Karabiner has nothing to rewrite.
	# bake::sort orders them canonically afterward.
	local params='{
		"basic.simultaneous_threshold_milliseconds": 50,
		"basic.to_delayed_action_delay_milliseconds": 500,
		"basic.to_if_alone_timeout_milliseconds": 1000,
		"basic.to_if_held_down_threshold_milliseconds": 500,
		"mouse_motion_to_scroll.speed": 100
	}'
	jq --argjson params "${params}" \
		'.profiles[].complex_modifications.parameters = $params' \
		< "${OUT_RAW}" > "${OUT_TMP}"
	mv "${OUT_TMP}" "${OUT_RAW}"
	echo "Injected complex_modifications.parameters defaults" >&2
}

function bake::sort() {
	# json-sort ships in the same dotfiles as this script; without it the outputs would not be
	# canonical, so that is a broken checkout, not something to work around.
	if [[ ! -x "${JSON_SORT}" ]]; then
		echo "json-sort not found, refusing to bake | path='${JSON_SORT}'" >&2
		exit 1
	fi
	"${JSON_SORT}" --in-place "${OUT_RAW}" "${OUT_BINDINGS}"
}

function bake::stage() {
	if ! command -v git &>/dev/null; then
		echo "git not found, skipping stage" >&2
		return
	fi
	# git df may not be configured on a fresh machine
	if ! git df rev-parse --git-dir &>/dev/null; then
		echo "dotfiles repo not configured, skipping stage" >&2
		return
	fi
	git df add "${OUT_RAW}" "${OUT_BINDINGS}"
	git df diff --staged "${OUT_RAW}" "${OUT_BINDINGS}"
}

main "$@"
