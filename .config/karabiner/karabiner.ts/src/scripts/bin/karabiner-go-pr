#!/bin/bash
#
# Karabiner Hyper+P handler. Opens http://go/pr/<clipboard> in the default
# browser. Skips Raycast/UI entirely — go/ resolves via the Airtable
# corporate DNS, so `open` lands on the same redirect Raycast would.

set -u

source "${REPO_LIB:?}/notify.bash"

clip="$(pbpaste)"
# Clipboards from Slack/PRs often carry a trailing newline that breaks the URL.
clip="${clip//[$'\r\n']/}"
clip="${clip#"${clip%%[![:space:]]*}"}"
clip="${clip%"${clip##*[![:space:]]}"}"

readonly ALERT_GROUP="karabiner-go-pr"

if [[ -z "${clip}" ]]; then
  notify_transient "go/pr" "clipboard is empty" "${ALERT_GROUP}"
  exit 1
fi

# Accept the forms a PR number is usually copied in: "221676", "#221676",
# "(#221676)" from a commit subject, or "221676." from the end of a sentence.
# Kept in a variable: bash's [[ misparses the ';' in the bracket expression inline.
readonly PR_NUMBER_REGEX='^\(?#?([0-9]+)[.,;:)]*$'
if [[ ! "${clip}" =~ ${PR_NUMBER_REGEX} ]]; then
  notify_transient "go/pr" "${clip:0:20} is not a PR number" "${ALERT_GROUP}"
  exit 1
fi
pr="${BASH_REMATCH[1]}"

open "http://go/pr/${pr}"
