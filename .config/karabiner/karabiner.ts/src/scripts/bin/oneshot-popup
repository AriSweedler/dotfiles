#!/usr/bin/env zsh
# Hyper+O: the tmux-oneshot picker from any app, as a popup on the tmux client used
# last; with no tmux server or client, in a fresh Terminal window. Extra args pass
# through (`oneshot-popup caffeinate` runs that entry with no picker).
#
# Latency is this script's whole job, and on a Mac with an endpoint agent every
# process spawn costs ~17 ms, so the popup path is one exec: tmux itself resolves the
# target (the most recently active session's most recently active client) and expands
# -d against that client's current pane. Terminal is not brought forward here — the
# Karabiner rule does that natively (software_function.open_application), in parallel,
# the instant the key goes down (src/shortcuts.ts).
set -u
err="$(tmux display-popup -E -T ' oneshot ' -b rounded -w 80% -h 60% \
  -d '#{pane_current_path}' "${HOME}/.config/bin/tmux-oneshot" "$@" 2>&1)"; rc=$?
# -E hands back the picker's own rc (esc is 130, a failed entry its rc) with nothing
# on stderr; only tmux's own complaint (no server, no client) means no popup opened.
if (( rc == 0 )) || [[ -z "${err}" ]]; then
  exit "${rc}"
fi
source "${HOME}/.config/zsh/plugins/log.zsh"
log::warn "No tmux popup; opening the picker in a Terminal window | tmux='${err}'"
/usr/bin/osascript -e 'tell application "Terminal" to do script "exec $HOME/.config/bin/tmux-oneshot"' \
                   -e 'tell application "Terminal" to activate' > /dev/null
