#!/usr/bin/env zsh
# Hyper+O: the tmux-oneshot picker from any app. Karabiner has no tty, so open
# it as a popup on the most recently active tmux client and bring Terminal
# forward; with no tmux client, run it in a fresh Terminal window. Extra args
# pass through (`oneshot-popup caffeinate` runs that entry with no picker).
set -u
source "${HOME}/.config/zsh/plugins/log.zsh"
client="$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)"
if [[ -n "${client}" ]]; then
  session="$(tmux display-message -p -c "${client}" '#{session_name}')"
  open -a Terminal
  tmux display-popup -c "${client}" -t "${session}" -E -T ' oneshot ' -b rounded -w 80% -h 60% \
    -d '#{pane_current_path}' "${HOME}/.config/bin/tmux-oneshot" "$@"
else
  log::warn "No tmux client; opening the picker in a Terminal window"
  /usr/bin/osascript -e 'tell application "Terminal" to do script "exec $HOME/.config/bin/tmux-oneshot"' \
                     -e 'tell application "Terminal" to activate' > /dev/null
fi
