#!/usr/bin/env zsh
#
# notif-center — read and click macOS notifications.
#
# One tool, two engines, fast path chosen automatically:
#   • list  → reads the Notification Center SQLite DB (READ-ONLY). Fast (~0.1s),
#             and the only source of the posting app's bundle id + history.
#   • click → if the target notification stores a URL (Calendar's ical://, web
#             pushes…), just `open` it — fast. Otherwise (Slack & co. store no
#             URL) fall back to AX: expand the stack, then AXPress the target,
#             which opens AND dismisses it.
#   • tree → AX debugging of the live tray.
#
# Supersedes the earlier notif-center / notif-center-sqlite / notif-center-click.
# READ-ONLY DB guarantee: never touches the original DB — copies db+wal+shm to a
# temp dir and queries the copy. See DESIGN.md for the schema/version caveats.
# Each macOS version's AX layout is a file in ../notif-center/macos/ (DESIGN.md § OS support).
#
# stdout carries data; stderr carries logs.

set -euo pipefail

export OTTO_LOG_NOTIF_GROUP="notif-center"
export OTTO_LOG_NOTIF_TITLE="notif-center"
export OTTO_DEBUG="${OTTO_DEBUG:-0}"
source "${ARI_ZSHLIB:-${HOME}/.config/zsh/plugins}/log.zsh"

readonly DB_DIR="${HOME}/Library/Group Containers/group.com.apple.usernoted/db2"

# The same relative path in the clone (.config/bin → .config/notif-center) and in the store
# package ($out/bin → $out/notif-center).
readonly LAYOUT_DIR="${NOTIF_CENTER_LAYOUT_DIR:-${0:A:h:h}/notif-center/macos}"
# Where a new layout file is written: the clone, never the read-only store copy.
readonly LAYOUT_SRC_DIR="${HOME}/dotfiles/.config/notif-center/macos"
readonly REPORT_FILE="/tmp/notif-center/version-mismatch.md"
readonly EDIT_WINDOW="${HOME}/.config/bin/tmux-edit-window"

# --- DB reader (sqlite) ---
#
# Joins record→app, decodes each bplist, applies the active/app/match filters,
# emits human TSV or the JSON contract. Apple's /usr/bin/python3 (fast start,
# ships plistlib + sqlite3). argv: db app match limit show_all fmt
read -r -d '' DECODE <<'PYEOF' || true
import sys, time, json, sqlite3, plistlib
from datetime import datetime

db, app_pat, match_pat, limit, show_all, fmt = sys.argv[1:7]
limit = int(limit)
show_all = show_all == "1"
now_mac = time.time() - 978307200

# Friendly-name layer: static bundle id → display name. Edit to add apps; an
# unknown bundle id falls through to its raw id. Static on purpose — no Launch
# Services / Spotlight lookups (deterministic, no perms, no latency).
APP_NAMES = {
    "com.tinyspeck.slackmacgap": "Slack",
    "fr.julienxx.oss.terminal-notifier": "terminal-notifier",
    "com.apple.ical": "Calendar",
    "com.apple.iCal": "Calendar",
    "us.zoom.xos": "Zoom",
}

def app_name(bundle_id):
    return APP_NAMES.get(bundle_id, bundle_id)

def oneline(s):
    return str(s).replace("\n", " ").replace("\r", " ").replace("\t", " ")

def mac_iso(t):
    return datetime.fromtimestamp(t + 978307200).isoformat(timespec="seconds") if t else None

def mac_epoch(t):
    return int(t + 978307200) if t else None

# Open the *copy* read-write (never the original). A read-only connection can't
# build the WAL index, so it may miss the newest committed frames; opening rw
# lets sqlite merge the full WAL and see fresh notifications.
con = sqlite3.connect(db)

# Active set = UUIDs currently shown in Notification Center. Each app's
# displayed.list blob is a flat concatenation of 16-byte record UUIDs; a record
# is active iff its uuid is in some app's list. (Use `displayed`, not
# `delivered`: the latter accumulates all delivered history.) --all shows all.
active_set = set()
for (blob,) in con.execute("SELECT list FROM displayed WHERE list IS NOT NULL"):
    for i in range(0, len(blob) - (len(blob) % 16), 16):
        active_set.add(bytes(blob[i:i + 16]))

# Past notifications only (delivered_date < now drops future-scheduled, e.g.
# Calendar reminders). LIMIT pushed to SQL only when no post-query filter could
# drop rows — i.e. only under --all with no filters.
sql = ("SELECT r.rec_id, r.delivered_date, r.request_date, r.uuid, a.identifier, r.data "
       "FROM record r LEFT JOIN app a ON a.app_id = r.app_id "
       "WHERE r.delivered_date > 0 AND r.delivered_date < ? "
       "ORDER BY r.delivered_date DESC")
params = [now_mac]
if limit and show_all and not app_pat and not match_pat:
    sql += " LIMIT ?"
    params.append(limit)
rows = con.execute(sql, params)

results = []
shown = 0
for rec_id, dd, rq, uuid, ident, data in rows:
    is_active = bytes(uuid) in active_set
    if not show_all and not is_active:
        continue
    ident = ident or "(unknown)"
    name = app_name(ident)
    if app_pat and app_pat.lower() not in ident.lower() and app_pat.lower() not in name.lower():
        continue
    # Decode the bplist only once a row survives the cheap (uuid/app) filters.
    try:
        req = plistlib.loads(data).get("req", {})
    except Exception:
        req = {}
    title = str(req.get("titl") or "")
    subtitle = str(req.get("subt") or "")
    body = str(req.get("body") or "")
    text = " | ".join(oneline(p) for p in (title, subtitle, body) if p)
    if match_pat and match_pat.lower() not in text.lower():
        continue
    if fmt == "json":
        # Stable contract: rename/extract on the DB side as macOS shifts; these
        # keys (and body's real newlines) stay fixed for downstream consumers.
        results.append({
            "rec_id": rec_id,
            "bundle_id": ident,
            "app_name": name,
            "title": title,
            "subtitle": subtitle,
            "body": body,
            "category": str(req.get("cate") or ""),
            "click_url": str(req.get("durl") or ""),
            "delivered_at": mac_iso(dd),
            "delivered_epoch": mac_epoch(dd),
            "requested_at": mac_iso(rq),
            "requested_epoch": mac_epoch(rq),
            "active": is_active,
        })
    else:
        when = datetime.fromtimestamp(dd + 978307200).strftime("%Y-%m-%d %H:%M:%S")
        print(f"{shown + 1}\t{when}\t{name}\t{text}")
    shown += 1
    if limit and shown >= limit:
        break

if fmt == "json":
    print(json.dumps(results, ensure_ascii=False, indent=2))
    sys.exit(0)
sys.exit(0 if shown else 3)
PYEOF

# --- AX click engine (System Events) ---
#
# argv: <n>  → AXPress the Nth notification (default-action click: opens AND
# dismisses). Navigates the container DIRECTLY (group 1 of scroll area 1 of …)
# rather than `entire contents of window 1`, which is O(tree) and chokes once
# there are many notifications. AXPress on a stack only *expands* it, so a
# stacked target is expand-then-press; N=1 takes a fast path that skips the
# expand entirely when the newest is already an individual alert.
read -r -d '' AS_PRESS <<'APPLESCRIPT' || true
on run argv
  set targetN to (item 1 of argv) as integer
  tell application "System Events"
    if not (exists process "NotificationCenter") then return "fail: no NotificationCenter process"
    tell process "NotificationCenter"
      if (count of windows) is 0 then return "fail: no notification tray"
@CONTAINER@

      if targetN is 1 then
        -- Find the newest = first alert/stack child (skipping any leading chrome).
        set kc to count of UI elements of grp
        set firstKind to ""
        set firstIdx to 0
        repeat with i from 1 to kc
          set sr to ""
          try
            set sr to (subrole of UI element i of grp) as text
          end try
          if sr is "@ALERT@" then
            set firstKind to "alert"
            set firstIdx to i
            exit repeat
          else if sr is "@STACK@" then
            set firstKind to "stack"
            set firstIdx to i
            exit repeat
          end if
        end repeat
        if firstKind is "" then return "notfound:0"

        -- Already an individual alert: press it. No group to expand or collapse.
        if firstKind is "alert" then
          try
            perform action "AXPress" of (UI element firstIdx of grp)
            return "ok"
          on error e
            return "fail: " & e
          end try
        end if

        -- Stack: a member isn't pressable until the group is expanded. AXPress
        -- expands it, but the layout then SHIFTS (a heading + Show Less / Clear
        -- All buttons appear), so the member is NOT at firstIdx — re-scan the
        -- whole container for the first individual alert.
        try
          perform action "AXPress" of (UI element firstIdx of grp)
        end try
        set memberIdx to 0
        set tries to 0
        repeat
          set tries to tries + 1
          if tries > 50 then return "fail: stack did not expand"
          delay 0.02
          set memberIdx to 0
          set kc2 to count of UI elements of grp
          repeat with j from 1 to kc2
            set sr to ""
            try
              set sr to (subrole of UI element j of grp) as text
            end try
            if sr is "@ALERT@" then
              set memberIdx to j
              exit repeat
            end if
          end repeat
          if memberIdx > 0 then exit repeat
        end repeat

        -- Press the newest member (top of the expanded group): opens + dismisses.
        try
          perform action "AXPress" of (UI element memberIdx of grp)
        on error e
          return "fail: " & e
        end try

        -- Close the group again: press the first AXButton (Show Less is the
        -- left-most of the group's two buttons; Clear All is to its right).
        delay 0.1
        set kc3 to count of UI elements of grp
        repeat with k from 1 to kc3
          set r to ""
          try
            set r to (role of UI element k of grp) as text
          end try
          if r is "AXButton" then
            try
              perform action "AXPress" of (UI element k of grp)
            end try
            exit repeat
          end if
        end repeat
        return "ok"
      end if

      -- general path (N>1, may be slower): expand every stack, then press Nth
      set guard to 0
      repeat
        set guard to guard + 1
        if guard > 40 then exit repeat
        set foundStack to false
        set kc to count of UI elements of grp
        repeat with i from 1 to kc
          set sr to ""
          try
            set sr to (subrole of UI element i of grp) as text
          end try
          if sr is "@STACK@" then
            try
              perform action "AXPress" of (UI element i of grp)
            end try
            set foundStack to true
            exit repeat
          end if
        end repeat
        if not foundStack then exit repeat
        delay 0.08
      end repeat
      set idx to 0
      set kc to count of UI elements of grp
      repeat with i from 1 to kc
        set sr to ""
        try
          set sr to (subrole of UI element i of grp) as text
        end try
        if sr is "@ALERT@" then
          set idx to idx + 1
          if idx is targetN then
            try
              perform action "AXPress" of (UI element i of grp)
              return "ok"
            on error e
              return "fail: " & e
            end try
          end if
        end if
      end repeat
      return "notfound:" & idx
    end tell
  end tell
end run
APPLESCRIPT

# argv: <needle>  → AXPress the first notification whose text contains <needle>
# (case-sensitive substring). Used for app-targeted clicks: the DB supplies the
# newest matching notification's text, which equals the top of its stack, so we
# match the collapsed stack directly and expand only that one.
read -r -d '' AS_MATCH <<'APPLESCRIPT' || true
on run argv
  set needle to item 1 of argv
  tell application "System Events"
    if not (exists process "NotificationCenter") then return "fail: no NotificationCenter process"
    tell process "NotificationCenter"
      if (count of windows) is 0 then return "fail: no notification tray"
@CONTAINER@
      set kc to count of UI elements of grp
      repeat with i from 1 to kc
        set sr to ""
        try
          set sr to (subrole of UI element i of grp) as text
        end try
        if sr is "@ALERT@" or sr is "@STACK@" then
          set txt to ""
          try
            set vs to value of every static text of (UI element i of grp)
            repeat with v in vs
              set txt to txt & (v as text) & " "
            end repeat
          end try
          if txt contains needle then
            if sr is "@STACK@" then
              try
                perform action "AXPress" of (UI element i of grp)
              end try
              set tries to 0
              repeat
                set tries to tries + 1
                if tries > 25 then return "fail: stack did not expand"
                set sr2 to ""
                try
                  set sr2 to (subrole of UI element i of grp) as text
                end try
                if sr2 is "@ALERT@" then exit repeat
                delay 0.02
              end repeat
            end if
            try
              perform action "AXPress" of (UI element i of grp)
              return "ok"
            on error e
              return "fail: " & e
            end try
          end if
        end if
      end repeat
      return "notfound"
    end tell
  end tell
end run
APPLESCRIPT

# --- helpers ---

# Prints the AX tree of every NotificationCenter window (role [subrole] description, two
# spaces per level, seven levels deep): what a new layout file is written against.
read -r -d '' AS_TREE <<'APPLESCRIPT' || true
on walk(el, depth)
  tell application "System Events"
    set r to ""
    try
      set r to (role of el) as text
    end try
    set sr to ""
    try
      set sr to (subrole of el) as text
    end try
    set d to ""
    try
      set d to (description of el) as text
    end try
    set out to ""
    repeat depth times
      set out to out & "  "
    end repeat
    set out to out & r & " [" & sr & "] " & d & linefeed
    if depth < 7 then
      try
        repeat with c in (UI elements of el)
          set out to out & my walk(c, depth + 1)
        end repeat
      end try
    end if
    return out
  end tell
end walk
on run
  tell application "System Events"
    if not (exists process "NotificationCenter") then return "no NotificationCenter process"
    tell process "NotificationCenter"
      set out to "windows=" & (count of windows) & linefeed
      repeat with w in windows
        set out to out & my walk(w, 0)
      end repeat
      return out
    end tell
  end tell
end run
APPLESCRIPT

# --- per-macOS layout ---

typeset -g NC_RUNNING="" NC_LAYOUT_VERSION=""
typeset -gi NC_LAYOUT_EXACT=0
typeset -g nc_alert_subrole="" nc_stack_subrole="" nc_container_as=""

# Sources the running macOS's layout file, else the newest one older than it (else the oldest),
# leaving NC_LAYOUT_EXACT=0 so a miss can blame the mismatch.
layout_load() {
  [[ -n "${NC_LAYOUT_VERSION}" ]] && return 0
  autoload -Uz is-at-least
  NC_RUNNING="$(/usr/bin/sw_vers -productVersion)"
  local -a versions=( "${LAYOUT_DIR}"/*.zsh(N:t:r) )
  versions=( ${(on)versions} )
  (( ${#versions} )) || { log::err "No layout files | dir='${LAYOUT_DIR}'"; return 1; }
  local v pick="${versions[1]}"
  for v in "${versions[@]}"; do
    is-at-least "${v}" "${NC_RUNNING}" && pick="${v}"
  done
  source "${LAYOUT_DIR}/${pick}.zsh"
  local var
  for var in nc_alert_subrole nc_stack_subrole nc_container_as; do
    [[ -n "${(P)var}" ]] || { log::err "Layout leaves a variable unset | file='${LAYOUT_DIR}/${pick}.zsh' variable='${var}'"; return 1; }
  done
  NC_LAYOUT_VERSION="${pick}"
  [[ "${pick}" == "${NC_RUNNING}" ]] && NC_LAYOUT_EXACT=1
  (( NC_LAYOUT_EXACT )) || log::warn "No layout for this macOS; using the closest older one | running='${NC_RUNNING}' layout='${pick}'"
  return 0
}

# Prints an AX engine with the loaded layout's container lookup and subroles filled in.
_render() {
  local s="${1//@CONTAINER@/${nc_container_as}}"
  s="${s//@STACK@/${nc_stack_subrole}}"
  print -r -- "${s//@ALERT@/${nc_alert_subrole}}"
}

_press() { /usr/bin/osascript - "$@" <<<"$(_render "${AS_PRESS}")"; }
_match() { /usr/bin/osascript - "$@" <<<"$(_render "${AS_MATCH}")"; }
_tree() { /usr/bin/osascript - <<<"${AS_TREE}"; }

# Copies db + sidecars to a fresh temp dir; echoes the copy's db path (returns
# non-zero if the db can't be obtained). Read-only w.r.t. the original.
#
# The DB is in a TCC-protected group container, so the *caller* needs Full Disk
# Access (a terminal does). The Karabiner Hyper+N binding deliberately doesn't
# touch the DB — terminal-notifier first, then pure-AX — so no FDA grant for
# Karabiner is needed.
_copy_db() {
  local tmp
  tmp="$(mktemp -d /tmp/notif-center.XXXXXX)"
  cp "${DB_DIR}/db" "${tmp}/db" 2>/dev/null || true
  [[ -f "${DB_DIR}/db-wal" ]] && { cp "${DB_DIR}/db-wal" "${tmp}/db-wal" 2>/dev/null || true; }
  [[ -f "${DB_DIR}/db-shm" ]] && { cp "${DB_DIR}/db-shm" "${tmp}/db-shm" 2>/dev/null || true; }
  if [[ ! -s "${tmp}/db" ]]; then
    rm -rf "${tmp}"
    return 1
  fi
  printf '%s\n' "${tmp}"
}

# Runs the DB reader over a fresh copy. args: app match limit show_all fmt
_db() {
  local tmp rc=0
  tmp="$(_copy_db)" || { log::err "Notification DB unreadable (grant Full Disk Access to notif-db-shim, or to the caller)"; return 1; }
  /usr/bin/python3 - "${tmp}/db" "$@" <<<"${DECODE}" || rc=$?
  rm -rf "${tmp}"
  return ${rc}
}

# Preconditions for the DB-backed paths (list, click --app): just the tools.
# DB readability (FDA) is handled by _copy_db (shim or direct cp).
_need_db() {
  local -a missing
  for cmd in sqlite3 /usr/bin/python3; do
    command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
  done
  (( ${#missing} > 0 )) && { log::err "Missing required commands | missing='${(j:, :)missing}'"; return 1; }
  # The DB schema is as private as the AX tree: a macOS without its own layout warns here too.
  layout_load || true
  return 0
}

# Notification Center is opened (to surface notifications a closed-tray scan can
# miss) by clicking the menu-bar clock — which TOGGLES it. We only ever want it
# transiently open, so _nc_open arms a trap that closes it again on ANY exit
# (success, miss, or interrupt) — never leave the tray hanging open.
typeset -g _NC_OPENED=0

# When set, _notify_empty is suppressed (caller will chain its own fallback).
typeset -g _QUIET_EMPTY=0

_nc_click_clock() {
  /usr/bin/osascript -e 'tell application "System Events" to tell process "ControlCenter" to click (first menu bar item of menu bar 1 whose description is "Clock")' >/dev/null 2>&1 || true
}

_nc_open() {
  _nc_click_clock
  _NC_OPENED=1
}

# Closes NC iff we opened it. Wired to EXIT/INT/TERM so it runs no matter how the
# script ends — even on a successful click (which leaves the tray open).
_nc_cleanup() {
  (( _NC_OPENED )) || return 0
  _NC_OPENED=0
  _nc_click_clock
}

# Writes REPORT_FILE: why a miss on this macOS is probably the missing layout, how to add one,
# and the AX tree as the miss left it. Arguments: the engine's result
_write_report() {
  local result="${1}" tree
  tree="$(_tree 2>&1)" || true
  mkdir -p "${REPORT_FILE:h}"
  cat > "${REPORT_FILE}" <<EOF
# notif-center: no layout for macOS ${NC_RUNNING}

A click missed (\`${result}\`) on a macOS with no layout file of its own, so it used
macOS ${NC_LAYOUT_VERSION}'s. Notification Center's AX tree changes between releases;
when it does, the click looks in the wrong element and finds nothing.

## Add a layout

1. Post a banner and read the tree while it is on screen:

	atn -title test -message test; sleep 1; ~/dotfiles/.config/bin/notif-center tree

2. Start from the closest layout:

	cp ${LAYOUT_SRC_DIR}/${NC_LAYOUT_VERSION}.zsh ${LAYOUT_SRC_DIR}/${NC_RUNNING}.zsh

3. Edit its header comment and \`nc_container_as\` until the clone's copy presses the banner:

	~/dotfiles/.config/bin/notif-center click --verbose

4. Commit the file; Hyper+N picks it up at the next \`dotfiles switch\`.

The interface is in ${LAYOUT_SRC_DIR:h}/DESIGN.md § OS support.

## The tree at the miss

${tree}
EOF
}

# Posts MESSAGE as a banner whose click runs CLICK (a /bin/sh command line under launchd's
# environment), removed after 15 seconds.
_notify_click() {
  local message="${1}" click="${2}" group="${OTTO_LOG_NOTIF_GROUP}"
  local atn="${commands[atn]:-${HOME}/.config/bin/atn}"
  [[ -x "${atn}" ]] || { log::notify "${message}"; return 0; }
  local -a args=(-title "${OTTO_LOG_NOTIF_TITLE}" -message "${message}" -group "${group}" -execute "${click}" -contentImage "${OTTO_LOG_PLUGIN_DIR}/assets/robot.png")
  log::debug "notify | group='${group}' message='${message}' click='${click}'"
  log::notify_image_check "${args[@]}"
  "${atn}" "${args[@]}" >/dev/null || true
  nohup zsh -c "sleep 15 && ${(q)atn} -remove ${(q)group} >/dev/null 2>&1" </dev/null >/dev/null 2>&1 &
}

# Transient terminal-notifier banner when a click finds nothing — so a miss is
# visible from a Hyper+N keybind (mirrors the Claude click-simulator). Skipped
# under --quiet, so a caller can chain a fallback before announcing a miss. On a
# macOS without its own layout the banner blames that, and its click opens the report.
# Arguments: app pattern, match pattern, the engine's result
_notify_empty() {
  (( ${_QUIET_EMPTY:-0} )) && return 0
  local app_pat="${1:-}" match_pat="${2:-}" result="${3:-}" what
  if [[ -n "${app_pat}" ]]; then what="${app_pat} notification"
  elif [[ -n "${match_pat}" ]]; then what="notification matching “${match_pat}”"
  else what="notification"; fi
  local msg="No ${what} found to click"
  [[ "${result}" == fail:* ]] && msg+=" (${result#fail: })"
  if [[ -z "${NC_LAYOUT_VERSION}" ]] || (( NC_LAYOUT_EXACT )); then
    OTTO_LOG_NOTIFY_SECS=3 log::notify "${msg}"
    return 0
  fi
  _write_report "${result}"
  _notify_click "${msg} — probably because macOS ${NC_RUNNING} has no layout (used ${NC_LAYOUT_VERSION}'s). Click for the fix." \
    "${(q)EDIT_WINDOW} -n notif-center ${(q)REPORT_FILE}"
}

# AXPress an already-resolved target. mode=match → _match <needle/pattern>;
# mode=press → _press <n>. Pure AX, no DB — safe to retry inside the NC-open
# window without re-querying.
_do_press() {
  case "${1}" in
    match) _match "${2}" ;;
    press) _press "${2}" ;;
  esac
}

# --- subcommands ---

cmd_list() {
  _need_db || return 1
  local rc=0
  _db "${1:-}" "${2:-}" "${3:-30}" "${4:-0}" "${5:-human}" || rc=$?
  (( rc == 3 )) && { log::debug "no notifications matched"; return 1; }  # json exits 0 even when empty
  return ${rc}
}

cmd_click() {
  local n="${1:?}" app_pat="${2:-}" match_pat="${3:-}" no_refresh="${4:-0}"
  layout_load || { _notify_empty "${app_pat}" "${match_pat}" "fail: no AX layout installed"; return 1; }
  [[ -n "${app_pat}" ]] && { _need_db || return 1; }

  # Resolve the AX target ONCE, before any NC toggling — the DB query for --app
  # must not sit inside the NC-open window. Result is a (mode, arg) the pure-AX
  # press can retry cheaply.
  local mode arg
  if [[ -n "${match_pat}" ]]; then
    mode=match; arg="${match_pat}"
  elif [[ -n "${app_pat}" ]]; then
    # show_all=1: query the newest app notification from the full record, NOT the
    # active (`displayed`) set — that set lags delivery by seconds, so a fresh
    # notification you can see isn't in it yet. The AX press below is the real
    # "is it clickable" arbiter, so the active filter only causes false misses.
    local json
    json="$(_db "${app_pat}" "" 0 1 json)" || { log::err "query failed"; _notify_empty "${app_pat}" ""; return 1; }
    arg="$(print -r -- "${json}" | /usr/bin/python3 -c '
import sys, json, re
a = json.load(sys.stdin); i = int(sys.argv[1]) - 1
o = a[i] if 0 <= i < len(a) else {}
print(re.sub(r"\s+", " ", (o.get("body") or o.get("subtitle") or o.get("title") or "")).strip()[:60])
' "${n}")"
    [[ -z "${arg}" ]] && { log::err "No ${app_pat} notification in the DB"; _notify_empty "${app_pat}" ""; return 1; }
    mode=match
    log::debug "needle | needle='${arg}'"
  else
    mode=press; arg="${n}"
  fi

  # Try once (pure AX). On a miss, open NC so faded notifs materialize, retry,
  # close it again. --no-refresh skips that retry so a caller can chain a cheaper
  # recovery first.
  local result
  result="$(_do_press "${mode}" "${arg}")"
  if [[ "${result}" != ok ]] && (( ! no_refresh )); then
    log::debug "miss — opening Notification Center to refresh | result='${result}'"
    _nc_open
    sleep 0.2
    result="$(_do_press "${mode}" "${arg}")"
    _nc_cleanup            # close NC now; the EXIT trap is just the interrupt backstop
  fi

  log::debug "click | mode='${mode}' arg='${arg}' result='${result}'"
  case "${result}" in
    ok) return 0 ;;
    # 4) Still nothing → transient banner so the miss is visible from a keybinding.
    *) log::err "Target not in the live tray | result='${result}'"
       _notify_empty "${app_pat}" "${match_pat}" "${result}"
       return 1 ;;
  esac
}

cmd_os() {
  layout_load || return 1
  local -a versions=( "${LAYOUT_DIR}"/*.zsh(N:t:r) )
  local how="its own"
  (( NC_LAYOUT_EXACT )) || how="closest older; add ${LAYOUT_SRC_DIR}/${NC_RUNNING}.zsh"
  print -r -- "running:  ${NC_RUNNING} ($(/usr/bin/sw_vers -buildVersion))"
  print -r -- "layout:   ${NC_LAYOUT_VERSION} (${how})"
  print -r -- "layouts:  ${(j:, :)${(@on)versions}} in ${LAYOUT_DIR}"
}

cmd_tree() { _tree; }

# --- help / main ---

help() {
  print -- "$(cat <<EOF
${c_green}notif-center${c_rst} — read and click macOS notifications

${c_cyan}Usage:${c_rst}
  notif-center list  [--app PAT] [--match PAT] [--limit N] [--all] [--output FMT]
  notif-center click [N] [--app PAT] [--match PAT]
  notif-center os
  notif-center tree

${c_cyan}list${c_rst} (reads the DB — fast, knows the posting app):
  --output human|json  human: \`# time app_name title | subtitle | body\` (TSV)
                       json:  array of { rec_id, bundle_id, app_name, title,
                         subtitle, body, category, click_url, delivered_at,
                         delivered_epoch, requested_at, requested_epoch, active }
  --app PAT     keep rows whose bundle id OR app name matches PAT (e.g. slack)
  --match PAT   keep rows whose text matches PAT
  --limit N     cap at N rows (default 30; 0 = no cap)
  --all         include dismissed history (default: only what's in the tray now)

${c_cyan}click [N]${c_rst} (default N=1, the newest / first on the stack):
  AXPress the Nth notification — opens AND dismisses, every app. Navigates the
  tray directly (no full-tree read); N=1 reads just the first notification.
  Stacked targets are expanded first. N>1 is slower (must expand to count).
  --app/--match: click the newest notification from that app / matching that
  text (e.g. \`click --app slack\`). Uses the DB to target, then AX-clicks it.

${c_cyan}os${c_rst} (running macOS → AX layout):
  Reports the running macOS, the layout file the clicks use (its own, or the
  closest older one), and every layout installed.

${c_cyan}tree${c_rst} (AX debugging):
  Prints Notification Center's AX tree, seven levels deep: what a new macOS
  layout is written against. Run it with a banner on screen.

${c_cyan}Options:${c_rst}
  --verbose     OTTO_DEBUG=1 (debug logs to stderr)
  --quiet       on a click miss, skip the "nothing to click" banner (for
                callers that chain their own fallback)
  --no-refresh  on a click miss, skip opening Notification Center to retry — fail
                fast so a caller can try a cheaper recovery first
  -h, --help    Show this help
EOF
)"
}

main() {
  # osascript is the only universal dependency (every click needs it). The DB
  # tools + Full Disk Access are checked lazily by _need_db, so pure-AX clicks
  # work even where the DB is unreadable (e.g. under Karabiner).
  command -v /usr/bin/osascript >/dev/null 2>&1 || { log::err "Missing required command | command='/usr/bin/osascript'"; return 1; }

  local subcmd="" n=1 app_pat="" match_pat="" limit=30 show_all=0 fmt="human" no_refresh=0
  while (( $# > 0 )); do case "${1}" in
    -h|--help)     help; return 0 ;;
    --verbose)     export OTTO_DEBUG=1; shift ;;
    --quiet)       _QUIET_EMPTY=1; shift ;;
    --no-refresh)  no_refresh=1; shift ;;
    --app)      app_pat="${2:?--app needs a pattern}"; shift 2 ;;
    --match)    match_pat="${2:?--match needs a pattern}"; shift 2 ;;
    --limit)    limit="${2:?--limit needs a number}"; shift 2 ;;
    --all)      show_all=1; shift ;;
    --output)   fmt="${2:?--output needs json|human}"; shift 2 ;;
    -*)         log::err "Unknown flag | flag='${1}'"; help; return 1 ;;
    *)
      if [[ -z "${subcmd}" ]]; then subcmd="${1}"
      elif [[ "${subcmd}" == "click" && "${1}" == <-> ]]; then n="${1}"
      else log::err "Unexpected argument | argument='${1}'"; help; return 1; fi
      shift ;;
  esac; done

  if [[ "${fmt}" != "json" && "${fmt}" != "human" ]]; then
    log::err "Invalid --output | got='${fmt}' valid='json, human'"; return 1
  fi

  case "${subcmd}" in
    list)    cmd_list "${app_pat}" "${match_pat}" "${limit}" "${show_all}" "${fmt}" ;;
    click)   cmd_click "${n}" "${app_pat}" "${match_pat}" "${no_refresh}" ;;
    os)      cmd_os ;;
    tree)    cmd_tree ;;
    ""|help) help ;;
    *)       log::err "Unknown command | command='${subcmd}'"; help; return 1 ;;
  esac
}

# Close Notification Center on the way out if a click opened it (no-op
# otherwise). Top-level so it fires on shell exit regardless of how main ends.
trap '_nc_cleanup' EXIT INT TERM
main "${@}"
