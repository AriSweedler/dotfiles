#!/usr/bin/env zsh
# tmux-edit-window [-n NAME] [+LINE] FILE — open ${EDITOR} on FILE (at LINE; a bare + is the
# last line, as the vi family reads it) in a new tmux window of the working session (the most
# recently active client's) and bring Terminal forward: the Hyper+O → vi_* shape for callers
# without a tty, chiefly `terminal-notifier -execute`, where a click on `-open file.md` would
# hand the file to Xcode. The click runs under /bin/sh with launchd's environment, so tmux is
# probed by absolute path and the editor resolves inside the window (or Terminal's shell) from
# an interactive zsh, never here: launchd sets no $EDITOR. Without a tmux client the file opens
# in a fresh Terminal window.
set -u
source "${HOME}/.config/zsh/plugins/log.zsh"

name="vi_"
if [[ "${1:-}" == -n ]]; then
  name="${2:?-n needs a window name}"
  shift 2
fi
line=""
if [[ "${1:-}" == +* ]]; then
  line="${1}"
  shift
fi
file="${1:?usage: tmux-edit-window [-n NAME] [+LINE] FILE}"
if [[ ! -r "${file}" ]]; then
  log::err "cannot read file | path='${file}'"
  exit 1
fi

tmux_bin="$(command -v tmux 2>/dev/null || true)"
for candidate in "/etc/profiles/per-user/${USER:-$(id -un)}/bin/tmux" /run/current-system/sw/bin/tmux /opt/homebrew/bin/tmux /usr/local/bin/tmux; do
  if [[ -z "${tmux_bin}" && -x "${candidate}" ]]; then
    tmux_bin="${candidate}"
  fi
done

client=""
if [[ -n "${tmux_bin}" ]]; then
  client="$("${tmux_bin}" list-clients -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)"
fi

if [[ -n "${client}" ]]; then
  session="$("${tmux_bin}" display-message -p -c "${client}" '#{session_name}')"
  log::info "opening editor window | session='${session}' window='${name}' file='${file}'${line:+ line='${line}'}"
  # FILE and LINE travel as their own argv elements. The shell is interactive (as irun) because
  # $EDITOR is nvim under bob, whose PATH entry is prepended by an interactive plugin; a plain
  # zsh -c would fall back to vi.
  "${tmux_bin}" new-window -t "${session}:" -n "${name}" -c "${file:h}" \
    zsh -ic 'editor="${EDITOR:-vi}"; command -v "${editor%% *}" >/dev/null 2>&1 || editor=vi; ${=editor} ${2:+"$2"} -- "$1"' _ "${file}" "${line}"
  /usr/bin/open -a Terminal
else
  log::warn "no tmux client; opening in a Terminal window | file='${file}'${line:+ line='${line}'}"
  # Terminal's shell is an interactive login zsh, so \$EDITOR expands there (nvim), not here.
  /usr/bin/osascript -e "tell application \"Terminal\" to do script \"exec \\${EDITOR:-vi} ${line:+${(q)line} }${(q)file}\"" \
                     -e 'tell application "Terminal" to activate' > /dev/null
fi
