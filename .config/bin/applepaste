#!/usr/bin/env python3
# applepaste — type text as keystrokes via an AppleScript that opens in Script Editor.
# Press Run there, then focus the target within the 1s delay. Script Editor quits itself
# when the typing is done.
import sys
import os

my_script = "/tmp/applepaste.scpt"

# Digits and a few symbols type unreliably through `keystroke` under some input sources, so
# they go by key code. Never `using shift down`: System Events leaves shift latched for the
# keystrokes that follow, which is what typed everything in capitals.
# https://eastmanreference.com/complete-list-of-applescript-key-codes
switcher = {
	"0": "key code 29",
	"1": "key code 18",
	"2": "key code 19",
	"3": "key code 20",
	"4": "key code 21",
	"5": "key code 23",
	"6": "key code 22",
	"7": "key code 26",
	"8": "key code 28",
	"9": "key code 25",
	".": "key code 47",
	"\\": "key code 42",
	'"': 'keystroke "\\""',
}

def transform(s):
	return switcher.get(s, f'keystroke "{s}"')

def main():
	my_input = ' '.join(sys.argv[1:])
	with open(my_script, 'w') as f:
		f.write('tell application "System Events"\n')
		f.write('delay 1\n')
		for i in my_input:
			f.write(f'{transform(i)}\n')
			f.write('delay 0.02\n')
		f.write('end tell\n')
		# A running document cannot close itself, but the app can quit; the typing is done by now.
		f.write('tell application "Script Editor" to quit saving no\n')
		# Race condition in `open` if we don't flush here.
		f.flush()

def open_script_editor():
	os.system(f'open -a "/System/Applications/Utilities/Script Editor.app" {my_script}')

if __name__ == "__main__":
	main()
	open_script_editor()
