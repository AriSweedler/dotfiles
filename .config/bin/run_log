#!/usr/bin/env zsh
# run_log — run a command and capture it into a per-command capture directory:
#
#   <root>/<seq>_<slug>/
#     metadata      user=, timestamp=, cwd=, command=, stdout_tty=, stderr_tty=, exit=, duration_s=
#     <N>.fd        fd N, byte-for-byte (colors kept); 1, 2, and each --fd N
#     <N>.fd.plain  fd N as the user saw it: escapes stripped, \r redraws resolved
#     stdout, stderr, stdout.plain, stderr.plain
#                   symlinks to 1.fd, 2.fd, 1.fd.plain, 2.fd.plain
#
# Like `irun`, the command executes in an interactive zsh so aliases,
# functions, and everything sourced from .zshrc are available. stdout and
# stderr each get their own pty (run_log-capture.py), so the command behaves
# exactly as in a bare terminal — colors, log pretty-printers, progress bars —
# while each stream is still captured to its own file.
# Only fds 1 and 2 are captured by default — a command's fd 3+ writes bypass
# the capture, because pre-opening fds changes the child's environment.
# `--fd N` opts in per fd: the wrapper opens fd N onto
# <capture-dir>/<N>.fd (capture-only, never echoed to the terminal).
#
# Designed for agent workflows: an agent hands over a `run_log ...` command,
# the human runs it, and the capture is already on disk at a deterministic
# path for the agent to read. When run from a terminal, run_log ends by
# putting one line on the clipboard, `run_log artifact: <capture-dir>`, for
# the human to paste into the agent's chat; the agent reads the rest from
# the capture dir. With $LOG_DIR exported, `run_log <cmd>` needs
# no flags at all; repeated runs make 001_*, 002_*, ... under the same root.

set -euo pipefail
zmodload zsh/datetime

readonly LOG_LIB="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/plugins/log.zsh"
if [[ ! -r "${LOG_LIB}" ]]; then
  print -u2 "[ERROR] missing logging lib | path='${LOG_LIB}'"
  exit 1
fi
source "${LOG_LIB}"

readonly DEFAULT_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/run_log"
readonly CAPTURE_HELPER="${0:A:h}/run_log-capture.py"

# log.zsh colors are literal-backslash strings for `echo -e`, so the heredoc
# must be rendered with %b, not cat'd raw.
help() {
  local text
  text="$(cat <<EOF
${c_green}run_log${c_rst} — run a command, capture metadata/stdout/stderr to a capture dir

${c_green}Usage:${c_rst}
  run_log [--name NAME] [--dir DIR] [--] CMD [ARGS...]

The command runs in an interactive zsh (like irun) so aliases and .zshrc
functions work. Each invocation creates one capture directory under the
capture root:

  <root>/<seq>_<cmd-slug>/
    metadata      user=, timestamp=, cwd=, command=, stdout_tty=, stderr_tty=, exit=, duration_s=
    <N>.fd        fd N, byte-for-byte (colors kept): 1, 2, and each --fd N
    <N>.fd.plain  fd N as you saw it: escapes stripped, \\\\r redraws resolved
    stdout, stderr, stdout.plain, stderr.plain
                  symlinks to 1.fd, 2.fd, 1.fd.plain, 2.fd.plain

When the command finishes from a terminal, run_log puts one line on the
clipboard for pasting into an agent's chat:

  run_log artifact: <capture-dir>

stdout and stderr each run on their own pty, so the command behaves exactly
as in your terminal — colors, log pretty-printers, progress bars all work —
and each stream still lands in its own file. When run_log's own stdout or
stderr is not a terminal (piped, or run by an agent), that stream gets a pipe
instead, so the command sees what it would have seen without run_log. stdin
is passed through untouched: prompts and hardware-key taps work.

${c_green}Options:${c_rst}
  --name NAME  Capture dir name (default: <seq>_<cmd-slug>). Absolute paths
               are used as-is; otherwise it lands under the capture root. A
               name already holding a capture gets a _2, _3, ... suffix.
  --file NAME  Compat alias for --name (a trailing .log is stripped).
  --fd N       Also capture fd N (3-9, repeatable) to
               <capture-dir>/<N>.fd (plus its .plain copy).
               The command sees fd N as an open non-tty descriptor.
               Capture-only: fd N output is not echoed to the terminal.
  --dir DIR    Capture root for relative/generated names.
               Precedence: --dir > \$LOG_DIR > \$XDG_STATE_HOME/run_log
  --no-copy    Leave the clipboard alone (also: RUN_LOG_COPY=0). Never
               copied when stdout is not a terminal.
  --deliver-to PANE
               Also type the artifact line into tmux pane PANE (an agent's
               prompt, no Enter), then note it on the tmux status line.
  -h, --help   Show this help

${c_green}Argument handling:${c_rst}
  Multiple args after the flags (or --) are an argv: each word reaches the
  child byte-for-byte — no re-split, no glob, JSON args safe — and a bare
  first word still expands as an alias. A single arg is a shell command
  string, re-parsed by the interactive zsh: pipes, &&, redirections work.

${c_green}Examples:${c_rst}
  run_log kubectl get pods
  run_log --name step1 -- aws s3 ls
  run_log -- make deploy ARGS='{"dry_run":false}'
  run_log 'aws_profile --query dev && aws s3 ls'
  LOG_DIR=/tmp/investigation-42 run_log make build
EOF
)"
  printf '%b\n' "${text}"
}

#######################################
# Pick the capture root for relative/generated names.
# Globals: LOG_DIR (env, optional), DEFAULT_LOG_DIR
# Arguments: $1 = --dir flag value (may be empty)
# Outputs: directory path on stdout
#######################################
resolve_capture_root() {
  local flag_dir="${1}"
  if [[ -n "${flag_dir}" ]]; then
    log::debug "Using --dir | root='${flag_dir}'"
    print -r -- "${flag_dir}"
    return
  fi
  if [[ -n "${LOG_DIR:-}" ]]; then
    log::debug "Using \$LOG_DIR | root='${LOG_DIR}'"
    print -r -- "${LOG_DIR}"
    return
  fi
  log::debug "Using default capture root | root='${DEFAULT_LOG_DIR}'"
  print -r -- "${DEFAULT_LOG_DIR}"
}

#######################################
# Next zero-padded sequence number for a generated capture dir, one past the
# highest numeric prefix already present so captures sort chronologically.
# Arguments: $1 = capture root
# Outputs: e.g. "003" on stdout
#######################################
next_seq() {
  local root="${1}"
  local max=0 entry n
  for entry in "${root}"/[0-9]*(N/:t); do
    n="${${entry%%_*}//[^0-9]/}"
    if [[ -n "${n}" ]] && (( n > max )); then
      max="${n}"
    fi
  done
  printf '%03d' "$((max + 1))"
}

#######################################
# Slug of the command's first few words, so capture dirs stay greppable.
# Arguments: $1 = full command string
# Outputs: slug on stdout
#######################################
generate_slug() {
  setopt local_options extended_glob
  local cmd="${1}"
  local -a words=("${(z)cmd}")
  words=("${(@)words[1,3]}")
  # :t basenames path-like words so /tmp/x/bin/01_foo.zsh slugs as 01_foo_zsh.
  words=("${(@)words:t}")
  local slug="${(j:_:)words}"
  slug="${slug//[^A-Za-z0-9_-]/_}"
  print -r -- "${slug%%_#}"
}

#######################################
# Resolve the capture dir from --name/--file, the capture root, and the
# command. Does not create it or handle collisions.
# Arguments: $1 = name flag value (may be empty), $2 = capture root, $3 = cmd
# Outputs: capture dir path on stdout
#######################################
resolve_capture_dir() {
  local name="${1%.log}" root="${2}" cmd="${3}"
  if [[ -n "${name}" && "${name}" == /* ]]; then
    log::debug "Using absolute capture dir | capture_dir='${name}'"
    print -r -- "${name}"
    return
  fi
  if [[ -n "${name}" ]]; then
    log::debug "Placing named capture under root | name='${name}' root='${root}'"
    print -r -- "${root}/${name}"
    return
  fi
  local generated="$(next_seq "${root}")_$(generate_slug "${cmd}")"
  log::debug "Generated capture dir name | name='${generated}' root='${root}'"
  print -r -- "${root}/${generated}"
}

#######################################
# A dir that already holds a capture (has a metadata file) is never reused —
# each capture describes exactly one command. Suffix _2, _3, ... until free.
# Arguments: $1 = candidate capture dir
# Outputs: final capture dir path on stdout
#######################################
uniquify_capture_dir() {
  local dir="${1}"
  if [[ ! -e "${dir}/metadata" ]]; then
    print -r -- "${dir}"
    return
  fi
  local n=2
  while [[ -e "${dir}_${n}/metadata" ]]; do
    (( n++ ))
  done
  log::warn "Capture dir already used; suffixing | dir='${dir}' suffixed='${dir}_${n}'"
  print -r -- "${dir}_${n}"
}

#######################################
# Open each requested fd in the current shell, pointed at
# <dir>/<n>.fd, so the
# command inherits it. Mutates shell fds — must NOT be called in a subshell.
# The fd number is validated to a single digit 3-9 before reaching the eval.
# Arguments: $1 = capture dir, rest = fd numbers
#######################################
open_capture_fds() {
  local dir="${1}"
  shift
  local fd
  for fd in "$@"; do
    log::info "Capturing extra fd | fd='${fd}' file='${dir}/${fd}.fd'"
    eval "exec ${fd}>\"\${dir}/\${fd}.fd\""
  done
}

#######################################
# Close fds opened by open_capture_fds. Mutates shell fds — no subshell.
# Arguments: fd numbers
#######################################
close_capture_fds() {
  local fd
  for fd in "$@"; do
    eval "exec ${fd}>&-"
  done
}

#######################################
# Run the command through the capture helper: stdout and stderr each on its
# own pty (or pipe, mirroring run_log's own fds), echoed live and written
# raw plus stripped to the capture dir. The helper forwards the exit status.
# Arguments: $1 = capture dir, $2 = command string
# Returns: the command's exit status
#######################################
run_captured() {
  local capture_dir="${1}" cmd="${2}"
  python3 -I "${CAPTURE_HELPER}" "${capture_dir}" zsh -ic "${cmd}"
}

#######################################
# Type the artifact line into a tmux pane (an agent's prompt; no Enter), and only once that
# worked, say so on the tmux status line.
# Arguments: $1 = handoff text, $2 = pane ID (empty: skip)
#######################################
deliver_handoff() {
  local text="${1}" pane="${2}"
  if [[ -z "${pane}" ]]; then
    return
  fi
  if [[ -z "${TMUX:-}" ]]; then
    log::warn "Not delivering artifact line; not inside tmux | pane='${pane}'"
    return
  fi
  if ! tmux send-keys -t "${pane}" -l -- "${text}"; then
    log::warn "Could not type artifact line into pane | pane='${pane}'"
    return
  fi
  local label
  label="$(tmux display-message -p -t "${pane}" 'ID=#{pane_id}|pane=#{window_index}.#{pane_index}')"
  tmux display-message -d 4000 "✦ run_log artifact pasted into ${label}"
  log::info "Delivered artifact line | pane='${label}'"
}

#######################################
# Put the one-line artifact handoff on the clipboard. Skipped with --no-copy, when
# RUN_LOG_COPY=0, when stdout is not a terminal (an agent ran run_log, so
# nobody is there to paste), or when pbcopy is absent.
# Arguments: $1 = handoff text, $2 = "true" to copy
#######################################
copy_handoff() {
  local text="${1}" should_copy="${2}"
  if [[ "${should_copy}" != true ]]; then
    log::debug "Not copying handoff | reason='disabled or stdout not a tty'"
    return
  fi
  if ! command -v pbcopy > /dev/null; then
    log::debug "Not copying handoff | reason='no pbcopy'"
    return
  fi
  print -rn -- "${text}" | pbcopy
  log::info "Copied artifact line to clipboard | text='${text}'"
}

#######################################
# Build the string handed to `zsh -ic`. A single argument is a shell command
# string, re-parsed by the interactive zsh (pipes, &&, redirection). Multiple
# arguments are an argv: each word is requoted with (q-) so it reaches the
# child byte-for-byte — no re-split, no glob — while a bare first word stays
# unquoted and still gets alias expansion.
# Arguments: the command args (after flags/--)
# Outputs: command string on stdout
#######################################
build_command_string() {
  if (( $# == 1 )); then
    log::debug "Single-arg command string; interactive zsh re-parses it"
    print -r -- "${1}"
    return
  fi
  log::debug "Multi-arg command; requoting argv verbatim | argc='${#}'"
  local -a quoted=("${(@q-)@}")
  print -r -- "${(j: :)quoted}"
}

main() {
  # === PARSE ===
  local name="" dir_flag="" copy_flag=true deliver_pane=""
  local -a capture_fds=()
  while (( $# > 0 )); do
    case "${1}" in
      -h|--help) help; return 0 ;;
      --no-copy) copy_flag=false; shift ;;
      --deliver-to) deliver_pane="${2:?--deliver-to requires a pane}"; shift 2 ;;
      --name) name="${2:?--name requires a value}"; shift 2 ;;
      --file) name="${2:?--file requires a value}"; shift 2 ;;
      --fd) capture_fds+=("${2:?--fd requires a value}"); shift 2 ;;
      --dir) dir_flag="${2:?--dir requires a value}"; shift 2 ;;
      --) shift; break ;;
      -*) log::err "Unknown flag | flag='${1}'"; help; return 1 ;;
      *) break ;;
    esac
  done

  # === VALIDATE ===
  if [[ ! -r "${CAPTURE_HELPER}" ]]; then
    log::err "Missing capture helper | path='${CAPTURE_HELPER}'"
    return 1
  fi
  if (( $# == 0 )); then
    log::err "No command given"
    help
    return 2
  fi
  local fd
  for fd in "${capture_fds[@]}"; do
    if [[ "${fd}" != <3-9> ]]; then
      log::err "Invalid --fd | fd='${fd}' valid='3..9 (fds 1/2 are always captured as stdout/stderr)'"
      return 1
    fi
  done
  capture_fds=("${(u)capture_fds[@]}")

  # === MASSAGE ===
  local cmd
  cmd="$(build_command_string "$@")"
  local root capture_dir
  root="$(resolve_capture_root "${dir_flag}")"
  capture_dir="$(resolve_capture_dir "${name}" "${root}" "${cmd}")"
  capture_dir="$(uniquify_capture_dir "${capture_dir}")"

  # Tested here, not in a $(...): fd 1 of a command substitution is its pipe.
  local stdout_tty=false stderr_tty=false
  if [[ -t 1 ]]; then
    stdout_tty=true
  fi
  if [[ -t 2 ]]; then
    stderr_tty=true
  fi
  local should_copy=false
  if [[ "${copy_flag}" == true && "${RUN_LOG_COPY:-1}" != 0 && "${stdout_tty}" == true ]]; then
    should_copy=true
  fi

  # === LOGIC ===
  mkdir -p "${capture_dir}"
  local started cwd="${PWD}"
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local -F start_epoch="${EPOCHREALTIME}"
  cat > "${capture_dir}/metadata" <<EOF
user=${USER:-$(whoami)}
timestamp=${started}
cwd=${cwd}
command=${cmd}
stdout_tty=${stdout_tty}
stderr_tty=${stderr_tty}
EOF
  log::info "Capturing | capture_dir='${capture_dir}'"
  open_capture_fds "${capture_dir}" "${capture_fds[@]}"

  set +e
  run_captured "${capture_dir}" "${cmd}"
  local rc=$?
  set -e
  close_capture_fds "${capture_fds[@]}"

  local duration
  printf -v duration '%.1f' "$(( EPOCHREALTIME - start_epoch ))"
  print -r -- "exit=${rc}" >> "${capture_dir}/metadata"
  print -r -- "duration_s=${duration}" >> "${capture_dir}/metadata"
  log::info "Captured command | capture_dir='${capture_dir}' rc='${rc}'"
  copy_handoff "run_log artifact: ${capture_dir}" "${should_copy}"
  deliver_handoff "run_log artifact: ${capture_dir}" "${deliver_pane}"
  return "${rc}"
}

main "$@"
