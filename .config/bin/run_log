#!/usr/bin/env zsh
# run_log — run a command and capture it plus its output into a log file, in
# the tcap format: a `❯ <cmd>` prompt line followed by the raw output.
#
# Like `irun`, the command executes in an interactive zsh so aliases,
# functions, and everything sourced from .zshrc are available. Output still
# streams to the terminal; the log file gets a copy.
#
# Designed for agent workflows: an agent hands over a `run_log ...` command,
# the human runs it, and the output is already on disk for the agent to read.
# With $LOG_DIR exported, `run_log <cmd>` needs no flags at all.

set -euo pipefail

readonly LOG_LIB="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/plugins/log.zsh"
if [[ ! -r "${LOG_LIB}" ]]; then
  print -u2 "[ERROR] missing logging lib | path='${LOG_LIB}'"
  exit 1
fi
source "${LOG_LIB}"

readonly DEFAULT_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/run_log"
readonly PROMPT_CHAR="❯"

# log.zsh colors are literal-backslash strings for `echo -e`, so the heredoc
# must be rendered with %b, not cat'd raw.
help() {
  local text
  text="$(cat <<EOF
${c_green}run_log${c_rst} — run a command and capture it + its output (tcap format) to a file

${c_green}Usage:${c_rst}
  run_log [--file FILE] [--dir DIR] [--] CMD [ARGS...]

The command runs in an interactive zsh (like irun) so aliases and .zshrc
functions work. Output streams to the terminal and is teed into the log file
under a \`${PROMPT_CHAR} CMD\` prompt line. Repeated runs against the same file
append, so one file can hold a whole session of steps.

${c_green}Options:${c_rst}
  --file FILE  Log file. Absolute paths are used as-is; relative paths land
               under the log dir. Default: <utc-timestamp>_<cmd-slug>.log
  --dir DIR    Log dir for relative/generated filenames.
               Precedence: --dir > \$LOG_DIR > \$XDG_STATE_HOME/run_log
  -h, --help   Show this help

${c_green}Examples:${c_rst}
  run_log kubectl get pods
  run_log --file step1.log -- aws s3 ls
  LOG_DIR=/tmp/investigation-42 run_log make build
EOF
)"
  printf '%b\n' "${text}"
}

#######################################
# Pick the log directory for relative/generated filenames.
# Globals: LOG_DIR (env, optional), DEFAULT_LOG_DIR
# Arguments: $1 = --dir flag value (may be empty)
# Outputs: directory path on stdout
#######################################
resolve_log_dir() {
  local flag_dir="${1}"
  if [[ -n "${flag_dir}" ]]; then
    log::debug "Using --dir | dir='${flag_dir}'"
    print -r -- "${flag_dir}"
    return
  fi
  if [[ -n "${LOG_DIR:-}" ]]; then
    log::debug "Using \$LOG_DIR | dir='${LOG_DIR}'"
    print -r -- "${LOG_DIR}"
    return
  fi
  log::debug "Using default log dir | dir='${DEFAULT_LOG_DIR}'"
  print -r -- "${DEFAULT_LOG_DIR}"
}

#######################################
# Build a generated filename: UTC timestamp + a slug of the command's first
# few words, so files sort chronologically and stay greppable by command.
# Arguments: $1 = full command string
# Outputs: filename (no directory) on stdout
#######################################
generate_log_name() {
  local cmd="${1}"
  local -a words=("${(z)cmd}")
  local slug="${(j:_:)words[1,3]}"
  slug="${slug//[^A-Za-z0-9_-]/_}"
  print -r -- "$(date -u +%Y%m%dT%H%M%SZ)_${slug}.log"
}

#######################################
# Resolve the final log file path from --file, the log dir, and the command.
# Arguments: $1 = --file flag value (may be empty), $2 = log dir, $3 = command
# Outputs: absolute-or-relative file path on stdout
#######################################
resolve_log_file() {
  local file="${1}" dir="${2}" cmd="${3}"
  if [[ -n "${file}" && "${file}" == /* ]]; then
    log::debug "Using absolute --file | log_file='${file}'"
    print -r -- "${file}"
    return
  fi
  if [[ -n "${file}" ]]; then
    log::debug "Placing relative --file under log dir | file='${file}' dir='${dir}'"
    print -r -- "${dir}/${file}"
    return
  fi
  local name
  name="$(generate_log_name "${cmd}")"
  log::debug "Generated log filename | name='${name}' dir='${dir}'"
  print -r -- "${dir}/${name}"
}

main() {
  # === PARSE ===
  local file="" dir_flag=""
  while (( $# > 0 )); do
    case "${1}" in
      -h|--help) help; return 0 ;;
      --file) file="${2:?--file requires a value}"; shift 2 ;;
      --dir) dir_flag="${2:?--dir requires a value}"; shift 2 ;;
      --) shift; break ;;
      -*) log::err "Unknown flag | flag='${1}'"; help; return 1 ;;
      *) break ;;
    esac
  done

  # === VALIDATE ===
  if (( $# == 0 )); then
    log::err "No command given"
    help
    return 2
  fi

  # === MASSAGE ===
  # Join like irun: the interactive zsh re-parses the string, so both
  # `run_log ap --query x` and `run_log 'a && b'` work.
  local cmd="$*"
  local log_dir log_file
  log_dir="$(resolve_log_dir "${dir_flag}")"
  log_file="$(resolve_log_file "${file}" "${log_dir}" "${cmd}")"

  # === LOGIC ===
  mkdir -p "${log_file:h}"
  if [[ -s "${log_file}" ]]; then
    log::info "Appending to existing log file | log_file='${log_file}'"
    print -r -- "" >> "${log_file}"
  else
    log::info "Capturing to log file | log_file='${log_file}'"
  fi
  print -r -- "${PROMPT_CHAR} ${cmd}" >> "${log_file}"

  set +e
  zsh -ic "${cmd}" 2>&1 | tee -a "${log_file}"
  local rc="${pipestatus[1]}"
  set -e

  if (( rc != 0 )); then
    print -r -- "[exit ${rc}]" >> "${log_file}"
  fi
  log::info "Captured command | log_file='${log_file}' rc='${rc}'"
  return "${rc}"
}

main "$@"
