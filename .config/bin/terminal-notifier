#!/usr/bin/env zsh
# terminal-notifier — the logging front for Homebrew's terminal-notifier. Every notification
# this machine posts, removes or lists is one line in
# ${XDG_STATE_HOME:-~/.local/state}/terminal-notifier/terminal-notifier.log, then Homebrew's
# binary runs in this very process (exec: a caller's pid, rc and watchdog see no difference).
# It sits in ~/.config/bin, which the PATH policy in ~/.config/zsh/.zshrc and the jobs
# launchd PATH keep ahead of Homebrew, so `command -v terminal-notifier` is this file; the
# callers that pin an absolute path (Karabiner, the Claude hooks) pin this one. The log
# answers "who posted that banner": every caller names itself in -group and -title.
#   tail -f ~/.local/state/terminal-notifier/terminal-notifier.log
set -u
zmodload zsh/datetime

log::err() { print -u2 -r -- $'\e[31m[ERROR]\e[0m' "$@"; }

log_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/terminal-notifier"
verb=post
(( ${argv[(I)-remove]} )) && verb=remove
(( ${argv[(I)-list]} )) && verb=list
strftime -s ts '%Y-%m-%d %H:%M:%S' "${EPOCHSECONDS}"
# A log that cannot be written never costs a notification.
{ mkdir -p "${log_dir}" && print -r -- "${ts} ${verb} ${(j: :)${(q-)@}}" >> "${log_dir}/terminal-notifier.log"; } 2>/dev/null

# Homebrew's binary: the first terminal-notifier on PATH that is not this file, else the brew
# prefixes, since the callers that pin this path run with launchd's PATH.
real=""
for dir in $path /opt/homebrew/bin /usr/local/bin; do
  candidate="${dir}/terminal-notifier"
  [[ -x "${candidate}" && ! "${candidate}" -ef "${0:A}" ]] || continue
  real="${candidate}"
  break
done
if [[ -z "${real}" ]]; then
  log::err "no terminal-notifier to run; logged, posted nothing | fix='brew install terminal-notifier'"
  exit 127
fi
exec "${real}" "$@"
