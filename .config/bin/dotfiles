#!/usr/bin/env zsh
# dotfiles — the harness for Ari's two-tier dotfiles (see /ari-dotfiles).
#   init    make this machine's dotfiles whole: shared repo cloned and checked
#           out, hooks wired, submodules checked out, skills linked, the GitHub
#           ssh key loaded (passphrase from 1Password). new-machine relies on it.
#   pull    fast-forward the shared tier, then init
#   push    push every submodule with commits origin lacks (in parallel, each
#           to its own log), then the shared tier, all as the personal GitHub
#           account by token; repos already at origin are skipped silently;
#           a submodule failure blocks the shared push
#   status  both tiers, the submodules, and the last push per repo
#   logs    the push logs, for diagnosing a failed push
# Run: dotfiles <command> [flags]; dotfiles --help

set -euo pipefail

readonly SCRIPT_DIR="${0:A:h}"
readonly SKILLS_DIR="${HOME}/.claude/skills"

LIB_LOGGING="${SKILLS_DIR}/ari-skill-shellscripts/lib/logging.zsh"
# Bootstrap: before `dotfiles init` has linked the skills the farm is empty, and the
# only reachable copy is the shared tier's own.
[[ -r "${LIB_LOGGING}" ]] || LIB_LOGGING="${HOME}/.config/claude/skills/ari-skill-shellscripts/lib/logging.zsh"
readonly LIB_LOGGING
if [[ ! -r "${LIB_LOGGING}" ]]; then
  print -u2 "[ERROR] missing shared logging lib | path='${LIB_LOGGING}'"
  exit 1
fi
source "${LIB_LOGGING}"
source "${HOME}/.config/zsh/plugins/log_rotate.zsh"

# --- Environment variables ---

# The shared repo, cloned when missing. https so a fresh machine needs no key.
readonly DOTFILES_REMOTE="${DOTFILES_REMOTE:-https://github.com/AriSweedler/dotfiles.git}"
# The GitHub ssh key to load into the agent, described by a 1Password item that
# holds its "Absolute path" and "password" fields. Set by the local tier
# (~/.local/share/zsh/plugins/dotfiles.zsh); unset means "no key to load".
readonly DOTFILES_SSH_KEY_OP_ITEM="${DOTFILES_SSH_KEY_OP_ITEM:-}"
readonly DOTFILES_SSH_KEY_OP_VAULT="${DOTFILES_SSH_KEY_OP_VAULT:-}"
# The GitHub account every push authenticates as, through its `gh auth token`
# and a one-shot credential helper: the same account whatever gh account is
# active or whichever keys the ssh agent holds, nothing switched, nothing to
# restore. Needs `env -u GITHUB_TOKEN gh auth login` (HTTPS) once per machine.
readonly DOTFILES_GITHUB_LOGIN="${DOTFILES_GITHUB_LOGIN:-AriSweedler}"

# --- Constants ---

readonly DF_GIT_DIR="${HOME}/dotfiles.git"
readonly DF_WORK_TREE="${HOME}"
readonly DF_HOOKS="${HOME}/.config/git/dotfiles-hooks"
readonly LDF_GIT_DIR="${HOME}/.local/local-dotfiles.git"
readonly LDF_WORK_TREE="${HOME}/.local"
readonly LDF_HOOKS="${HOME}/.config/git/local-dotfiles-hooks"
readonly GITMODULES="${HOME}/.gitmodules"
readonly LOG_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/dotfiles/push"
readonly KEEP_BACKUPS=1
readonly REGISTRY_LINK="${HOME}/.config/claude/skills/ari-dotfiles-skill-registry/bin/link"
readonly VALID_COMMANDS=(init pull push status logs)

# Flags, set by main.
DRY_RUN=false
PUSH_SCOPE=all
LOGS_PREVIOUS=false
LOGS_REPO=""
# The login's gh token, set by cmd_push; inherited by the background pushes.
TOKEN=""

# --- Help ---

help() {
  cat <<EOF
${c_green}dotfiles${c_rst} — harness for the two-tier dotfiles: init, pull, push, status, logs

${c_bold}Usage:${c_rst}
  dotfiles init   [--dry-run]                 shared repo cloned + checked out, hooks wired,
                                              submodules checked out, skills linked, ssh key loaded
  dotfiles pull   [--dry-run]                 fast-forward the shared tier, then init
  dotfiles push   [--submodules-only|--shared-only] [--dry-run]
                                              push every submodule with something to push, in
                                              parallel (one log each), then the shared tier; both
                                              as the personal account. Repos already at origin are
                                              skipped silently; a submodule failure blocks the
                                              shared push.
  dotfiles status                             both tiers, submodules, last push per repo
  dotfiles logs   [--repo NAME] [--previous]  push logs (NAME = 'shared' or a submodule path)

${c_bold}Flags:${c_rst}
  --dry-run          Print what would run; change nothing
  --submodules-only  push: only the submodules
  --shared-only      push: only the shared tier
  --repo NAME        logs: one repo instead of all
  --previous         logs: the run before the last one (.log.bak.1)
  -h, --help         This help

${c_bold}Environment:${c_rst}
  DOTFILES_GITHUB_LOGIN        GitHub account every push authenticates as, by its gh token
                               (default ${DOTFILES_GITHUB_LOGIN}); once per machine: env -u GITHUB_TOKEN gh auth login
  DOTFILES_REMOTE              shared repo to clone when missing (default ${DOTFILES_REMOTE})
  DOTFILES_SSH_KEY_OP_ITEM     1Password item holding the ssh key's "Absolute path" and "password"
  DOTFILES_SSH_KEY_OP_VAULT    its vault; both come from the local tier, unset = no key to load

${c_bold}Logs:${c_rst} ${LOG_DIR}/<repo>.log (last run) and .log.bak.1 (the run before).
Pushes are token-pinned to ${DOTFILES_GITHUB_LOGIN}: no gh account switch, no ssh key swap.
Human-only: Claude Code is denied 'dotfiles push'.
EOF
}

# --- Git per tier ---

# -C <worktree>: with an explicit work tree, ls-files/status/submodule still scope
# themselves to the cwd, so a call from anywhere else would see a slice or nothing.
df_git()  { git -C "${DF_WORK_TREE}"  --git-dir="${DF_GIT_DIR}"  --work-tree="${DF_WORK_TREE}"  "${@}"; }
ldf_git() { git -C "${LDF_WORK_TREE}" --git-dir="${LDF_GIT_DIR}" --work-tree="${LDF_WORK_TREE}" "${@}"; }

#######################################
# Run a state-changing command, or print it under --dry-run.
# `runner=run_cmd_cap run_mut …` also logs the command's stdout, one line each.
#######################################
run_mut() {
  if [[ "${DRY_RUN}" == true ]]; then
    log::info "dry-run, would run | cmd='${*}'"
    return 0
  fi
  "${runner:-run_cmd}" "${@}"
}

# --- Submodules ---

#######################################
# Submodule paths declared in ~/.gitmodules, one per line, relative to $HOME.
#######################################
submodule_paths() {
  [[ -f "${GITMODULES}" ]] || return 0
  git config -f "${GITMODULES}" --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '{print $2}'
}

#######################################
# The log file for a repo: 'shared' or a submodule path (dot and slashes dropped).
# Arguments:
#   $1 - 'shared' or a submodule path relative to $HOME
#######################################
log_file() {
  local repo="${1#.}"
  print -r -- "${LOG_DIR}/${repo//\//-}.log"
}

# --- init ---

#######################################
# Clone the shared bare repo when this machine has none.
#######################################
init_clone() {
  if [[ -d "${DF_GIT_DIR}" ]]; then
    log::info "shared repo present | git_dir='${DF_GIT_DIR}'"
    return 0
  fi
  run_mut git clone --bare "${DOTFILES_REMOTE}" "${DF_GIT_DIR}"
}

#######################################
# A bare clone has no tracking config: no fetch refspec (so no remote-tracking
# refs) and no upstream for main. `dotfiles pull` needs the upstream; status
# needs origin/main to show ahead/behind.
#######################################
init_tracking() {
  [[ -d "${DF_GIT_DIR}" ]] || return 0
  local refspec='+refs/heads/*:refs/remotes/origin/*'
  if [[ "$(df_git config remote.origin.fetch 2>/dev/null || true)" == "${refspec}" &&
        "$(df_git config branch.main.remote 2>/dev/null || true)" == origin &&
        "$(df_git config branch.main.merge 2>/dev/null || true)" == refs/heads/main ]]; then
    log::info "main tracks origin/main | git_dir='${DF_GIT_DIR}'"
    return 0
  fi
  run_mut df_git config remote.origin.fetch "${refspec}" || return 1
  run_mut df_git config branch.main.remote origin || return 1
  run_mut df_git config branch.main.merge refs/heads/main
}

#######################################
# Create origin/main once (a bare clone has no remote-tracking refs). Runs after
# the ssh key is loaded: origin may be an ssh URL. Offline or keyless is a
# warning, not a failure; `dotfiles pull` fills it in later.
#######################################
init_fetch() {
  [[ -d "${DF_GIT_DIR}" ]] || return 0
  if df_git rev-parse -q --verify refs/remotes/origin/main >/dev/null 2>&1; then
    log::info "origin/main known | git_dir='${DF_GIT_DIR}'"
    return 0
  fi
  if ! run_mut df_git fetch -q origin; then
    log::warn "could not fetch origin; ahead/behind unknown until 'dotfiles pull' | url='$(df_git config remote.origin.url 2>/dev/null || true)'"
  fi
  return 0
}

#######################################
# Check the shared repo out into $HOME when nothing is checked out yet.
#######################################
init_checkout() {
  [[ -d "${DF_GIT_DIR}" ]] || return 0
  if [[ -n "$(df_git ls-files 2>/dev/null | head -n 1)" ]]; then
    log::info "shared tier checked out | work_tree='${DF_WORK_TREE}'"
    return 0
  fi
  if ! run_mut df_git checkout; then
    log::err "checkout failed; move the listed files aside and re-run | work_tree='${DF_WORK_TREE}'"
    return 1
  fi
}

#######################################
# Point a tier's core.hooksPath at its versioned hooks dir, once.
# Arguments:
#   $1 - git function (df_git | ldf_git)
#   $2 - hooks dir
#######################################
init_hooks() {
  local git_fn="${1}" hooks_dir="${2}" current
  current="$("${git_fn}" config --local core.hooksPath 2>/dev/null || true)"
  if [[ "${current}" == "${hooks_dir}" ]]; then
    log::info "hooks wired | tier='${git_fn%_git}' hooks_dir='${hooks_dir}'"
    return 0
  fi
  run_mut "${git_fn}" config --local core.hooksPath "${hooks_dir}"
}

init_submodules() {
  [[ -f "${GITMODULES}" ]] || return 0
  # git submodule refuses to run outside the worktree.
  ( cd "${DF_WORK_TREE}" && run_mut df_git submodule update --init )
}

init_skills() {
  if [[ ! -r "${REGISTRY_LINK}" ]]; then
    log::warn "skill registry not found; skills not linked | path='${REGISTRY_LINK}'"
    return 0
  fi
  # The registry prints its linked/pruned/skipped summary on stdout; log it.
  runner=run_cmd_cap run_mut zsh "${REGISTRY_LINK}" --prune
}

#######################################
# True (0) when the agent already holds the key at the given path.
# Arguments:
#   $1 - private key path
#######################################
ssh_key_loaded() {
  local key_path="${1}" fingerprint
  fingerprint="$(ssh-keygen -lf "${key_path}" 2>/dev/null | awk '{print $2}')" || return 1
  [[ -n "${fingerprint}" ]] || return 1
  ssh-add -l 2>/dev/null | awk '{print $2}' | grep -qxF "${fingerprint}"
}

#######################################
# Load the GitHub ssh key into the agent, its path and passphrase read from the
# 1Password item the local tier names. The passphrase goes from op straight to
# ssh-add through an askpass helper: never the clipboard, never argv.
#######################################
init_ssh_key() {
  if [[ -z "${DOTFILES_SSH_KEY_OP_ITEM}" ]]; then
    log::info "no ssh key configured; skipping | hint='DOTFILES_SSH_KEY_OP_ITEM in the local tier'"
    return 0
  fi
  if ! command -v op >/dev/null 2>&1; then
    log::warn "1Password CLI missing; ssh key not loaded | fix='brew install 1password-cli'"
    return 0
  fi
  local -a vault_flag=()
  [[ -n "${DOTFILES_SSH_KEY_OP_VAULT}" ]] && vault_flag=(--vault "${DOTFILES_SSH_KEY_OP_VAULT}")
  local key_path
  if ! key_path="$(op item get "${DOTFILES_SSH_KEY_OP_ITEM}" ${vault_flag[@]+"${vault_flag[@]}"} --field "Absolute path" 2>/dev/null)"; then
    log::err "1Password item not readable | item='${DOTFILES_SSH_KEY_OP_ITEM}' vault='${DOTFILES_SSH_KEY_OP_VAULT}' fix='op signin'"
    return 1
  fi
  key_path="${key_path/#\~/${HOME}}"
  if [[ ! -f "${key_path}" ]]; then
    log::err "ssh key file missing | path='${key_path}' item='${DOTFILES_SSH_KEY_OP_ITEM}'"
    return 1
  fi
  if ssh_key_loaded "${key_path}"; then
    log::info "ssh key already in the agent | path='${key_path}'"
    return 0
  fi
  if [[ "${DRY_RUN}" == true ]]; then
    log::info "dry-run, would ssh-add with the passphrase from 1Password | path='${key_path}' item='${DOTFILES_SSH_KEY_OP_ITEM}'"
    return 0
  fi
  local askpass
  askpass="$(mktemp)"
  trap 'rm -f "${askpass}"' EXIT
  {
    print -r -- '#!/usr/bin/env zsh'
    print -r -- "exec op item get ${(q)DOTFILES_SSH_KEY_OP_ITEM} ${(q)vault_flag[@]} --fields password --reveal"
  } > "${askpass}"
  chmod 700 "${askpass}"
  DISPLAY=1 SSH_ASKPASS="${askpass}" SSH_ASKPASS_REQUIRE=force ssh-add "${key_path}" </dev/null
  log::info "ssh key loaded | path='${key_path}'"
}

cmd_init() {
  check_prerequisites git || return 1
  init_clone || return 1
  init_tracking || return 1
  init_checkout || return 1
  init_hooks df_git "${DF_HOOKS}" || return 1
  if [[ -d "${LDF_GIT_DIR}" ]]; then
    init_hooks ldf_git "${LDF_HOOKS}" || return 1
  else
    log::info "no local tier on this machine | hint='new-machine apply local_dotfiles_repo'"
  fi
  init_submodules || return 1
  init_skills || return 1
  init_ssh_key || return 1
  init_fetch || return 1
  log::info "init done | next='per-submodule setup (chrome-exoskeleton: exo deps ci && exo build) or new-machine setup'"
  cmd_status
}

cmd_pull() {
  check_prerequisites git || return 1
  run_mut df_git pull --ff-only || return 1
  cmd_init
}

# --- push ---

#######################################
# Rewrite a GitHub remote URL to https so the token, not the ssh agent, authenticates.
# Arguments:
#   $1 - remote URL
# Outputs:
#   the https URL; returns 1 for a URL that is not on github.com
#######################################
to_https_url() {
  local url="${1}"
  case "${url}" in
    https://github.com/*)   print -r -- "${url}" ;;
    git@github.com:*)       print -r -- "https://github.com/${url#git@github.com:}" ;;
    ssh://git@github.com/*) print -r -- "https://github.com/${url#ssh://git@github.com/}" ;;
    *) return 1 ;;
  esac
}

#######################################
# Get the login's token from gh and check whose it is. Sets TOKEN.
# Globals:
#   DOTFILES_GITHUB_LOGIN, TOKEN
#######################################
load_token() {
  if ! TOKEN="$(env -u GITHUB_TOKEN gh auth token -u "${DOTFILES_GITHUB_LOGIN}" 2>/dev/null)" || [[ -z "${TOKEN}" ]]; then
    log::err "Personal account is not logged into gh | login='${DOTFILES_GITHUB_LOGIN}' fix='env -u GITHUB_TOKEN gh auth login   (HTTPS; pick ${DOTFILES_GITHUB_LOGIN})'"
    return 1
  fi
  local who
  who="$(GH_TOKEN="${TOKEN}" gh api user -q .login 2>/dev/null || true)"
  if [[ "${who}" != "${DOTFILES_GITHUB_LOGIN}" ]]; then
    log::err "Token identity mismatch | expected='${DOTFILES_GITHUB_LOGIN}' got='${who:-<none>}'"
    return 1
  fi
  log::info "pushing as | login='${DOTFILES_GITHUB_LOGIN}'"
}

#######################################
# Load the token before the first real push, once; a run with nothing to push
# never touches gh.
#######################################
ensure_token() {
  if [[ "${DRY_RUN}" == true || -n "${TOKEN}" ]]; then
    return 0
  fi
  load_token
}

#######################################
# git for a repo: the shared tier's bare repo and $HOME, or a submodule's directory.
# Arguments:
#   $1 - 'shared' or a submodule path relative to $HOME
#   $@ - git arguments
#######################################
repo_git() {
  local repo="${1}"; shift
  if [[ "${repo}" == shared ]]; then
    df_git "${@}"
  else
    git -C "${HOME}/${repo}" "${@}"
  fi
}

#######################################
# repo_git with a one-shot credential helper that answers with the login's
# token. The token travels in the environment, never in argv.
# Globals:
#   DOTFILES_GITHUB_LOGIN, TOKEN
# Arguments:
#   $1 - repo
#   $@ - git arguments
#######################################
repo_git_as_login() {
  local repo="${1}"; shift
  local -a git_cmd
  if [[ "${repo}" == shared ]]; then
    git_cmd=(git -C "${DF_WORK_TREE}" --git-dir="${DF_GIT_DIR}" --work-tree="${DF_WORK_TREE}")
  else
    git_cmd=(git -C "${HOME}/${repo}")
  fi
  DOTFILES_PUSH_LOGIN="${DOTFILES_GITHUB_LOGIN}" DOTFILES_PUSH_TOKEN="${TOKEN}" \
    "${git_cmd[@]}" -c credential.helper= \
      -c 'credential.helper=!f() { echo "username=${DOTFILES_PUSH_LOGIN}"; echo "password=${DOTFILES_PUSH_TOKEN}"; }; f' \
      "${@}"
}

#######################################
# Where a repo's push goes: its current branch, that branch's sha, origin as https.
# Arguments:
#   $1 - repo
# Outputs:
#   three lines: branch, sha, url; returns 1 with the reason logged
#######################################
push_target() {
  local repo="${1}" branch remote_url url fix
  branch="$(repo_git "${repo}" branch --show-current 2>/dev/null || true)"
  if [[ -z "${branch}" ]]; then
    if [[ "${repo}" == shared ]]; then
      fix="git df switch main"
    else
      fix="git -C ~/${repo} switch main   (/ari-dotfiles § Submodules step 1)"
    fi
    log::err "Detached HEAD: nothing to push | repo='${repo}' fix='${fix}'"
    return 1
  fi
  if ! remote_url="$(repo_git "${repo}" remote get-url origin 2>/dev/null)"; then
    log::err "No such remote | repo='${repo}' remote='origin' remotes='$(repo_git "${repo}" remote | tr '\n' ' ')'"
    return 1
  fi
  if ! url="$(to_https_url "${remote_url}")"; then
    log::err "Remote is not on github.com | repo='${repo}' url='${remote_url}'"
    return 1
  fi
  print -r -- "${branch}"
  repo_git "${repo}" rev-parse "refs/heads/${branch}"
  print -r -- "${url}"
}

#######################################
# Push one repo's current branch to origin as the login: push, confirm the
# remote ref, refresh origin/<branch> so hooks that read it (the shared tier's
# pointer check) see the push.
# Arguments:
#   $1 - repo
#######################################
push_repo_steps() {
  local repo="${1}"
  local -a target
  target=("${(@f)$(push_target "${repo}")}") || return 1
  local branch="${target[1]}" sha="${target[2]}" url="${target[3]}"
  log::info "Pushing | repo='${repo}' branch='${branch}' sha='${sha:0:7}' url='${url}' head_author='$(repo_git "${repo}" log -1 --format='%an <%ae>' "${sha}")'"
  if ! repo_git_as_login "${repo}" push "${url}" "refs/heads/${branch}:refs/heads/${branch}"; then
    log::err "Push rejected | repo='${repo}' branch='${branch}' url='${url}'"
    return 1
  fi
  local remote_sha
  remote_sha="$(repo_git_as_login "${repo}" ls-remote "${url}" "refs/heads/${branch}" | cut -f1)"
  if [[ "${remote_sha}" != "${sha}" ]]; then
    log::err "Remote ref does not match after push | repo='${repo}' remote_sha='${remote_sha}' local_sha='${sha}'"
    return 1
  fi
  if ! repo_git_as_login "${repo}" fetch -q origin "${branch}" 2>/dev/null; then
    log::warn "Pushed, but origin/${branch} did not refresh | repo='${repo}' hint='git fetch origin yourself'"
  fi
  log::info "Pushed | ${DOTFILES_GITHUB_LOGIN} ${branch}@${sha:0:7} -> ${url}"
}

#######################################
# push_repo_steps with everything in the repo's rotated log.
# Arguments:
#   $1 - repo
#######################################
push_repo() {
  local repo="${1}" logfile
  logfile="$(log_file "${repo}")"
  mkdir -p "${LOG_DIR}"
  log_rotate "${logfile}" "${KEEP_BACKUPS}"
  {
    print -r -- "# $(date -u +%FT%TZ) dotfiles push -> ${repo} as ${DOTFILES_GITHUB_LOGIN}"
    push_repo_steps "${repo}"
  } > "${logfile}" 2>&1
}

#######################################
# Under --dry-run: the push a repo would get. No network.
# Arguments:
#   $1 - repo
#######################################
dry_run_push() {
  local repo="${1}"
  local -a target
  target=("${(@f)$(push_target "${repo}")}") || return 1
  log::info "dry-run, would push | repo='${repo}' branch='${target[1]}' sha='${target[2]:0:7}' url='${target[3]}' log='$(log_file "${repo}")'"
}

#######################################
# True (0) when a repo has commits origin lacks, judged locally against the
# remote-tracking ref (refreshed by every push here and by pull): no network.
# Detached (after a pull) compares HEAD with origin/main. No tracking ref yet
# counts as needed; the push itself then decides.
# Arguments:
#   $1 - repo
#######################################
push_needed() {
  local repo="${1}" branch local_ref remote_ref
  branch="$(repo_git "${repo}" branch --show-current 2>/dev/null || true)"
  if [[ -n "${branch}" ]]; then
    local_ref="refs/heads/${branch}"
    remote_ref="refs/remotes/origin/${branch}"
  else
    local_ref=HEAD
    remote_ref=refs/remotes/origin/main
  fi
  repo_git "${repo}" rev-parse -q --verify "${remote_ref}" >/dev/null 2>&1 || return 0
  ! repo_git "${repo}" merge-base --is-ancestor "${local_ref}" "${remote_ref}" 2>/dev/null
}

#######################################
# Push every checked-out submodule that needs it, in parallel; wait for all;
# report the counts; fail if any failed. Up-to-date submodules are silent.
#######################################
push_submodules() {
  local -a paths
  paths=("${(@f)$(submodule_paths)}")
  paths=("${(@)paths:#}")
  if (( ${#paths} == 0 )); then
    log::info "no submodules declared | file='${GITMODULES}'"
    return 0
  fi
  local sub_path checked=0 pushed=0 failed=0 rc verb=pushed
  [[ "${DRY_RUN}" == true ]] && verb=would_push
  local -A pids
  for sub_path in "${paths[@]}"; do
    if [[ ! -e "${HOME}/${sub_path}/.git" ]]; then
      log::warn "submodule not checked out; skipping | path='${sub_path}' fix='dotfiles init'"
      continue
    fi
    checked=$(( checked + 1 ))
    push_needed "${sub_path}" || continue
    if [[ "${DRY_RUN}" == true ]]; then
      if dry_run_push "${sub_path}"; then
        pushed=$(( pushed + 1 ))
      else
        failed=$(( failed + 1 ))
      fi
      continue
    fi
    ensure_token || return 1
    push_repo "${sub_path}" &
    pids[${sub_path}]=$!
  done
  if (( ${#pids} > 0 )); then
    log::info "submodule pushes running | count='${#pids}' logs='${LOG_DIR}'"
    for sub_path in "${(@k)pids}"; do
      rc=0
      wait "${pids[${sub_path}]}" || rc=$?
      if (( rc == 0 )); then
        log::info "pushed | repo='${sub_path}' log='$(log_file "${sub_path}")'"
        pushed=$(( pushed + 1 ))
      else
        log::err "push failed | repo='${sub_path}' rc='${rc}' see='dotfiles logs --repo ${sub_path}'"
        failed=$(( failed + 1 ))
      fi
    done
  fi
  log::info "submodules done | checked='${checked}' ${verb}='${pushed}' failed='${failed}'"
  (( failed == 0 ))
}

push_shared() {
  if [[ ! -d "${DF_GIT_DIR}" ]]; then
    log::err "shared repo not cloned | git_dir='${DF_GIT_DIR}' fix='dotfiles init'"
    return 1
  fi
  if ! push_needed shared; then
    log::info "shared tier up to date | sha='$(df_git rev-parse --short HEAD 2>/dev/null || true)'"
    return 0
  fi
  if [[ "${DRY_RUN}" == true ]]; then
    dry_run_push shared
    return
  fi
  ensure_token || return 1
  if push_repo shared; then
    log::info "pushed | repo='shared' log='$(log_file shared)'"
    return 0
  fi
  log::err "push failed | repo='shared' see='dotfiles logs --repo shared'"
  return 1
}

cmd_push() {
  check_prerequisites git gh || return 1
  if [[ "${PUSH_SCOPE}" != shared-only ]]; then
    if ! push_submodules; then
      log::err "shared tier not pushed: a submodule push failed | fix='dotfiles logs, fix, dotfiles push'"
      return 1
    fi
  fi
  if [[ "${PUSH_SCOPE}" != submodules-only ]]; then
    push_shared || return 1
  fi
  log::info "push done | scope='${PUSH_SCOPE}'"
}

# --- status / logs ---

#######################################
# A push log's verdict: its last line without color codes and the [LEVEL] tag.
# Arguments:
#   $1 - log file
#######################################
log_verdict() {
  tail -n 1 "${1}" | awk '{ gsub(/[[:cntrl:]]\[[0-9;]*m/, ""); sub(/^\[[A-Z]+\] /, ""); print }'
}

#######################################
# One line for a tier: branch and ahead/behind from status -sb, plus dirty counts.
# Arguments:
#   $1 - label
#   $2 - git function name (df_git | ldf_git)
#######################################
tier_line() {
  local label="${1}" git_fn="${2}"
  local head dirty
  head="$("${git_fn}" status -sb --untracked-files=no 2>/dev/null | head -n 1 || true)"
  dirty="$("${git_fn}" status --short --untracked-files=no 2>/dev/null | wc -l | tr -d ' ' || true)"
  print -r -- "${label}: ${head:-not cloned}  uncommitted=${dirty:-?}"
}

cmd_status() {
  print -r -- "${c_bold}tiers${c_rst}"
  print -r -- "  $(tier_line shared df_git)"
  if [[ -d "${LDF_GIT_DIR}" ]]; then
    print -r -- "  $(tier_line local ldf_git)"
  else
    print -r -- "  local: no repo (new-machine setup)"
  fi
  print -r -- "${c_bold}submodules${c_rst} (space = at the pointer, + = ahead of it, - = not initialized)"
  if [[ -f "${GITMODULES}" ]]; then
    ( cd "${DF_WORK_TREE}" && df_git submodule status 2>/dev/null | awk '{print "  " $0}' ) || true
  else
    print -r -- "  none declared"
  fi
  print -r -- "${c_bold}last push${c_rst} (${LOG_DIR}; 'dotfiles logs' for the whole run)"
  local logfile
  for logfile in "${LOG_DIR}"/*.log(N); do
    printf '  %-26s %s  %s\n' "${logfile:t:r}" "$(head -n 1 "${logfile}" | awk '{print $2}')" "$(log_verdict "${logfile}")"
  done
  [[ -n "$(print -l "${LOG_DIR}"/*.log(N))" ]] || print -r -- "  none yet"
}

cmd_logs() {
  local -a files
  local suffix="" repo
  [[ "${LOGS_PREVIOUS}" == true ]] && suffix=".bak.1"
  if [[ -n "${LOGS_REPO}" ]]; then
    files=("$(log_file "${LOGS_REPO}")${suffix}")
  else
    files=("${LOG_DIR}"/*.log${suffix}(N))
  fi
  if (( ${#files} == 0 )); then
    log::info "no push logs yet | dir='${LOG_DIR}'"
    return 0
  fi
  local file
  for file in "${files[@]}"; do
    if [[ ! -f "${file}" ]]; then
      log::err "no such log | file='${file}' valid_repos='shared, $(submodule_paths | tr '\n' ' ')'"
      return 1
    fi
    print -r -- "${c_bold}=== ${file:t} ($(date -r "${file}" -u +%FT%TZ)) ===${c_rst}"
    cat "${file}"
  done
}

# --- Prerequisites ---

#######################################
# Check that required binaries are installed.
# Arguments: the commands to require
#######################################
check_prerequisites() {
  local -a missing=()
  local cmd
  for cmd in "${@}"; do
    command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
  done
  if (( ${#missing} > 0 )); then
    log::err "Missing required commands | missing='${(j:, :)missing}'"
    return 1
  fi
}

# --- Main ---

main() {
  # === PARSE ===
  local command=""
  while (( $# > 0 )); do case "${1}" in
    -h|--help)          help; return 0 ;;
    --dry-run)          DRY_RUN=true; shift ;;
    --submodules-only)  PUSH_SCOPE=submodules-only; shift ;;
    --shared-only)      PUSH_SCOPE=shared-only; shift ;;
    --previous)         LOGS_PREVIOUS=true; shift ;;
    --repo)             LOGS_REPO="${2:?--repo requires a value}"; shift 2 ;;
    -*)                 log::err "Unknown flag | flag='${1}'"; help; return 1 ;;
    *)
      if [[ -n "${command}" ]]; then
        log::err "Unexpected argument | argument='${1}' command='${command}'"; help; return 1
      fi
      command="${1}"; shift ;;
  esac; done

  # === MASSAGE ===
  command="${command:l}"

  # === VALIDATE ===
  if [[ -z "${command}" ]]; then
    log::err "Missing command | valid_commands='${(j:, :)VALID_COMMANDS}'"
    help
    return 1
  fi
  if (( ! ${VALID_COMMANDS[(Ie)${command}]} )); then
    log::err "Invalid command | command='${command}' valid_commands='${(j:, :)VALID_COMMANDS}'"
    help
    return 1
  fi

  # === LOGIC ===
  "cmd_${command}"
}

main "${@}"
