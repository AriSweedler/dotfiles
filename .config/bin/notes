#!/usr/bin/env zsh
# notes — a date-indexed git journal of daily notes.
#
# Layout under $NOTE_BASE (default ~/Desktop/notes):
#   .datekeeper              Append-only list of registered dates (YYYY/Mon/DD).
#   <year>/<Mon>/<DD>.md     One note per day, e.g. 2026/Apr/30.md.
#   today.md                 Gitignored symlink to today's note.
#   etc/tasks/daily.md       Template appended to every new note.
#   etc/tasks/<weekday>.md   Optional day-of-week template (monday.md, ...).
#
# Invariant: every past note is committed; today's note is staged, uncommitted.
# Rollover is lazy: the first run on a new day commits yesterday and opens today.
# Git hooks run with their output visible, so a hook that asks a question can
# be answered instead of hanging on a prompt nobody sees.

set -euo pipefail

# --- Logging (shared lib; never re-define log::* inline) ---

readonly LIB_LOGGING="${HOME}/.claude/skills/ari-skill-shellscripts/lib/logging.zsh"
if [[ ! -r "${LIB_LOGGING}" ]]; then
  print -u2 "[ERROR] missing shared logging lib | path='${LIB_LOGGING}'"
  exit 1
fi
source "${LIB_LOGGING}"

# --- Constants (paths are relative to NOTE_BASE; main cd's there) ---

readonly NOTE_BASE="${NOTE_BASE:-${HOME}/Desktop/notes}"
readonly DATEKEEPER=".datekeeper"
readonly TODAY_LINK="today.md"
readonly TASKS="etc/tasks"
readonly TODAY="$(date '+%Y/%b/%d')"
readonly WEEKDAY="${(L)$(date '+%A')}"
readonly VERBS=(open path init fix healthcheck)
# Glob for a note path, YYYY/Mon/DD.md. Expand with ${~NOTE_GLOB}.
readonly NOTE_GLOB='[0-9][0-9][0-9][0-9]/[A-Z][a-z][a-z]/[0-9][0-9].md'

DRY_RUN=false

# --- Helpers ---

#######################################
# Print each argument on its own line, and nothing at all for no arguments
# (`print -l` alone would print one empty line).
#######################################
lines() {
  (( $# )) && print -rl -- "${@}"
  return 0
}

#######################################
# Strip trailing whitespace from a file in place. Wraps the BSD/GNU `sed -i`
# difference.
# Arguments: $1 = file
#######################################
strip_trailing_whitespace() {
  if [[ "${OSTYPE}" == darwin* ]]; then
    sed -i '' -E 's/[[:space:]]+$//' "${1}"
    return 0
  fi
  sed -i -E 's/[[:space:]]+$//' "${1}"
}

# --- Git queries (read-only; stdout is data) ---

is_tracked() { git ls-files --error-unmatch -- "${1}" &>/dev/null; }
is_dirty()   { [[ -n "$(git status --porcelain -- "${1}")" ]]; }

#######################################
# Dirty paths the daily rollover does not own: everything except today's note,
# the today.md link, and .datekeeper.
#######################################
dirty_past_paths() {
  local -a dirty
  dirty=( ${(f)"$(git status --porcelain | cut -c4-)"} )
  lines "${(@)dirty:#(${TODAY}.md|${TODAY_LINK}|${DATEKEEPER})}"
}

#######################################
# Date-named past notes with uncommitted changes.
#######################################
uncommitted_past_notes() {
  local -a past
  past=( ${(f)"$(dirty_past_paths)"} )
  lines "${(@M)past:#${~NOTE_GLOB}}"
}

# `awk NF` drops blank lines; the file has historically had one at the top.
registered_dates() { awk 'NF' "${DATEKEEPER}" | sort -u; }

note_dates() {
  local -a notes
  notes=( ${~NOTE_GLOB}(N) )
  lines "${(@)notes%.md}" | sort -u
}

# --- Git mutations ---

#######################################
# Commit one path with a message. Trailing whitespace is stripped first, since
# the repo's pre-commit hook rejects it. Under --dry-run, log instead.
# Globals: DRY_RUN
# Arguments: $1 = path, $2 = commit message
#######################################
commit_path() {
  # Not `path`: in zsh that is the array tied to PATH, and a local would shadow it.
  local file="${1}" message="${2}"
  if [[ "${DRY_RUN}" == "true" ]]; then
    log::info "would commit | file='${file}' message='${message}'"
    return 0
  fi
  strip_trailing_whitespace "${file}"
  git add -- "${file}"
  git commit --quiet --message "${message}" -- "${file}"
  log::info "committed | file='${file}'"
}

#######################################
# Commit every uncommitted past note (one commit per day), then .datekeeper if
# it is dirty. Idempotent.
#######################################
commit_past() {
  local note
  for note in ${(f)"$(uncommitted_past_notes)"}; do
    commit_path "${note}" "Journal entry for ${note%.md}"
  done
  is_dirty "${DATEKEEPER}" && commit_path "${DATEKEEPER}" "Update ${DATEKEEPER}"
  return 0
}

# --- Repo lifecycle ---

#######################################
# Initialize the repo unless .datekeeper is already tracked. Idempotent.
#######################################
ensure_repo() {
  is_tracked "${DATEKEEPER}" && return 0
  log::info "initializing repo | path='${NOTE_BASE}'"
  git init --quiet
  echo "${TODAY_LINK}" > .gitignore
  : >> "${DATEKEEPER}"
  git add -- .gitignore "${DATEKEEPER}"
  git commit --quiet --message 'first commit'
}

#######################################
# Create a note: a date heading, then the daily and weekday templates that exist.
# Arguments: $1 = note path
#######################################
create_note() {
  local note="${1}"
  mkdir -p "${note:h}"
  {
    echo "# $(date '+%b %d, %Y')"
    cat /dev/null "${TASKS}"/daily.md(N) "${TASKS}/${WEEKDAY}.md"(N)
  } > "${note}"
}

#######################################
# Register today: append to .datekeeper, create the note, point today.md at it,
# stage both. Idempotent.
#######################################
register_today() {
  grep -qxF "${TODAY}" "${DATEKEEPER}" || echo "${TODAY}" >> "${DATEKEEPER}"
  [[ -e "${TODAY}.md" ]] || create_note "${TODAY}.md"
  ln -sfn "${NOTE_BASE}/${TODAY}.md" "${TODAY_LINK}"
  git add -- "${TODAY}.md" "${DATEKEEPER}"
}

# --- Healthcheck ---

#######################################
# Print one line per broken invariant; print nothing when healthy.
#######################################
problems() {
  if ! is_tracked "${DATEKEEPER}"; then
    echo "${DATEKEEPER} not tracked in git — run 'notes init'"
    return 0
  fi
  comm -23 <(registered_dates) <(note_dates) | awk '{print "missing note for " $0}'
  comm -13 <(registered_dates) <(note_dates) | awk '{print "orphan note, not in .datekeeper: " $0}'
  dirty_past_paths | awk '{print "uncommitted past file: " $0}'
  [[ -e "${TODAY_LINK}" ]] || echo "${TODAY_LINK} missing or dangling"
}

#######################################
# Warn about every problem. Returns 1 if there were any.
# Arguments: --quiet to skip the all-clear line
#######################################
healthcheck() {
  local -a found
  found=( ${(f)"$(problems)"} )
  local problem
  for problem in "${found[@]}"; do log::warn "${problem}"; done
  if (( ${#found} )); then
    log::err "issues found | count='${#found}'"
    return 1
  fi
  [[ "${1:-}" == "--quiet" ]] || log::info "all checks passed"
}

# --- Editor ---

#######################################
# Open the last five notes in nvim: buffers oldest to newest, today on the
# left, yesterday on the right. `belowright vsp` ignores the user's splitright.
#######################################
open_journal() {
  local -a files
  files=( ${(f)"$(tail -n 5 "${DATEKEEPER}")"} )
  files=( "${(@)files/%/.md}" )
  local n="${#files}"
  local prev=$(( n > 1 ? n - 1 : 1 ))
  nvim "${files[@]}" -c "${n}b | belowright vsp | ${prev}b | setlocal foldlevel=1 | wincmd h"
}

# --- Commands ---

# Runs before open/path: settle the past, register today, surface what's left.
prelude() {
  ensure_repo
  commit_past
  register_today
  healthcheck --quiet || true
}

cmd_open() {
  prelude
  [[ -z "${TMUX:-}" ]] || tmux rename-window notes
  open_journal
}

cmd_path() {
  prelude
  echo "${NOTE_BASE}/${TODAY}.md"
}

cmd_init() { ensure_repo; }

cmd_fix() {
  ensure_repo
  commit_past
  healthcheck
}

cmd_healthcheck() { healthcheck; }

# --- Help ---

help() {
  cat <<EOF
${c_green}notes${c_rst} — open or initialize today's daily note

${c_bold}Usage:${c_rst}
  notes [open]        Commit past notes, register today, open the last 5 days in nvim.
  notes path          Same prelude, then print today's note path. For tools.
  notes init          Initialize the notes repo only.
  notes fix           Commit uncommitted past notes (one commit per day), then healthcheck.
  notes healthcheck   Verify on-disk and git invariants.

${c_bold}Options:${c_rst}
  --dry-run           Log which commits would be made and make none.
  -h, --help          Show this help.

Notes live under \$NOTE_BASE (default ~/Desktop/notes) at <year>/<Mon>/<DD>.md.
EOF
}

# --- Main ---

check_prerequisites() {
  local -a missing
  local cmd
  for cmd in git nvim; do
    command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
  done
  if (( ${#missing} )); then
    log::err "missing required commands | missing='${(j:, :)missing}'"
    return 1
  fi
}

main() {
  # === PARSE ===
  local verb="open"
  while (( $# )); do case "${1}" in
    -h|--help)  help; return 0 ;;
    --dry-run)  DRY_RUN=true; shift ;;
    -*)         log::err "unknown flag | flag='${1}'"; help; return 1 ;;
    *)          verb="${1}"; shift ;;
  esac; done

  # === VALIDATE ===
  if (( ! $+functions[cmd_${verb}] )); then
    log::err "unknown command | verb='${verb}' valid='${(j:, :)VERBS}'"
    help
    return 1
  fi
  check_prerequisites || return 1

  # === LOGIC ===
  mkdir -p "${NOTE_BASE}"
  cd "${NOTE_BASE}"
  "cmd_${verb}"
}

main "${@}"
