#!/usr/bin/env zsh
# ldf-link: assembles ~/.local from the one local-dotfiles repo (a clone at ~/local-dotfiles): this
# machine's own directory, local/<machine>/, over the directory of each tag the repo's `machines`
# file gives it (pi/, nixos/, mac/, ...). Each file becomes a link at the same path under ~/.local.
#
#   ldf-link              a dry run: says what it would link, replace, refuse or prune
#   ldf-link --execute    does it
#
# Order, per path: local/<machine> wins over a tag, and a tag over the shared tier (which lives in
# ~/.config, so never collides here). One path in two of the machine's tags, and not in
# local/<machine>, is a conflict no rule settles: nothing is linked, the path and both tags are
# named, and Ari picks which tag keeps it.
#
# A real file where a link goes is replaced only when its bytes equal the source's (a machine
# moving onto the repo); otherwise it is refused and named. A link into the repo whose source is
# gone is pruned.
#
#   machines file: one line per machine, its name then its tags; # starts a comment
#     ozone mac
#     ganymede nixos pi
#
# Env: LDF_REPO (default ~/local-dotfiles), LDF_TARGET (default ~/.local), ARI_DOTFILES_MACHINE
# (default: the one word in $LDF_TARGET/share/dotfiles/machine-name, else hostname -s).
# Exit: 0 done (or nothing to do), 1 a conflict or a refused path (nothing else is held back by a
# refusal; a conflict links nothing), 64 usage.

set -euo pipefail

readonly REPO="${LDF_REPO:-${HOME}/local-dotfiles}"
readonly TARGET="${LDF_TARGET:-${HOME}/.local}"

execute=0
case "${1:-}" in
  --execute) execute=1 ;;
  "") ;;
  -h|--help) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) print -u2 "ldf-link: unknown argument '$1' (try --help)"; exit 64 ;;
esac

die() { print -u2 -- "ldf-link: $*"; exit 1; }
say() { if (( execute )); then print -- "$1 $2"; else print -- "would $1 $2"; fi; }

[[ -d "${REPO}" ]] || die "no repo at ${REPO}"
[[ -r "${REPO}/machines" ]] || die "no machines file at ${REPO}/machines"

machine_name() {
  [[ -n "${ARI_DOTFILES_MACHINE:-}" ]] && { print -- "${ARI_DOTFILES_MACHINE}"; return; }
  local f="${TARGET}/share/dotfiles/machine-name"
  [[ -r "${f}" ]] && { print -- "$(<"${f}")"; return; }
  hostname -s
}
readonly MACHINE="$(machine_name)"

# the tags the machines file gives this machine
typeset -a tags=()
found=0
while read -r name rest; do
  [[ -z "${name}" || "${name}" == \#* ]] && continue
  [[ "${name}" == "${MACHINE}" ]] || continue
  found=1
  tags=(${=rest%%\#*})
done < "${REPO}/machines"
(( found )) || die "machine '${MACHINE}' is not in ${REPO}/machines"

# The files under one layer directory, relative to it: the repo's tracked files when it is a git
# work tree, so an untracked scratch file is never linked; every file otherwise (a fixture).
layer_files() {
  local dir="$1"
  [[ -d "${REPO}/${dir}" ]] || return 0
  if git -C "${REPO}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "${REPO}" ls-files -z -- "${dir}" | while IFS= read -r -d '' f; do print -- "${f#${dir}/}"; done
  else
    (cd "${REPO}/${dir}" && find . \( -type f -o -type l \) | sed 's|^\./||')
  fi
}

# path -> source, and path -> the tag that gave it
typeset -A source_of=() tag_of=()
typeset -a conflicts=()
for tag in "${tags[@]}"; do
  while IFS= read -r rel; do
    [[ -n "${rel}" ]] || continue
    if [[ -n "${tag_of[${rel}]:-}" ]]; then
      conflicts+=("${rel} ${tag_of[${rel}]} ${tag}")
    else
      tag_of[${rel}]="${tag}"
      source_of[${rel}]="${REPO}/${tag}/${rel}"
    fi
  done < <(layer_files "${tag}")
done
typeset -A is_local=()
while IFS= read -r rel; do
  [[ -n "${rel}" ]] || continue
  is_local[${rel}]=1
  source_of[${rel}]="${REPO}/local/${MACHINE}/${rel}"
done < <(layer_files "local/${MACHINE}")

# a conflict local/<machine> settles is no conflict
typeset -a open_conflicts=()
for c in "${conflicts[@]}"; do
  [[ -n "${is_local[${c%% *}]:-}" ]] || open_conflicts+=("${c}")
done
if (( ${#open_conflicts} )); then
  for c in "${open_conflicts[@]}"; do
    parts=(${=c})
    print -u2 -- "conflict ${parts[1]}: in tags ${parts[2]} and ${parts[3]}; ask Ari which tag keeps it (or put this machine's copy in local/${MACHINE})"
  done
  exit 1
fi

changes=0 refusals=0
for rel in "${(@k)source_of}"; do
  src="${source_of[${rel}]}" dst="${TARGET}/${rel}"
  if [[ -L "${dst}" ]]; then
    [[ "$(readlink "${dst}")" == "${src}" ]] && continue
    # a link of ours to another layer's copy (a tag file local now overrides): repoint it
    if [[ "$(readlink "${dst}")" == "${REPO}"/* ]]; then
      say repoint "${dst} -> ${src}"; changes=$((changes + 1))
      (( execute )) && ln -sfn "${src}" "${dst}"
      continue
    fi
    print -u2 -- "refuse ${dst}: a link to $(readlink "${dst}"), not into ${REPO}"; refusals=$((refusals + 1))
    continue
  fi
  if [[ -e "${dst}" ]]; then
    if [[ -f "${dst}" ]] && cmp -s "${dst}" "${src}"; then
      say replace "${dst} (identical) -> ${src}"; changes=$((changes + 1))
      (( execute )) && ln -sfn "${src}" "${dst}"
    else
      print -u2 -- "refuse ${dst}: differs from ${src}; keep one copy, then run again"; refusals=$((refusals + 1))
    fi
    continue
  fi
  say link "${dst} -> ${src}"; changes=$((changes + 1))
  if (( execute )); then mkdir -p "${dst:h}" && ln -s "${src}" "${dst}"; fi
done

# links into the repo whose source is gone, or that no layer of this machine names any more
if [[ -d "${TARGET}" ]]; then
  while IFS= read -r -d '' link; do
    rel="${link#${TARGET}/}"
    [[ -n "${source_of[${rel}]:-}" && -e "${link}" ]] && continue
    say prune "${link}"; changes=$((changes + 1))
    (( execute )) && rm -f "${link}"
  done < <(find "${TARGET}" -type l -lname "${REPO}/*" -print0 2>/dev/null)
fi

(( changes )) || print -- "nothing to change (${MACHINE}: local/${MACHINE}${tags:+ over ${tags[*]}})"
(( refusals == 0 ))
