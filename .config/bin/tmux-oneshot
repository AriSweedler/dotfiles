#!/usr/bin/env zsh
#
# tmux-oneshot — pick a oneshot command from a JSON database via fzf and run
# it. Bound to <Prefix>C-k (see ~/.config/tmux/plugin/macros.conf), which
# opens this in a tmux popup.
#
# The database is a JSON list. Minimal entry: {"cmd": "killall Dock"}. Full
# schema (everything but one of cmd/subcommands is optional):
#
#   cmd          command fragment
#   pwd          cd here first (honored at the top level only)
#   description  shown in menus after the cmd
#   autodismiss  true: close the popup as soon as the command succeeds.
#                Default false: hold the popup open (output stays readable)
#                until Esc. Failures always hold.
#   menu         menu-line override: {"name", "text"}, both optional. The
#                menu line is "<name>  <text>": name defaults to cmd, padded
#                to a common column and truncated past 40 chars so lines
#                never wrap; text defaults to the auto-generated body (args
#                hint, description, pwd). menu.name doubles as the entry's
#                key (unnamed entries keep 1-based index keys), so it must
#                be unique and must not contain "/".
#   flags        multiselected at run time (tab: toggle, esc: none)
#     flag         e.g. "--verbose", or an env var name like "ACTION"
#     type         "bool" (default: emits just the flag) or "kv"
#     style        kv only — how the value attaches:
#                  space (default): --flag value
#                  space-quoted:    --flag 'value'
#                  equals:          --flag=value
#                  equals-quoted:   --flag='value'
#     options      kv only — fzf through these; absent means type the value
#     description  shown in the flag menu
#   subcommands  list of nested entries (recursive: cmd/flags/subcommands/
#                description) — pick one, then its args resolve in turn
#
# Assembly order per level: cmd, then selected flags, then the chosen
# subcommand's assembly. The top-level menu shows only cmd/description plus a
# "…" hint when an entry has flags or subcommands — never the options.
#
# Built on fzfdb (~/.config/zsh/plugins/fzfdb_cli.zsh). Keys are 1-based
# indices into the JSON list. fzfdb's preview subshell *sources* this file to
# pick up the tmux_oneshot::* overrides — the ZSH_EVAL_CONTEXT guard at the
# bottom keeps that from re-running the picker.

source "${HOME}/.config/zsh/plugins/log.zsh"
source "${HOME}/.config/zsh/plugins/arr.zsh"
source "${HOME}/.config/zsh/plugins/fzfdb_cli.zsh"

# Exported so the fzf preview subshell resolves the same database.
export TMUX_ONESHOT_DB="${TMUX_ONESHOT_DB:-${XDG_DATA_HOME:-${HOME}/.local/share}/tmux_oneshot/commands.json}"

function tmux_oneshot() {
  local dep
  for dep in jq fzf; do
    if ! command -v "${dep}" &>/dev/null; then
      log::err "Required command not found | cmd='${dep}'"
      return 1
    fi
  done

  if [[ ! -e "${TMUX_ONESHOT_DB}" ]]; then
    mkdir -p "${TMUX_ONESHOT_DB:h}"
    cat > "${TMUX_ONESHOT_DB}" << 'EOF'
[
  {"cmd": "killall NotificationCenter", "autodismiss": true},
  {"pwd": "~", "cmd": "echo 'hello from tmux-oneshot'",
   "menu": {"name": "hello", "text": "demo entry — edit me: tmux-oneshot --edit"}}
]
EOF
    log::info "Seeded oneshot database | path='${TMUX_ONESHOT_DB}'"
  fi

  if ! jq -e 'type == "array"' "${TMUX_ONESHOT_DB}" &>/dev/null; then
    log::err "Database is not a JSON list | path='${TMUX_ONESHOT_DB}'"
    return 1
  fi

  if [[ "${1:-}" == "--debug" ]]; then
    tmux_oneshot::action::debug
    return $?
  fi

  fzfdb --fzfdb_dir "${TMUX_ONESHOT_DB:h:h}" -- "$@"
}

# Non-interactive diagnostic: exercises every popup code path except the fzf
# UI itself — menu render, menuitem::key round-trip, entry JSON, and the
# exact preview subshell fzf would spawn. For agents/humans without a tty.
function tmux_oneshot::action::debug() {
  local rc=0 k line back preview_out
  local -a keys
  keys=(${(f)"$(tmux_oneshot::action::list)"})
  log::info "Debug render | db='${TMUX_ONESHOT_DB}' entries='${#keys[@]}' name_width='$(tmux_oneshot::_name_width)'"
  for k in "${keys[@]}"; do
    if ! line="$(tmux_oneshot::key::menuitem "${k}")"; then
      log::err "menuitem render failed | key='${k}'"
      rc=1
      continue
    fi
    print -r -- "  ${line}"
    back="$(tmux_oneshot::menuitem::key "${line}")"
    if [[ "${back}" != "${k}" ]]; then
      log::err "menuitem::key round-trip failed | key='${k}' recovered='${back}'"
      rc=1
    fi
    if ! tmux_oneshot::key::value "${k}" > /dev/null; then
      log::err "key::value failed | key='${k}'"
      rc=1
    fi
    # Reproduce the fzf preview subshell verbatim: fresh non-interactive zsh,
    # fzfdb's source chain, then the dispatched preview action.
    if ! preview_out="$(zsh -c "
        source '${HOME}/.config/zsh/plugins/fzfdb_cli.zsh'
        source '${HOME}/.config/bin/tmux-oneshot'
        source '${HOME}/.config/zsh/plugins/log.zsh'
        source '${HOME}/.config/zsh/plugins/arr.zsh'
        fzfdb --fzfdb_name tmux_oneshot --fzfdb_dir ${(q)TMUX_ONESHOT_DB:h:h} -- --preview::menuitem ${(q)line}" 2>&1)"; then
      log::err "preview subshell failed | key='${k}' output='${preview_out}'"
      rc=1
    fi
  done
  if (( rc == 0 )); then
    log::info "Debug render clean | entries='${#keys[@]}'"
  fi
  return ${rc}
}

function tmux_oneshot::action::help() {
  echo -e "$(cat << EOF
USAGE: tmux-oneshot [key]
       tmux-oneshot --debug   # non-interactive: render + round-trip + preview every entry

Pick a oneshot command from the JSON database and run it. Selecting an entry
cds to its pwd (if set), interactively resolves its flags/subcommands (if
any), then evals the assembled command. Pass a key (an entry's menu.name, or
its 1-based index when unnamed) to skip the top-level menu. The entry schema
is documented at the top of this script.

Database: ${c_grey}${TMUX_ONESHOT_DB}${c_rst} (override with TMUX_ONESHOT_DB)

$(fzfdb::help_common)
EOF
)"
}

# Input: none
# Output: one key per line — menu.name when set, else the 1-based index
function tmux_oneshot::action::list() {
  jq -r 'to_entries[] | .value.menu.name // ((.key + 1) | tostring)' "${TMUX_ONESHOT_DB}"
}

# Input: key (a menu.name, or a 1-based index for unnamed entries)
# Output: the entry's 0-based index in the JSON list; empty if unknown
function tmux_oneshot::_key_to_index() {
  local key="${1:?}"
  jq -r --arg k "${key}" 'to_entries
    | map(select((.value.menu.name // ((.key + 1) | tostring)) == $k))
    | .[0].key // empty' "${TMUX_ONESHOT_DB}"
}

function tmux_oneshot::action::edit() {
  "${EDITOR:-vim}" "${TMUX_ONESHOT_DB}"
}

# Input: key
# Output: the entry's 0-based index; errors cleanly on an unknown key so no
# caller ever hands an empty string to jq --argjson.
function tmux_oneshot::_index_or_die() {
  local key="${1:?}"
  local idx
  idx="$(tmux_oneshot::_key_to_index "${key}")"
  if [[ -z "${idx}" ]]; then
    log::err "Unknown key | key='${key}' db='${TMUX_ONESHOT_DB}'"
    return 1
  fi
  echo "${idx}"
}

# Input: key
# Output: the entry's JSON, shown in the fzf preview window
function tmux_oneshot::key::value() {
  local key="${1:?}"
  local idx
  idx="$(tmux_oneshot::_index_or_die "${key}")" || return 1
  jq --argjson i "${idx}" '.[$i]' "${TMUX_ONESHOT_DB}"
}

# The display-name column width: longest name in the db, capped so long cmds
# never push the menu line into wrapping territory. Not readonly — this file
# is sourced by the fzf preview subshell and by tests, sometimes twice.
: "${TMUX_ONESHOT_NAME_MAX:=40}"
function tmux_oneshot::_name_width() {
  jq -r --argjson cap "${TMUX_ONESHOT_NAME_MAX}" \
    '[.[] | (.menu.name // .cmd // "?") | length] | (max // 1) | if . > $cap then $cap else . end' \
    "${TMUX_ONESHOT_DB}"
}

# Input: key
# Output: "<name>" or "<name><padding>  <text>" — no separator token. name =
# menu.name // cmd, truncated to the column cap; text = menu.text, else the
# auto body (cmd is included there only when a menu.name displaced it).
function tmux_oneshot::key::menuitem() {
  local key="${1:?}"
  local idx width
  idx="$(tmux_oneshot::_index_or_die "${key}")" || return 1
  width="$(tmux_oneshot::_name_width)"
  jq -r --argjson i "${idx}" --argjson w "${width}" '
    .[$i]
    | ((.menu.name // .cmd // "?") | if length > $w then .[:$w-1] + "…" else . end) as $name
    | ((.menu.text
        // ((if .menu.name then (.cmd // "") else "" end)
          + (if ((.flags // []) + (.subcommands // []) | length) > 0 then " …" else "" end)
          + (if .description then "  # " + .description else "" end)
          + (if .pwd then " @ " + .pwd else "" end)))
       | ltrimstr(" ")) as $text
    | if $text == "" then $name
      else $name + (" " * ($w - ($name | length) + 2)) + $text
      end' \
    "${TMUX_ONESHOT_DB}"
}

# Input: a rendered menu line
# Output: the key that generated it. Regenerate-and-compare, so key recovery
# is format-agnostic (no separator-token parsing to drift out of sync).
function tmux_oneshot::menuitem::key() {
  local menuitem="${1:?}"
  local k
  for k in ${(f)"$(tmux_oneshot::action::list)"}; do
    if [[ "$(tmux_oneshot::key::menuitem "${k}")" == "${menuitem}" ]]; then
      echo "${k}"
      return 0
    fi
  done
  return 1
}

# Seams: tests stub these two to drive the interactive paths headlessly.
function tmux_oneshot::_fzf() {
  fzf "$@"
}
function tmux_oneshot::_read_value() {
  local value
  read -r "value?${1:?} value: " < /dev/tty
  echo "${value}"
}

# Pure renderer. Input: <flag> <style> <value>. Output: the flag text.
function tmux_oneshot::_render_kv() {
  local flag="${1:?}" style="${2:?}" value="${3?}"
  case "${style}" in
    space)         echo "${flag} ${value}";;
    space-quoted)  echo "${flag} ${(qq)value}";;
    equals)        echo "${flag}=${value}";;
    equals-quoted) echo "${flag}=${(qq)value}";;
    *)
      log::err "Unknown flag style | style='${style}' flag='${flag}'"
      return 1
      ;;
  esac
}

# Input: one flag spec (JSON object)
# Output: the rendered flag text. Non-zero means skip this flag.
function tmux_oneshot::_flag() {
  local spec="${1:?}"
  local flag type
  flag="$(jq -r '.flag' <<< "${spec}")"
  type="$(jq -r '.type // "bool"' <<< "${spec}")"
  if [[ "${type}" == "bool" ]]; then
    echo "${flag}"
    return 0
  fi

  local value
  if (( $(jq '.options // [] | length' <<< "${spec}") > 0 )); then
    if ! value="$(jq -r '.options[]' <<< "${spec}" | tmux_oneshot::_fzf --prompt "${flag}> ")"; then
      log::warn "No value picked; skipping flag | flag='${flag}'"
      return 1
    fi
  else
    value="$(tmux_oneshot::_read_value "${flag}")"
    if [[ -z "${value}" ]]; then
      log::warn "Empty value; skipping flag | flag='${flag}'"
      return 1
    fi
  fi

  tmux_oneshot::_render_kv "${flag}" "$(jq -r '.style // "space"' <<< "${spec}")" "${value}"
}

# Input: entry JSON object
# Output: the assembled command string. Interactive: flag multiselect (esc =
# no flags), kv value prompts, subcommand pick (esc = abort). Recurses
# through subcommands.
function tmux_oneshot::_assemble() {
  local entry="${1:?}"
  # Declared once: zsh's `local` on an already-local name prints var=value,
  # which would leak into this function's captured stdout.
  local out menu picked line idx rendered sub
  out="$(jq -r '.cmd // ""' <<< "${entry}")"

  if (( $(jq '.flags // [] | length' <<< "${entry}") > 0 )); then
    menu="$(jq -r '.flags | to_entries[]
      | "\(.key)\t\(.value.flag)\(if .value.description then "  # " + .value.description else "" end)"' \
      <<< "${entry}")"
    picked="$(tmux_oneshot::_fzf --multi --delimiter '\t' --with-nth '2..' \
      --prompt "flags [${out}]> " \
      --header 'tab: toggle several, enter: accept, esc: no flags' <<< "${menu}")"
    for line in ${(f)picked}; do
      idx="${line%%$'\t'*}"
      rendered="$(tmux_oneshot::_flag "$(jq --argjson i "${idx}" '.flags[$i]' <<< "${entry}")")" || continue
      out+=" ${rendered}"
    done
  fi

  if (( $(jq '.subcommands // [] | length' <<< "${entry}") > 0 )); then
    menu="$(jq -r '.subcommands | to_entries[]
      | "\(.key)\t\(.value.cmd // "")\(if .value.description then "  # " + .value.description else "" end)"' \
      <<< "${entry}")"
    if ! picked="$(tmux_oneshot::_fzf --delimiter '\t' --with-nth '2..' \
      --prompt "subcommand [${out}]> " <<< "${menu}")"; then
      return 1
    fi
    idx="${picked%%$'\t'*}"
    sub="$(tmux_oneshot::_assemble "$(jq --argjson i "${idx}" '.subcommands[$i]' <<< "${entry}")")" || return 1
    out+=" ${sub}"
  fi

  echo "${out# }"
}

# Input: key
# Runs the entry: cd to .pwd (if set), assemble args interactively, eval
function tmux_oneshot::key::_handle_selection() {
  local key="${1:?}"
  local idx entry
  idx="$(tmux_oneshot::_index_or_die "${key}")" || return 1
  entry="$(jq --argjson i "${idx}" '.[$i]' "${TMUX_ONESHOT_DB}")"

  local dir
  dir="$(jq -r '.pwd // ""' <<< "${entry}")"
  if [[ -n "${dir}" ]]; then
    dir="${dir/#\~/${HOME}}"
    if ! cd "${dir}"; then
      log::err "Failed to cd | pwd='${dir}'"
      return 1
    fi
  fi

  local cmd
  if ! cmd="$(tmux_oneshot::_assemble "${entry}")"; then
    log::warn "Aborted | key='${key}'"
    return 1
  fi
  if [[ -z "${cmd// }" ]]; then
    log::err "Entry assembled to an empty command | key='${key}' db='${TMUX_ONESHOT_DB}'"
    return 1
  fi

  log::info "Running oneshot | cmd='${cmd}' pwd='${PWD}'"
  eval "${cmd}"
  local rc=$?
  if (( rc != 0 )); then
    log::err "Oneshot command failed | rc='${rc}'"
  elif [[ "$(jq -r '.autodismiss // false' <<< "${entry}")" == "true" ]]; then
    return 0
  fi
  tmux_oneshot::_hold_until_escape
  return "${rc}"
}

# Keep the popup open so command output stays readable; Esc closes it.
# Returns immediately when there is no tty (e.g. under tests).
function tmux_oneshot::_hold_until_escape() {
  local key
  print -u2 "\n── esc to close ──"
  while read -k 1 -s key < /dev/tty; do
    [[ "${key}" == $'\e' ]] && return 0
  done
  return 0
}

# Run the picker only when executed; the fzf preview sources this file just
# for the function definitions (ZSH_EVAL_CONTEXT ends in ":file" then).
if [[ "${ZSH_EVAL_CONTEXT}" == "toplevel" ]]; then
  tmux_oneshot "$@"
fi
