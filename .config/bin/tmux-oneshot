#!/usr/bin/env zsh
#
# tmux-oneshot — pick a oneshot command from a JSON database via fzf and run
# it. Bound to <Prefix>C-k (see ~/.config/tmux/plugin/macros.conf), which
# opens this in a tmux popup.
#
# The database is a JSON list. Minimal entry: {"cmd": "killall Dock"}. Full
# schema (everything but one of cmd/subcommands is optional):
#
#   cmd          command fragment
#   pwd          cd here first (honored at the top level only)
#   description  shown in menus after the cmd
#   autodismiss  true: close the popup as soon as the command succeeds.
#                Default false: hold the popup open (output stays readable)
#                until Esc. Failures always hold.
#   menu         menu-line override: {"name", "text"}, both optional. The
#                menu line is "<name>  <text>": name defaults to cmd, padded
#                to a common column and truncated past 40 chars so lines
#                never wrap; text defaults to the auto-generated body (args
#                hint, description, pwd). menu.name doubles as the entry's
#                key (unnamed entries keep 1-based index keys), so it must
#                be unique.
#   flags        multiselected at run time (tab: toggle, esc: none)
#     flag         e.g. "--verbose", or an env var name like "ACTION"
#     type         "bool" (default: emits just the flag) or "kv"
#     style        kv only — how the value attaches:
#                  space (default): --flag value
#                  space-quoted:    --flag 'value'
#                  equals:          --flag=value
#                  equals-quoted:   --flag='value'
#     options      kv only — fzf through these; absent means type the value
#     description  shown in the flag menu
#   subcommands  list of nested entries (recursive: cmd/flags/subcommands/
#                description) — pick one, then its args resolve in turn
#
# Assembly order per level: cmd, then selected flags, then the chosen
# subcommand's assembly. The top-level menu shows only cmd/description plus a
# "…" hint when an entry has flags or subcommands — never the options.
#
# Drives fzf directly: the whole menu is ONE jq pass emitting
# "<0-based idx>\t<line>" with the index column hidden (--with-nth 2..), so
# selection recovery is a parameter strip and the preview is one jq on the
# picked index. The ZSH_EVAL_CONTEXT guard at the bottom keeps sourcing
# (tests, which stub the _fzf/_read_value/_hold_until_escape seams) from
# running the picker.

source "${HOME}/.config/zsh/plugins/log.zsh"

# Exported so the fzf preview shell resolves the same database.
export TMUX_ONESHOT_DB="${TMUX_ONESHOT_DB:-${XDG_DATA_HOME:-${HOME}/.local/share}/tmux_oneshot/commands.json}"

function tmux_oneshot() {
  local dep
  for dep in jq fzf; do
    if ! command -v "${dep}" &>/dev/null; then
      log::err "Required command not found | cmd='${dep}'"
      return 1
    fi
  done

  if [[ ! -e "${TMUX_ONESHOT_DB}" ]]; then
    mkdir -p "${TMUX_ONESHOT_DB:h}"
    cat > "${TMUX_ONESHOT_DB}" << 'EOF'
[
  {"cmd": "killall NotificationCenter", "autodismiss": true},
  {"pwd": "~", "cmd": "echo 'hello from tmux-oneshot'",
   "menu": {"name": "hello", "text": "demo entry — edit me: tmux-oneshot --edit"}}
]
EOF
    log::info "Seeded oneshot database | path='${TMUX_ONESHOT_DB}'"
  fi

  if ! jq -e 'type == "array"' "${TMUX_ONESHOT_DB}" &>/dev/null; then
    log::err "Database is not a JSON list | path='${TMUX_ONESHOT_DB}'"
    return 1
  fi

  local -a fzf_args
  case "${1:-}" in
    -h|--help)  tmux_oneshot::action::help; return 0;;
    --list)     tmux_oneshot::action::list; return $?;;
    --edit)     tmux_oneshot::action::edit; return $?;;
    --debug)    tmux_oneshot::action::debug; return $?;;
    -q|--query) fzf_args=(--query "${2:?-q requires a value}"); shift 2;;
    -*)
      log::err "Unknown option | option='${1}'"
      return 1
      ;;
  esac

  if (( $# > 0 )); then
    local idx
    idx="$(tmux_oneshot::_index_or_die "${1}")" || return 1
    tmux_oneshot::_run "${idx}"
    return $?
  fi

  tmux_oneshot::_pick "${fzf_args[@]}"
}

function tmux_oneshot::action::help() {
  echo -e "$(cat << EOF
USAGE: tmux-oneshot [key]        # run an entry by menu.name or 1-based index
       tmux-oneshot -q <query>   # open the picker with a prefilled query
       tmux-oneshot --list       # print the keys, one per line
       tmux-oneshot --edit       # open the database in \$EDITOR
       tmux-oneshot --debug      # non-interactive: render + index + preview checks
       tmux-oneshot --log        # print the per-run stderr log (popup errors land here)

Pick a oneshot command from the JSON database and run it. Selecting an entry
cds to its pwd (if set), interactively resolves its flags/subcommands (if
any), then evals the assembled command. The entry schema is documented at
the top of this script.

Database: ${c_grey}${TMUX_ONESHOT_DB}${c_rst} (override with TMUX_ONESHOT_DB)
EOF
)"
}

# The one home for the keying rule: an entry's key is its menu.name, else
# its 1-based index. Interpolated into every jq program that keys entries.
TMUX_ONESHOT_JQ_KEYDEF='def entrykey: .value.menu.name // ((.key + 1) | tostring);'

# Input: none
# Output: one key per line — menu.name when set, else the 1-based index
function tmux_oneshot::action::list() {
  jq -r "${TMUX_ONESHOT_JQ_KEYDEF} to_entries[] | entrykey" "${TMUX_ONESHOT_DB}"
}

function tmux_oneshot::action::edit() {
  "${EDITOR:-vim}" "${TMUX_ONESHOT_DB}"
}

# Input: key (a menu.name, or a 1-based index for unnamed entries)
# Output: the entry's 0-based index; errors cleanly on an unknown key so no
# caller ever hands an empty string to jq --argjson.
function tmux_oneshot::_index_or_die() {
  local key="${1:?}"
  local idx
  idx="$(jq -r --arg k "${key}" \
    "${TMUX_ONESHOT_JQ_KEYDEF} to_entries | map(select(entrykey == \$k)) | .[0].key // empty" \
    "${TMUX_ONESHOT_DB}")"
  if [[ -z "${idx}" ]]; then
    log::err "Unknown key | key='${key}' db='${TMUX_ONESHOT_DB}'"
    return 1
  fi
  echo "${idx}"
}

# The display-name column width cap: long cmds never push the menu line into
# wrapping territory. Not readonly — this file is sourced by tests.
: "${TMUX_ONESHOT_NAME_MAX:=40}"

# Output: the whole menu in ONE jq pass, one row per entry:
# "<0-based idx>\t<name>[<padding>  <text>]". name = menu.name // cmd,
# truncated to the column cap and padded to the (capped) column width; text =
# menu.text, else the auto body (cmd is included there only when a menu.name
# displaced it). The idx field is hidden by fzf (--with-nth 2..).
function tmux_oneshot::_menu() {
  jq -r --argjson cap "${TMUX_ONESHOT_NAME_MAX}" '
    ([.[] | (.menu.name // .cmd // "?") | length] | (max // 1)
      | if . > $cap then $cap else . end) as $w
    | to_entries[] | .value as $e
    | (($e.menu.name // $e.cmd // "?") | if length > $w then .[:$w-1] + "…" else . end) as $name
    | (($e.menu.text
        // ((if $e.menu.name then ($e.cmd // "") else "" end)
          + (if (($e.flags // []) + ($e.subcommands // []) | length) > 0 then " …" else "" end)
          + (if $e.description then "  # " + $e.description else "" end)
          + (if $e.pwd then " @ " + $e.pwd else "" end)))
       | ltrimstr(" ")) as $text
    | "\(.key)\t" + (if $text == "" then $name
       else $name + (" " * ($w - ($name | length) + 2)) + $text end)' \
    "${TMUX_ONESHOT_DB}"
}

# Interactive top-level picker. Args pass through to fzf (e.g. --query).
function tmux_oneshot::_pick() {
  local menu picked
  menu="$(tmux_oneshot::_menu)"
  if [[ -z "${menu}" ]]; then
    log::err "No entries in database | db='${TMUX_ONESHOT_DB}'"
    return 1
  fi
  if ! picked="$(tmux_oneshot::_fzf --select-1 "$@" \
      --delimiter $'\t' --with-nth '2..' \
      --preview "jq --argjson i {1} '.[\$i]' ${(qq)TMUX_ONESHOT_DB}" \
      --preview-window=up:3:wrap <<< "${menu}")"; then
    log::warn "No entry selected"
    return 1
  fi
  tmux_oneshot::_run "${picked%%$'\t'*}"
}

# Non-interactive diagnostic: exercises every popup code path except the fzf
# UI itself — the batch menu render, the hidden index column, and the exact
# preview jq fzf would run per row. For agents/humans without a tty.
function tmux_oneshot::action::debug() {
  local rc=0 menu line idx
  local -i row=0 entries
  entries="$(jq 'length' "${TMUX_ONESHOT_DB}")"
  if ! menu="$(tmux_oneshot::_menu)"; then
    log::err "Menu render failed | db='${TMUX_ONESHOT_DB}'"
    return 1
  fi
  log::info "Debug render | db='${TMUX_ONESHOT_DB}' entries='${entries}'"
  for line in ${(f)menu}; do
    idx="${line%%$'\t'*}"
    print -r -- "  ${line#*$'\t'}"
    if [[ "${idx}" != "${row}" ]]; then
      log::err "Hidden index out of order | expected='${row}' got='${idx}'"
      rc=1
    fi
    if ! jq -e --argjson i "${idx}" '.[$i]' "${TMUX_ONESHOT_DB}" > /dev/null; then
      log::err "Preview jq failed | idx='${idx}'"
      rc=1
    fi
    (( row++ ))
  done
  if (( row != entries )); then
    log::err "Menu row count mismatch | rows='${row}' entries='${entries}'"
    rc=1
  fi
  (( rc == 0 )) && log::info "Debug render clean | entries='${entries}'"
  return ${rc}
}

# Seams: tests stub these to drive the interactive paths headlessly.
function tmux_oneshot::_fzf() {
  fzf "$@"
}
function tmux_oneshot::_read_value() {
  local value
  read -r "value?${1:?} value: " < /dev/tty
  echo "${value}"
}

# Pure renderer. Input: <flag> <style> <value>. Output: the flag text.
function tmux_oneshot::_render_kv() {
  local flag="${1:?}" style="${2:?}" value="${3?}"
  case "${style}" in
    space)         echo "${flag} ${value}";;
    space-quoted)  echo "${flag} ${(qq)value}";;
    equals)        echo "${flag}=${value}";;
    equals-quoted) echo "${flag}=${(qq)value}";;
    *)
      log::err "Unknown flag style | style='${style}' flag='${flag}'"
      return 1
      ;;
  esac
}

# Input: one flag spec (JSON object)
# Output: the rendered flag text. Non-zero means skip this flag.
function tmux_oneshot::_flag() {
  local spec="${1:?}"
  local flag type
  flag="$(jq -r '.flag' <<< "${spec}")"
  type="$(jq -r '.type // "bool"' <<< "${spec}")"
  if [[ "${type}" == "bool" ]]; then
    echo "${flag}"
    return 0
  fi

  local value
  if (( $(jq '.options // [] | length' <<< "${spec}") > 0 )); then
    if ! value="$(jq -r '.options[]' <<< "${spec}" | tmux_oneshot::_fzf --prompt "${flag}> ")"; then
      log::warn "No value picked; skipping flag | flag='${flag}'"
      return 1
    fi
  else
    value="$(tmux_oneshot::_read_value "${flag}")"
    if [[ -z "${value}" ]]; then
      log::warn "Empty value; skipping flag | flag='${flag}'"
      return 1
    fi
  fi

  tmux_oneshot::_render_kv "${flag}" "$(jq -r '.style // "space"' <<< "${spec}")" "${value}"
}

# Input: entry JSON object
# Output: the assembled command string. Interactive: flag multiselect (esc =
# no flags), kv value prompts, subcommand pick (esc = abort). Recurses
# through subcommands.
function tmux_oneshot::_assemble() {
  local entry="${1:?}"
  # Declared once: zsh's `local` on an already-local name prints var=value,
  # which would leak into this function's captured stdout.
  local out menu picked line idx rendered sub
  out="$(jq -r '.cmd // ""' <<< "${entry}")"

  if (( $(jq '.flags // [] | length' <<< "${entry}") > 0 )); then
    menu="$(jq -r '.flags | to_entries[]
      | "\(.key)\t\(.value.flag)\(if .value.description then "  # " + .value.description else "" end)"' \
      <<< "${entry}")"
    picked="$(tmux_oneshot::_fzf --multi --delimiter '\t' --with-nth '2..' \
      --prompt "flags [${out}]> " \
      --header 'tab: toggle several, enter: accept, esc: no flags' <<< "${menu}")"
    for line in ${(f)picked}; do
      idx="${line%%$'\t'*}"
      rendered="$(tmux_oneshot::_flag "$(jq --argjson i "${idx}" '.flags[$i]' <<< "${entry}")")" || continue
      out+=" ${rendered}"
    done
  fi

  if (( $(jq '.subcommands // [] | length' <<< "${entry}") > 0 )); then
    menu="$(jq -r '.subcommands | to_entries[]
      | "\(.key)\t\(.value.cmd // "")\(if .value.description then "  # " + .value.description else "" end)"' \
      <<< "${entry}")"
    if ! picked="$(tmux_oneshot::_fzf --delimiter '\t' --with-nth '2..' \
      --prompt "subcommand [${out}]> " <<< "${menu}")"; then
      return 1
    fi
    idx="${picked%%$'\t'*}"
    sub="$(tmux_oneshot::_assemble "$(jq --argjson i "${idx}" '.subcommands[$i]' <<< "${entry}")")" || return 1
    out+=" ${sub}"
  fi

  echo "${out# }"
}

# Input: the entry's 0-based index
# Runs the entry: cd to .pwd (if set), assemble args interactively, eval
function tmux_oneshot::_run() {
  local idx="${1:?}"
  local entry
  entry="$(jq --argjson i "${idx}" '.[$i]' "${TMUX_ONESHOT_DB}")"

  local dir
  dir="$(jq -r '.pwd // ""' <<< "${entry}")"
  if [[ -n "${dir}" ]]; then
    dir="${dir/#\~/${HOME}}"
    if ! cd "${dir}"; then
      log::err "Failed to cd | pwd='${dir}'"
      return 1
    fi
  fi

  local cmd
  if ! cmd="$(tmux_oneshot::_assemble "${entry}")"; then
    log::warn "Aborted | idx='${idx}'"
    return 1
  fi
  if [[ -z "${cmd// }" ]]; then
    log::err "Entry assembled to an empty command | idx='${idx}' db='${TMUX_ONESHOT_DB}'"
    return 1
  fi

  log::info "Running oneshot | cmd='${cmd}' pwd='${PWD}'"
  eval "${cmd}"
  local rc=$?
  if (( rc != 0 )); then
    log::err "Oneshot command failed | rc='${rc}'"
  elif [[ "$(jq -r '.autodismiss // false' <<< "${entry}")" == "true" ]]; then
    return 0
  fi
  tmux_oneshot::_hold_until_escape
  return "${rc}"
}

# Keep the popup open so command output stays readable; Esc closes it.
# Returns immediately when there is no tty (e.g. under tests).
function tmux_oneshot::_hold_until_escape() {
  local key
  print -u2 "\n── esc to close ──"
  while read -k 1 -s key < /dev/tty; do
    [[ "${key}" == $'\e' ]] && return 0
  done
  return 0
}

# Run the picker only when executed; the fzf preview and tests source this
# file just for the function definitions (ZSH_EVAL_CONTEXT ends ":file" then).
#
# Every run persists its stderr to $TMUX_ONESHOT_LOG (tee keeps it visible
# live), so popup errors survive the popup closing. One log per run;
# log_rotate keeps the previous 4 aside as .bak.N. Read with: tmux-oneshot --log
# Caveat: an eval'd entry that backgrounds a child keeps the popup open until
# that child closes its inherited stderr — background with &>/dev/null.
if [[ "${ZSH_EVAL_CONTEXT}" == "toplevel" ]]; then
  : "${TMUX_ONESHOT_LOG:=${XDG_STATE_HOME:-${HOME}/.local/state}/tmux_oneshot/log.txt}"

  # --log reads; it must not rotate away the log it came to read.
  if [[ "${1:-}" == "--log" ]]; then
    print -r -- "── ${TMUX_ONESHOT_LOG}"
    [[ -f "${TMUX_ONESHOT_LOG}" ]] && cat "${TMUX_ONESHOT_LOG}"
    ls "${TMUX_ONESHOT_LOG}".bak.* 2>/dev/null
    exit 0
  fi

  source "${HOME}/.config/zsh/plugins/log_rotate.zsh"
  mkdir -p "${TMUX_ONESHOT_LOG:h}"
  log_rotate "${TMUX_ONESHOT_LOG}" 4
  print -r -- "── $(date -u +%Y-%m-%dT%H:%M:%SZ) tmux-oneshot $* (pid $$)" >> "${TMUX_ONESHOT_LOG}"
  # stderr → tee (log + live tty), stdout untouched via fd 3. tee as a
  # pipeline member (not a >(…) procsubst) so the shell waits for it and the
  # log is complete at exit — zsh does not track procsubst pids.
  # The rc travels via a file: zsh's pipestatus misreports when the first
  # pipeline member carries fd redirections (observed [0,0] for a failing
  # function).
  _tmux_oneshot_rcf="${TMUX_ONESHOT_LOG}.rc"
  { { tmux_oneshot "$@" 2>&1 >&3; print -rn -- "$?" > "${_tmux_oneshot_rcf}" } \
    | tee -a "${TMUX_ONESHOT_LOG}" >&2 } 3>&1
  _tmux_oneshot_rc="$(cat "${_tmux_oneshot_rcf}" 2>/dev/null)"
  rm -f "${_tmux_oneshot_rcf}"
  : "${_tmux_oneshot_rc:=1}"
  print -r -- "── exit rc=${_tmux_oneshot_rc}" >> "${TMUX_ONESHOT_LOG}"
  exit "${_tmux_oneshot_rc}"
fi
