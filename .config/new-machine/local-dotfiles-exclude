# Allowlist for the per-machine local-dotfiles repo (~/.local/local-dotfiles.git).
# new-machine setup installs this as info/exclude on a fresh machine; a machine
# that has edited its copy keeps it. Only hand-written local config is tracked;
# tool-managed data, state, and caches under ~/.local never are.
/*
!/bin/
!/share/
/share/*
!/share/bin/
!/share/zsh/
/share/zsh/history*
!/share/git/
!/share/go_aws/
!/share/kuber/
!/share/aws_profile/
!/share/tmux/
/share/tmux/*
!/share/tmux/local-plugins/
!/share/tmux_oneshot/
!/share/double_cd/
!/share/new-machine/
!/share/claude-skills/
# Secrets live in *.secret.zsh beside the plugin that needs them; never tracked.
*.secret.zsh
# Symlinks into tool-managed installs (claude version dir, pipx venv).
/bin/claude
/bin/pyairtable
