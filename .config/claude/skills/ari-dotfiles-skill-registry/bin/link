#!/usr/bin/env zsh
# Symlink every skill held by a dotfiles tier into $HOME/.claude/skills. Idempotent;
# never clobbers a real directory or a symlink that points elsewhere.
# Run: zsh $HOME/.claude/skills/ari-dotfiles-skill-registry/bin/link [--prune] [--dry-run]

set -euo pipefail

readonly SCRIPT_DIR="${0:A:h}"
# Shared libs resolve through the symlink farm, not ${SCRIPT_DIR:h:h}: skills are
# spread across tiers, so a relative hop lands in whichever tier this script sits in.
readonly SKILLS_DIR="${HOME}/.claude/skills"

LIB_LOGGING="${SKILLS_DIR}/ari-skill-shellscripts/lib/logging.zsh"
# Bootstrap: before link has run on a machine the farm is empty, and the only reachable copy
# is the sibling in this tier root (ari-skill-shellscripts is shared-tier too).
[[ -r "${LIB_LOGGING}" ]] || LIB_LOGGING="${SCRIPT_DIR:h:h}/ari-skill-shellscripts/lib/logging.zsh"
readonly LIB_LOGGING
if [[ ! -r "${LIB_LOGGING}" ]]; then
  print -u2 "[ERROR] missing shared logging lib | path='${LIB_LOGGING}'"
  exit 1
fi
source "${LIB_LOGGING}"
LIB_DRY_RUN="${SKILLS_DIR}/ari-skill-shellscripts/lib/dry_run.zsh"
[[ -r "${LIB_DRY_RUN}" ]] || LIB_DRY_RUN="${SCRIPT_DIR:h:h}/ari-skill-shellscripts/lib/dry_run.zsh"
readonly LIB_DRY_RUN
if [[ ! -r "${LIB_DRY_RUN}" ]]; then
  print -u2 "[ERROR] missing shared dry-run lib | path='${LIB_DRY_RUN}'"
  exit 1
fi
source "${LIB_DRY_RUN}"
source "${SCRIPT_DIR:h}/lib/registry.zsh"
readonly SCRIPT_PATH="${0:a}"

help() {
  cat <<EOF
${c_green}link${c_rst} — symlink tier-held skills into \$HOME/.claude/skills (new-machine step; safe to rerun)

${c_bold}Usage:${c_rst}
  zsh \$HOME/.claude/skills/ari-dotfiles-skill-registry/bin/link [--prune] [--execute] [--dry-run]

${c_bold}Options:${c_rst}
  --prune     Also remove symlinks in \$HOME/.claude/skills whose target no longer exists
  --execute   Act. Without it the run is a dry run: it logs what would change and touches nothing
  --dry-run   The default made explicit; wins over --execute and exports DRY_RUN=1
  -h, --help  Show this help

Only skills in state ${c_bold}missing${c_rst} get a link. ${c_bold}shadowed${c_rst}, ${c_bold}foreign${c_rst}, and
${c_bold}conflict${c_rst} rows are reported and left alone; fix those with bin/status in hand.

${c_bold}Environment:${c_rst}
  DRY_RUN     Set and not 0 (a parent's dry run): a dry run, --execute or not; 0 alone never acts
EOF
}

#######################################
# Create the symlink for one missing skill.
# Arguments:
#   $1 - skill name
#   $2 - tier
#######################################
link_skill() {
  local skill="${1}" tier="${2}"
  local target="$(skill_holder_root "${tier}" "${skill}")/${skill}"
  local link="${SKILLS_DIR}/${skill}"
  run_mut ln -s "${target}" "${link}"
}

#######################################
# Remove one dangling symlink.
# Arguments:
#   $1 - skill name
#######################################
prune_skill() {
  local skill="${1}"
  local link="${SKILLS_DIR}/${skill}"
  run_mut rm "${link}"
}

main() {
  # === PARSE ===
  local prune=false execute=false dry_run=false
  while (( $# > 0 )); do case "${1}" in
    -h|--help) help; return 0 ;;
    --prune)   prune=true; shift ;;
    --execute) execute=true; shift ;;
    --dry-run) dry_run=true; shift ;;
    -*)        log::err "Unknown flag | flag='${1}'"; help; return 1 ;;
    *)         log::err "Unexpected argument | argument='${1}'"; help; return 1 ;;
  esac; done

  resolve_dry_run "${execute}" "${dry_run}"

  # === LOGIC ===
  [[ -d "${SKILLS_DIR}" ]] || run_mut mkdir -p "${SKILLS_DIR}"
  local skill state tier
  local linked=0 pruned=0 skipped=0
  local -a all_skills=("${(@f)$(list_all_skills)}")
  all_skills=("${(@)all_skills:#}")
  for skill in "${all_skills[@]}"; do
    skill_state "${skill}" >/dev/null   # leaves '<state> <tier>' in REPLY; no subshell per skill
    state="${REPLY%% *}"
    tier="${REPLY#* }"
    case "${state}" in
      missing)
        link_skill "${skill}" "${tier}"
        linked=$(( linked + 1 ))
        ;;
      dangling)
        if [[ "${prune}" != "true" ]]; then
          log::warn "dangling link left in place | skill='${skill}' hint='--prune removes it'"
          skipped=$(( skipped + 1 ))
          continue
        fi
        prune_skill "${skill}"
        pruned=$(( pruned + 1 ))
        ;;
      shadowed|foreign|conflict)
        log::warn "needs a hand | skill='${skill}' state='${state}' tier='${tier}'"
        skipped=$(( skipped + 1 ))
        ;;
    esac
  done

  log::info "link done | linked='${linked}' pruned='${pruned}' skipped='${skipped}' dry_run='${DRY_RUN}'"
  cat <<EOF
linked=${linked}
pruned=${pruned}
skipped=${skipped}
dry_run=${DRY_RUN}
EOF
  report_dry_run "${SCRIPT_PATH}" "$@"
}

main "${@}"
