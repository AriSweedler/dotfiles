#!/usr/bin/env zsh
# Move a skill from $HOME/.claude/skills into a dotfiles tier, symlink it back, and
# stage it in that tier's repo; on a machine moved onto the local-dotfiles clone, a
# local-tier adoption then runs ldf-link so ~/.local gets the skill's links.
# Committing is the caller's job so the message can say why. Run: zsh $HOME/.claude/skills/ari-dotfiles-skill-registry/bin/adopt --skill <name> --tier df|ldf

set -euo pipefail

readonly SCRIPT_DIR="${0:A:h}"
# Shared libs resolve through the symlink farm, not ${SCRIPT_DIR:h:h}: skills are
# spread across tiers, so a relative hop lands in whichever tier this script sits in.
readonly SKILLS_DIR="${HOME}/.claude/skills"

LIB_LOGGING="${SKILLS_DIR}/ari-skill-shellscripts/lib/logging.zsh"
# Bootstrap: before link has run on a machine the farm is empty, and the only reachable copy
# is the sibling in this tier root (ari-skill-shellscripts is shared-tier too).
[[ -r "${LIB_LOGGING}" ]] || LIB_LOGGING="${SCRIPT_DIR:h:h}/ari-skill-shellscripts/lib/logging.zsh"
readonly LIB_LOGGING
if [[ ! -r "${LIB_LOGGING}" ]]; then
  print -u2 "[ERROR] missing shared logging lib | path='${LIB_LOGGING}'"
  exit 1
fi
source "${LIB_LOGGING}"
LIB_DRY_RUN="${SKILLS_DIR}/ari-skill-shellscripts/lib/dry_run.zsh"
[[ -r "${LIB_DRY_RUN}" ]] || LIB_DRY_RUN="${SCRIPT_DIR:h:h}/ari-skill-shellscripts/lib/dry_run.zsh"
readonly LIB_DRY_RUN
if [[ ! -r "${LIB_DRY_RUN}" ]]; then
  print -u2 "[ERROR] missing shared dry-run lib | path='${LIB_DRY_RUN}'"
  exit 1
fi
source "${LIB_DRY_RUN}"
source "${SCRIPT_DIR:h}/lib/registry.zsh"
readonly SCRIPT_PATH="${0:a}"

help() {
  cat <<EOF
${c_green}adopt${c_rst} — move a skill into a dotfiles tier, symlink it back, stage it (does not commit)

${c_bold}Usage:${c_rst}
  zsh \$HOME/.claude/skills/ari-dotfiles-skill-registry/bin/adopt --skill NAME [--skill NAME]... --tier df|ldf [--as NEW_NAME] [--execute] [--dry-run]

${c_bold}Options:${c_rst}
  --skill NAME   Skill directory under \$HOME/.claude/skills to adopt (repeatable)
  --tier TIER    df (shared, ~/.config/claude/skills) or ldf (local: ~/local-dotfiles/local/<machine>/share/claude-skills
                 when that clone exists, else ~/.local/share/claude-skills)
  --as NEW_NAME  Adopt under a new directory name; allowed with exactly one --skill.
                 The SKILL.md \`name:\` line and every caller still say the old name: fix them
                 in the same commit (\`rg -L -n '<old>' \$HOME/.claude/skills\`).
  --execute      Act. Without it the run is a dry run: it logs what would change and touches nothing
  --dry-run      The default made explicit; wins over --execute and exports DRY_RUN=1
  -h, --help     Show this help

Every skill is checked before any moves. Each must be in state ${c_bold}unlinked${c_rst} (or ${c_bold}ignored${c_rst} via .gitignore: naming it is the
override) and must contain a SKILL.md; a directory without one is not a skill and is refused. A skill
already ${c_bold}linked${c_rst} to the requested tier is a no-op. On a clone machine (~/local-dotfiles/.git) a
local adoption refuses a machine name the clone's machines file lacks, then runs ldf-link (its
preview in a dry run), which updates every local-tier link on the machine. Ends with key=value lines
per skill and the commit the caller should make.

${c_bold}Environment:${c_rst}
  DRY_RUN        Set and not 0 (a parent's dry run): a dry run, --execute or not; 0 alone never acts
EOF
}

#######################################
# True (0) if the tier's repo would track a path under its root: no ignore rule
# (on the bare ldf repo, its info/exclude allowlist) covers it.
# Arguments:
#   $1 - tier
#   $2 - path that will exist after the move
#######################################
tier_tracks_path() {
  # Not `path`: in zsh that is the array tied to PATH, and a local one empties it.
  local tier="${1}" probe_path="${2}" rc=0
  tier_git "${tier}" check-ignore -q --no-index "${probe_path}" 2>/dev/null || rc=$?
  (( rc == 1 ))
}

#######################################
# True (0) if the tier's repo answers git; logs the failure otherwise, so a
# missing alias or repo is refused before anything moves.
# Arguments:
#   $1 - tier
#######################################
tier_reachable() {
  local tier="${1}" out
  if ! out="$(tier_git "${tier}" rev-parse --git-dir 2>&1)"; then
    log::err "tier repo unreachable | tier='${tier}' error='${out%%$'\n'*}' hint='git ${tier} must work (/ari-dotfiles)'"
    return 1
  fi
}

#######################################
# Print the fix for a tier that ignores its skills root: the bare ldf repo's
# allowlist entry, else the rule `git check-ignore -v` names
# (<file>:<line>:<pattern>), which must stop covering the skills root.
# Arguments:
#   $1 - tier
#   $2 - destination directory
#######################################
ignore_hint() {
  local tier="${1}" dest_dir="${2}"
  if [[ "${tier}" == ldf && "${LDF_CLONE}" != true ]]; then
    echo "add !/share/claude-skills/ to the ldf allowlist (info/exclude)"
    return 0
  fi
  local rule root_rel="${$(tier_root "${tier}")#${TIER_WORKTREES[${tier}]}/}"
  rule="$(tier_git "${tier}" check-ignore -v --no-index "${dest_dir}/SKILL.md" 2>/dev/null)" || true
  rule="${rule%%$'\t'*}"
  echo "make /${root_rel}/ tracked: the rule ${rule:-git check-ignore -v names} ignores it"
}

#######################################
# Print the ldf-link command: ~/.config/bin's, else the one on PATH, else nothing.
#######################################
ldf_link_bin() {
  if [[ -x "${HOME}/.config/bin/ldf-link" ]]; then
    echo "${HOME}/.config/bin/ldf-link"
    return 0
  fi
  whence -p ldf-link || true
}

#######################################
# On a clone machine, run ldf-link so ~/.local/share/claude-skills/<name> gets
# each adopted skill's links; a dry run shows ldf-link's own preview. It is
# told the clone and machine this run used, so both agree. A missing ldf-link,
# or an adopted skill it did not link, only warns: each skill is already
# adopted, linked to the clone's directory, and staged.
# Arguments:
#   $1 - tier
#   $@ - adopted destination names
#######################################
assemble_local() {
  local tier="${1}"; shift
  [[ "${tier}" == ldf && "${LDF_CLONE}" == true ]] || return 0
  local bin dest
  bin="$(ldf_link_bin)"
  if [[ -z "${bin}" ]]; then
    log::warn "ldf-link not found; ~/.local lacks the skills' links | fix='ldf-link --execute'"
    return 0
  fi
  local -a cmd=(env LDF_REPO="${LDF_WORKTREE}" LDF_TARGET="${HOME}/.local" ARI_DOTFILES_MACHINE="${LDF_MACHINE}" "${bin}")
  # Its per-path lines go to stderr: stdout holds adopt's key=value rows.
  if is_dry_run; then
    log::info "ldf-link preview (it runs with --execute on --execute) | cmd=${(j: :)${(q-)cmd}}"
    "${cmd[@]}" >&2 || true
    return 0
  fi
  run_mut "${cmd[@]}" --execute >&2 || true
  for dest in "$@"; do
    [[ "${LDF_ASSEMBLED_ROOT}/${dest}/SKILL.md" -ef "${LDF_ROOT}/${dest}/SKILL.md" ]] && continue
    log::warn "ldf-link did not link the skill into ~/.local | skill='${dest}' fix='ldf-link (a dry run) names what it refused; settle it per /ari-dotfiles, then ldf-link --execute'"
  done
}

#######################################
# Decide whether one skill can be adopted into the tier. Prints nothing; logs the
# reason and returns 1 when it cannot. Returns 2 when it is already adopted there.
# Arguments:
#   $1 - skill name
#   $2 - tier
#   $3 - destination name
#######################################
check_adoptable() {
  local skill="${1}" tier="${2}" dest="${3}"
  local state cur_tier
  read -r state cur_tier <<< "$(skill_state "${skill}")"
  local dest_dir="$(tier_root "${tier}")/${dest}"

  if [[ "${state}" == "linked" && "${cur_tier}" == "${tier}" && "${skill}" == "${dest}" ]]; then
    log::info "already adopted | skill='${skill}' tier='${tier}'"
    return 2
  fi
  if [[ -d "${SKILLS_DIR}/${skill}" ]] && ! is_skill_dir "${skill}"; then
    log::err "not a skill | skill='${skill}' path='${SKILLS_DIR}/${skill}' expected='a directory containing SKILL.md'"
    return 1
  fi
  if [[ "${tier}" == ldf ]] && ! ldf_machine_known; then
    log::err "machine not in the clone's machines file | machine='${LDF_MACHINE}' machines='${LDF_WORKTREE}/machines' hint='set the name with dotfiles machine-name, or add the machine to the machines file'"
    return 1
  fi
  if [[ "${state}" != "unlinked" && "${state}" != "ignored" ]]; then
    log::err "not adoptable | skill='${skill}' state='${state}' tier='${cur_tier}' expected_state='unlinked'"
    return 1
  fi
  if [[ -e "${dest_dir}" ]]; then
    log::err "destination exists | skill='${skill}' dest_dir='${dest_dir}'"
    return 1
  fi
  if [[ -e "${SKILLS_DIR}/${dest}" && "${dest}" != "${skill}" ]]; then
    log::err "new name already taken | dest='${dest}' path='${SKILLS_DIR}/${dest}'"
    return 1
  fi
  if ! tier_tracks_path "${tier}" "${dest_dir}/SKILL.md"; then
    log::err "tier ignores the skills root | tier='${tier}' dest_dir='${dest_dir}' hint='$(ignore_hint "${tier}" "${dest_dir}")'"
    return 1
  fi
  return 0
}

#######################################
# Move, link, and stage one skill; a dry run logs each step.
# Arguments:
#   $1 - skill name
#   $2 - tier
#   $3 - destination name
########################################
adopt_skill() {
  local skill="${1}" tier="${2}" dest="${3}"
  local src="${SKILLS_DIR}/${skill}"
  local root="$(tier_root "${tier}")"
  local dest_dir="${root}/${dest}"
  local link="${SKILLS_DIR}/${dest}"

  run_mut mkdir -p "${root}"
  run_mut mv "${src}" "${dest_dir}"
  run_mut ln -s "${dest_dir}" "${link}"
  run_mut git "${tier}" add "${dest_dir}"
}

main() {
  local -a args=("$@")
  # === PARSE ===
  local tier="" as="" execute=false dry_run=false
  local -a skills
  while (( $# > 0 )); do case "${1}" in
    -h|--help) help; return 0 ;;
    --skill)   skills+=("${2:?--skill requires a value}"); shift 2 ;;
    --tier)    tier="${2:?--tier requires a value}"; shift 2 ;;
    --as)      as="${2:?--as requires a value}"; shift 2 ;;
    --execute) execute=true; shift ;;
    --dry-run) dry_run=true; shift ;;
    -*)        log::err "Unknown flag | flag='${1}'"; help; return 1 ;;
    *)         log::err "Unexpected argument | argument='${1}'"; help; return 1 ;;
  esac; done

  # === MASSAGE ===
  tier="${tier:l}"

  # === VALIDATE ===
  if (( ${#skills} == 0 )); then
    log::err "Missing --skill"; help; return 1
  fi
  if ! is_valid_tier "${tier}"; then
    log::err "Invalid --tier | tier='${tier}' valid_tiers='${(j:, :)TIERS}'"; help; return 1
  fi
  if [[ -n "${as}" && ${#skills} -ne 1 ]]; then
    log::err "--as needs exactly one --skill | skill_count='${#skills}'"; return 1
  fi

  resolve_dry_run "${execute}" "${dry_run}"

  # === LOGIC ===
  tier_reachable "${tier}" || return 1
  # Check every skill before moving any, so a refusal leaves the batch untouched.
  local skill dest rc refused=0 adopted=0
  local -a todo rows dests
  for skill in "${skills[@]}"; do
    rc=0
    check_adoptable "${skill}" "${tier}" "${as:-${skill}}" || rc=$?
    (( rc == 0 )) && todo+=("${skill}")
    (( rc == 1 )) && refused=$(( refused + 1 ))
  done
  if (( refused > 0 )); then
    log::err "nothing moved | refused='${refused}' skills='${(j:,:)skills}'"
    return 1
  fi
  for skill in "${todo[@]}"; do
    dest="${as:-${skill}}"
    adopt_skill "${skill}" "${tier}" "${dest}"
    rows+=("skill=${skill} tier=${tier} path=$(tier_root "${tier}")/${dest} link=${SKILLS_DIR}/${dest} dry_run=${DRY_RUN}")
    dests+=("${dest}")
    adopted=$(( adopted + 1 ))
  done
  (( adopted > 0 )) && assemble_local "${tier}" "${dests[@]}"

  log::info "adopt done | adopted='${adopted}' tier='${tier}' dry_run='${DRY_RUN}'"
  (( adopted > 0 )) && printf '%s\n' "${rows[@]}"
  if (( adopted > 0 )) && ! is_dry_run; then
    log::info "staged, not committed | next=\"git ${tier} commit -m 'claude: adopt the <name> skill into the ${tier} tier'\""
  fi
  report_dry_run "${SCRIPT_PATH}" "${args[@]}"
  return 0
}

main "${@}"
