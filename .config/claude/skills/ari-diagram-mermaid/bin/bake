#!/usr/bin/env zsh
#
# Bake a Mermaid diagram: gate its line-1 directive and contrast, confirm it renders,
# mint the embed URL, copy it to the clipboard, and write a sidecar so callers relay
# the exact bytes.
#
# Line 1 of the source pins the theme and carries a themeCSS text halo. The theme pin
# beats whatever theme a viewer's mermaid.live writes into the URL; the halo outlines
# free-standing text (sequence messages, box titles, lifeline captions) in white so it
# reads on the dark canvas mermaid.live's view page paints in dark mode. Every fill
# pairs with a text color that clears MIN_CONTRAST. The gates run before any network
# call.
set -euo pipefail

readonly SCRIPT_DIR="${0:A:h}"
readonly SKILLS_DIR="${HOME}/.claude/skills"
readonly LIB_LOGGING="${SKILLS_DIR}/ari-skill-shellscripts/lib/logging.zsh"
if [[ ! -r "${LIB_LOGGING}" ]]; then
  print -u2 "[ERROR] missing shared logging lib | path='${LIB_LOGGING}'"
  exit 1
fi
source "${LIB_LOGGING}"

readonly LIB_CONTRAST="${SCRIPT_DIR:h}/lib/contrast.awk"
readonly VALID_FORMATS=(markdown_link ink_url live_url)
readonly REQUIRED_THEME="default"
# The one line every diagram starts with. Whitespace-insensitive match on its two
# load-bearing parts: the theme pin and the paint-order halo.
readonly CANONICAL_DIRECTIVE="%%{init: {'theme':'default', 'themeCSS': '.messageText, text.text, text.actor, .loopText, .noteText, .labelText, .titleText { paint-order: stroke; stroke: #ffffff; stroke-width: 4px; stroke-linejoin: round; }'}}%%"
readonly MIN_CONTRAST="3.0"   # WCAG AA for large or bold text; node labels are bold
readonly DARK_CANVAS="1e1e1e" # mermaid.live's dark-mode view background, for --dark-check
readonly CURL_TIMEOUT="30"
readonly INK_BASE="https://mermaid.ink/img/base64:"
# /view renders the diagram alone; /edit would land a Docs reader in the editor. Same pako payload.
readonly LIVE_BASE="https://mermaid.live/view#pako:"

#######################################
# Fail when a required command is absent.
# Globals: none
# Arguments: none
# Returns: 1 if any are missing
#######################################
check_prerequisites() {
  local missing=()
  for cmd in node curl awk; do
    command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
  done
  if (( ${#missing} > 0 )); then
    log::err "Missing required commands | missing='${(j:, :)missing}'"
    return 1
  fi
  if [[ ! -r "${LIB_CONTRAST}" ]]; then
    log::err "Missing contrast lib | path='${LIB_CONTRAST}'"
    return 1
  fi
}

help() {
  cat <<EOF
${c_green}bake${c_rst} — gate a Mermaid diagram's directive and contrast, confirm it renders, and mint its embed link

${c_bold}Usage:${c_rst}
  zsh \$HOME/.claude/skills/ari-diagram-mermaid/bin/bake --file <diagram.mmd> [--format FORMAT] [--validate-only] [--dark-check]
  zsh \$HOME/.claude/skills/ari-diagram-mermaid/bin/bake <diagram.mmd>          (compatibility form)

${c_bold}Options:${c_rst}
  --file PATH       The .mmd source (a bare positional path is accepted for older callers)
  --format FORMAT   ${(j:, :)VALID_FORMATS} (default: markdown_link; MERMAID_FORMAT env is the fallback)
  --validate-only   Run the gates and the render check; mint no URL (MERMAID_VALIDATE_ONLY=1 is the fallback)
  --dark-check      Also save <name>.dark.jpg, the render on a #${DARK_CANVAS} canvas, for a legibility look
  -h, --help        Show this help

${c_bold}Gates:${c_rst}
  Line 1 of the source MUST be the canonical directive (theme pin plus text halo):
    ${CANONICAL_DIRECTIVE}
  Every classDef/style that sets fill MUST set color at a contrast ratio >= ${MIN_CONTRAST}:1.
  Violations print as line|directive|name|fill|color|ratio|reason and the bake stops.

${c_bold}Output:${c_rst}
  The link on stdout, copied to the clipboard when one exists, and written to <name>.<format>.url.
  Relay it verbatim; never retype it.
EOF
}

#######################################
# Fail unless line 1 is an init directive that pins the default theme and carries
# the text halo. Whitespace is ignored when matching the two required parts.
# Globals: REQUIRED_THEME, CANONICAL_DIRECTIVE
# Arguments: $1 = path to the .mmd
# Returns: 1 when line 1 is not an init directive, names another theme, or lacks the halo
#######################################
check_directive() {
  local file="${1}"
  if ! awk 'NR == 1 { exit ($0 ~ /^[ \t]*%%\{init/) ? 0 : 1 } END { if (NR == 0) exit 1 }' "${file}"; then
    log::err "No init directive on line 1 | file='${file}' expected_line_1=\"${CANONICAL_DIRECTIVE}\""
    return 1
  fi
  local first_line
  first_line="$(awk 'NR == 1 { print; exit }' "${file}")"
  local themes
  # Quote characters are passed in, so the regex is portable across BSD and GNU awk.
  themes="$(awk -v q="'" '
    BEGIN { re = "[\"" q "]theme[\"" q "][ \t]*:[ \t]*[\"" q "][^\"" q "]+[\"" q "]" }
    /^[ \t]*%%\{init/ && match($0, re) {
      t = substr($0, RSTART, RLENGTH)
      sub(/^.*:[ \t]*["'"'"']/, "", t); sub(/["'"'"']$/, "", t)
      print t
    }' "${file}")"
  if [[ -z "${themes}" ]]; then
    log::err "Directive pins no theme | file='${file}' expected_line_1=\"${CANONICAL_DIRECTIVE}\""
    return 1
  fi
  local theme
  for theme in ${(f)themes}; do
    if [[ "${theme}" != "${REQUIRED_THEME}" ]]; then
      log::err "Theme directive is not the pinned theme | theme='${theme}' expected='${REQUIRED_THEME}'"
      return 1
    fi
  done
  local squeezed="${first_line//[[:space:]]/}"
  if [[ "${squeezed}" != *themeCSS* || "${squeezed}" != *paint-order:stroke* ]]; then
    log::err "Directive lacks the text halo | file='${file}' expected_line_1=\"${CANONICAL_DIRECTIVE}\""
    return 1
  fi
  log::debug "Directive gate passed | theme='${REQUIRED_THEME}' halo='paint-order: stroke'"
}

#######################################
# Fail when any classDef/style pairs a fill with missing or low-contrast text.
# Globals: LIB_CONTRAST, MIN_CONTRAST
# Arguments: $1 = path to the .mmd
# Returns: 1 when there is at least one violation
#######################################
check_contrast() {
  local file="${1}"
  local violations
  violations="$(awk -v min_ratio="${MIN_CONTRAST}" -f "${LIB_CONTRAST}" "${file}")"
  if [[ -z "${violations}" ]]; then
    log::debug "Contrast gate passed | min_ratio='${MIN_CONTRAST}'"
    return 0
  fi
  log::err "Contrast gate failed | min_ratio='${MIN_CONTRAST}' format='line|directive|name|fill|color|ratio|reason'"
  log::ERR "${violations}"
  return 1
}

#######################################
# Encode the mermaid.live state as base64url JSON for mermaid.ink.
# Globals: REQUIRED_THEME
# Arguments: $1 = path to the .mmd
# Returns: the encoded state on stdout
#######################################
encode_state() {
  node -e "
const fs = require('fs');
const code = fs.readFileSync(process.argv[1], 'utf-8');
const state = JSON.stringify({code, mermaid: {theme: process.argv[2]}});
process.stdout.write(Buffer.from(state).toString('base64url'));
" "${1}" "${REQUIRED_THEME}"
}

#######################################
# Deflate the mermaid.live state as base64url for the pako: fragment.
# Globals: REQUIRED_THEME
# Arguments: $1 = path to the .mmd
# Returns: the compressed state on stdout
#######################################
pako_compress() {
  node -e "
const zlib = require('zlib');
const fs = require('fs');
const code = fs.readFileSync(process.argv[1], 'utf-8');
const state = JSON.stringify({code, mermaid: {theme: process.argv[2]}});
process.stdout.write(zlib.deflateSync(state, { level: 9 }).toString('base64url'));
" "${1}" "${REQUIRED_THEME}"
}

#######################################
# Fail unless mermaid.ink renders the image.
# Globals: CURL_TIMEOUT
# Arguments: $1 = mermaid.ink image URL
# Returns: 1 on a non-200 response
#######################################
check_renders() {
  local url="${1}"
  local http_code
  http_code="$(curl -s --max-time "${CURL_TIMEOUT}" -o /dev/null -w '%{http_code}' "${url}")"
  if [[ "${http_code}" != "200" ]]; then
    log::err "Invalid mermaid diagram | http_code='${http_code}' debug_url='${url}'"
    return 1
  fi
}

#######################################
# Save the render on a dark canvas next to the sidecars so the author can judge
# legibility the way a dark-mode mermaid.live viewer will see it.
# Globals: CURL_TIMEOUT, DARK_CANVAS
# Arguments: $1 = mermaid.ink image URL, $2 = path to the .mmd
# Returns: 1 on a non-200 response
#######################################
save_dark_check() {
  local url="${1}" file="${2}"
  local dark_file="${file%.mmd}.dark.jpg"
  local http_code
  http_code="$(curl -s --max-time "${CURL_TIMEOUT}" -o "${dark_file}" -w '%{http_code}' "${url}?bgColor=${DARK_CANVAS}")"
  if [[ "${http_code}" != "200" ]]; then
    log::err "Dark-canvas render failed | http_code='${http_code}' dark_file='${dark_file}'"
    return 1
  fi
  log::info "Dark-canvas render saved; look at it | dark_file='${dark_file}' canvas='#${DARK_CANVAS}'"
}

#######################################
# Compose the output for one format.
# Globals: none
# Arguments: $1 = format, $2 = image URL, $3 = live URL
# Returns: the output on stdout
#######################################
mint_output() {
  local format="${1}" url="${2}" live_url="${3}"
  if [[ "${format}" == "ink_url" ]]; then
    echo "${url}"
    return
  fi
  if [[ "${format}" == "live_url" ]]; then
    echo "${live_url}"
    return
  fi
  echo "[![](${url})](${live_url})"
}

copy_to_clipboard() {
  if command -v pbcopy >/dev/null 2>&1; then
    pbcopy
  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard 2>/dev/null
  elif command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --input 2>/dev/null
  else
    return 1
  fi
}

#######################################
# Deliver the output: clipboard when available, sidecar file always.
# Globals: none
# Arguments: $1 = output, $2 = format, $3 = sidecar path
# Returns: none
#######################################
deliver_output() {
  local output="${1}" format="${2}" url_file="${3}"
  if printf '%s' "${output}" | copy_to_clipboard; then
    log::info "Valid diagram — link copied to clipboard | format='${format}' url_file='${url_file}'"
    return
  fi
  log::info "Valid diagram — clipboard unavailable; link written to file | format='${format}' url_file='${url_file}'"
}

main() {
  check_prerequisites || exit 1

  # === PARSE ===
  local file="" format="${MERMAID_FORMAT:-markdown_link}" validate_only="false" dark_check="false"
  [[ "${MERMAID_VALIDATE_ONLY:-}" == "1" ]] && validate_only="true"

  while (( $# > 0 )); do case "${1}" in
    -h|--help)        help; return 0 ;;
    --file)           file="${2:?--file requires a value}"; shift 2 ;;
    --format)         format="${2:?--format requires a value}"; shift 2 ;;
    --validate-only)  validate_only="true"; shift ;;
    --dark-check)     dark_check="true"; shift ;;
    -*)               log::err "Unknown flag | flag='${1}'"; help; return 1 ;;
    *)
      if [[ -n "${file}" ]]; then
        log::err "Unexpected argument | argument='${1}'"; help; return 1
      fi
      file="${1}"; shift ;;
  esac; done

  # === MASSAGE ===
  format="${format:l}"

  # === VALIDATE ===
  if [[ -z "${file}" ]]; then
    log::err "No source given | expected='--file <diagram.mmd>'"; help; return 1
  fi
  if [[ ! -f "${file}" ]]; then
    log::err "File not found | file='${file}'"; return 1
  fi
  if (( ! ${VALID_FORMATS[(Ie)${format}]} )); then
    log::err "Unknown format | format='${format}' valid_formats='${(j:, :)VALID_FORMATS}'"; return 1
  fi
  check_directive "${file}" || return 1
  check_contrast "${file}" || return 1

  # === LOGIC ===
  local url
  url="${INK_BASE}$(encode_state "${file}")"
  check_renders "${url}" || return 1
  if [[ "${dark_check}" == "true" ]]; then
    save_dark_check "${url}" "${file}" || return 1
  fi

  if [[ "${validate_only}" == "true" ]]; then
    log::info "Valid mermaid diagram | file='${file}'"
    return 0
  fi

  local live_url output url_file
  live_url="${LIVE_BASE}$(pako_compress "${file}")"
  output="$(mint_output "${format}" "${url}" "${live_url}")"
  url_file="${file%.mmd}.${format}.url"
  printf '%s' "${output}" > "${url_file}"

  # Print verbatim so callers relay this exact value — never hand-reproduce the base64.
  echo "${output}"
  deliver_output "${output}" "${format}" "${url_file}"
}

main "${@}"
