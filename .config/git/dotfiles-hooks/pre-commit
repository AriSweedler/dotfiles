#!/bin/bash
#
# Pre-commit hook for the shared dotfiles repo.
# Ensures karabiner.json is sorted by key, and that a staged flake.lock locks every dev repo
# (.config/dotfiles/dev-repos) at a commit already on its origin/main.
#
# Setup (after fresh clone):
#   git df config core.hooksPath ~/.config/git/dotfiles-hooks

set -euo pipefail

readonly C_RED='\033[31m'
readonly C_GREEN='\033[32m'
readonly C_YELLOW='\033[33m'
readonly C_RST='\033[0m'

log::err()  { echo -e "${C_RED}[ERROR]${C_RST} $*" >&2; }
log::warn() { echo -e "${C_YELLOW}[WARN]${C_RST} $*" >&2; }
log::info() { echo -e "${C_GREEN}[INFO]${C_RST} $*" >&2; }

# A dev repo's flake input, locked in the shared flake's flake.lock, must name a commit already on
# that repo's origin/main, or every other machine's build fails to fetch it.
check_locked_rev() {
  local rel="${1}" input="${2}" sha sub top lock=".config/dotfiles/nix/flake.lock"
  top="$(git rev-parse --show-toplevel)"
  sha="$(git show ":${lock}" 2>/dev/null | jq -r --arg i "${input}" '.nodes[$i].locked.rev // empty')"
  [[ -n "${sha}" ]] || return 0
  sub="${top}/${rel}"
  [[ -e "${sub}/.git" ]] || { log::warn "${input} not checked out at ${rel}; its locked ${sha:0:8} is not checked."; return 0; }
  # The local origin/main first (a `dotfiles push` bump has just set it: no network);
  # only a miss asks the remote, in case another tool pushed without refreshing it.
  if git -C "${sub}" merge-base --is-ancestor "${sha}" origin/main 2>/dev/null; then
    return 0
  fi
  log::info "Checking ${input} ${sha:0:8} against the remote's main..."
  if ! git -C "${sub}" fetch -q origin main 2>/dev/null; then
    log::warn "Could not fetch ${input} origin; checking against the last fetch."
  fi
  if ! git -C "${sub}" merge-base --is-ancestor "${sha}" origin/main 2>/dev/null; then
    log::err "${input} is locked at ${sha:0:8}, which is not on origin/main."
    log::warn "Push it first (dotfiles push --submodules), then re-run the commit."
    return 1
  fi
  log::info "${input}'s locked commit is published."
}

# Every repo in .config/dotfiles/dev-repos, when flake.lock is staged.
check_locked_revs() {
  local top manifest rel="" input line
  top="$(git rev-parse --show-toplevel)"
  manifest="${top}/.config/dotfiles/dev-repos"
  [[ -f "${manifest}" ]] || return 0
  git diff --cached --name-only | grep -qx ".config/dotfiles/nix/flake.lock" || return 0
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    case "${line}" in
      path*=*) rel="${line#*=}"; rel="${rel# }" ;;
      input*=*) input="${line#*=}"; input="${input# }"; check_locked_rev "${rel}" "${input}" || return 1 ;;
    esac
  done < "${manifest}"
}

main() {
  check_locked_revs || return 1

  # git diff --cached --name-only emits paths relative to the repo root, and
  # the bare repo's worktree is $HOME — so match the repo-relative path, not an
  # absolute one (grep -qx needs a full-line match).
  local rel=".config/karabiner/karabiner.json"

  # Only check if karabiner.json is staged.
  if ! git diff --cached --name-only | grep -qx "${rel}"; then
    return 0
  fi

  log::info "Checking ${rel} is sorted by key..."

  local sorted staged
  sorted="$(git show ":${rel}" | jq --sort-keys)"
  staged="$(git show ":${rel}")"

  if [[ "${sorted}" != "${staged}" ]]; then
    log::err "${rel} is not sorted by key."
    log::warn "The generator writes this file with non-canonical key ordering."
    log::warn "Run 'bake' from ~/.config/karabiner to regenerate and sort, then re-stage."
    return 1
  fi

  log::info "karabiner.json is properly sorted."
}

main "$@"
