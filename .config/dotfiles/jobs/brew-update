#!/usr/bin/env zsh
# triggers: load
# cron: 40 */3 * * *
# timeout: 600
# Refreshes Homebrew every three hours, so interactive brew commands (auto-update off in
# zsh/plugins/brew.zsh) never pay for it. Updates only; upgrading everything is a separate opt-in.
export NO_COLOR=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_NO_INSTALL_CLEANUP=1
local brew
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do [[ -x "${brew}" ]] && break; done
[[ -x "${brew}" ]] || { print -u2 "brew-update: no brew under /opt/homebrew or /usr/local"; exit 1; }
"${brew}" update --quiet || exit $?
local -a formulae=(${(f)"$("${brew}" outdated --formula --quiet)"}) casks=(${(f)"$("${brew}" outdated --cask --quiet)"})
print "brew updated: ${#formulae} formulae and ${#casks} casks outdated"
