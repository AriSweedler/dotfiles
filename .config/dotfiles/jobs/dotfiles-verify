#!/usr/bin/env zsh
# cron: 5 10 * * 1
# timeout: 1800
# deps: node
# Weekly `dotfiles verify`: does this machine still match the baseline? A failure leaves
# ~/Desktop/new-machine-FAILED.md and notifies (ARI_DOTFILES_INVOKED_BY set = not interactive).
export ARI_DOTFILES_INVOKED_BY=dotfiles-jobs NO_COLOR=1
export GIT_TERMINAL_PROMPT=0 GIT_OPTIONAL_LOCKS=0
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_NO_INSTALL_CLEANUP=1
path=("${HOME}/.local/bin" $path)
exec "${HOME}/.config/bin/dotfiles" verify
