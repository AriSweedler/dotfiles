# System layer every machine gets. nix-darwin manages the Nix install itself (nix.enable).
{ config, lib, pkgs, user, ... }:
{
  imports = [ ./macos.nix ];

  # nix-darwin's /etc/zshenv runs set-environment, whose `export PATH=` replaces the caller's
  # PATH, in every zsh. Keep macOS's contract instead: a non-interactive script keeps the PATH
  # it was given (launchd jobs, the dotfiles test world's shims); only interactive and login
  # shells get the Nix environment, and scripts they start inherit it.
  environment.etc."zshenv".text = lib.mkForce ''
    # /etc/zshenv: generated by nix-darwin from ~/.config/dotfiles/nix/darwin.nix -- do not edit.
    if [ -n "''${__ETC_ZSHENV_SOURCED-}" ]; then return; fi
    __ETC_ZSHENV_SOURCED=1

    if [[ -o rcs ]] && [[ -o interactive || -o login ]]; then
      if [ -z "''${__NIX_DARWIN_SET_ENVIRONMENT_DONE-}" ]; then
        . ${config.system.build.setEnvironment}
      fi
      for p in ''${(z)NIX_PROFILES}; do
        fpath=($p/share/zsh/site-functions $p/share/zsh/$ZSH_VERSION/functions $p/share/zsh/vendor-completions $fpath)
      done
    fi

    if test -f /etc/zshenv.local; then
      source /etc/zshenv.local
    fi
  '';

  nix.enable = true;
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  # Activation reloads the daemon when /etc/nix/machines differs from the new system's, and
  # with no build machines neither file exists, so the diff failed and every switch reloaded it
  # and waited for it to come back. An empty file is no build machines.
  environment.etc."nix/machines".text = "";
  nixpkgs.hostPlatform = "aarch64-darwin";
  # Chrome, Spotify, Zoom and the like are unfree; a tier names each one it wants.
  nixpkgs.config.allowUnfree = true;

  system.primaryUser = user;
  users.users.${user}.home = "/Users/${user}";

  # Homebrew keeps what nixpkgs lacks or lags on, what has to live in /Applications, and what
  # config still finds by a brew path; every other package, GUI apps included, is in home.nix. A switch installs what is listed here and in the local
  # flake, and uninstalls what is not.
  homebrew = {
    enable = true;
    onActivation = {
      autoUpdate = false; # the brew-update dotfiles job refreshes Homebrew instead
      upgrade = false;
      cleanup = "uninstall";
    };
    global.autoUpdate = false;
    brews = [
      "beads" # tasks for AI agents; nixpkgs lags, and an older bd risks schema skew
      "tree-sitter" # nixpkgs lags (0.26 vs 0.27)
      "tree-sitter-cli"
    ];
    casks = [
      "karabiner-elements"
      "raycast"
    ];
  };

  # The Brewfile a switch applies, at a stable path: `brew bundle check --file=/etc/dotfiles/Brewfile`
  # checks by hand.
  environment.etc."dotfiles/Brewfile".text = config.homebrew.brewfile;

  # `brew bundle` takes seconds even when it has nothing to do. Skip it when the bundle command
  # (the Brewfile's store path and its flags) and Homebrew's install directories are what they
  # were after the last bundle that succeeded: a brew install or uninstall by hand changes a
  # directory's mtime, so the next switch bundles again.
  system.activationScripts.homebrew.text =
    let
      inherit (config.homebrew) prefix;
      bundle = config.homebrew.onActivation.brewBundleCmd { onlyCheck = false; };
      stamp = "/var/db/dotfiles-brew-bundle.stamp";
      state = ''printf '%s %s\n' ${builtins.hashString "sha256" bundle} "$(/usr/bin/stat -f %m ${prefix}/Cellar ${prefix}/Caskroom ${prefix}/Library/Taps 2>/dev/null | tr '\n' ' ')"'';
    in
    lib.mkForce ''
      echo >&2 "Homebrew bundle..."
      if [ ! -f "${prefix}/bin/brew" ]; then
        echo -e "\e[1;31merror: Homebrew is not installed, skipping...\e[0m" >&2
      elif [ "$(${state})" = "$(cat ${stamp} 2>/dev/null)" ]; then
        echo >&2 "Homebrew bundle: nothing changed since the last bundle; skipped"
      elif ${bundle}; then
        ${state} > ${stamp}
      else
        rm -f ${stamp}
        exit 1 # as a failed bundle stops the activation without the skip
      fi
    '';

  # The dotfiles jobs framework's one launchd job (screen unlock, login, every 5 minutes), under
  # the label `dotfiles jobs` reads; a switch replaces a plist `dotfiles jobs install` wrote, and
  # that command then defers here. The values mirror JOBS_* in dotfiles/lib/env.zsh.
  launchd.user.agents.dotfiles-jobs.serviceConfig =
    let
      home = "/Users/${user}";
      agent = pkgs.callPackage ./pkgs/dotfiles-jobs-agent { };
    in
    {
      Label = "com.${user}.dotfiles-jobs";
      ProgramArguments = [
        "${agent}/bin/dotfiles-jobs-agent"
        "${home}/.config/bin/dotfiles"
        "300"
        "com.apple.screenIsUnlocked"
      ];
      RunAtLoad = true;
      KeepAlive = true;
      EnvironmentVariables.PATH = lib.concatStringsSep ":" [
        "${home}/.config/bin"
        "/opt/homebrew/bin"
        "/opt/homebrew/sbin"
        "/etc/profiles/per-user/${user}/bin"
        "/run/current-system/sw/bin"
        "/nix/var/nix/profiles/default/bin"
        "/usr/local/bin"
        "/usr/bin"
        "/bin"
        "/usr/sbin"
        "/sbin"
      ];
      StandardOutPath = "${home}/.local/state/dotfiles/jobs/launchd.out.log";
      StandardErrorPath = "${home}/.local/state/dotfiles/jobs/launchd.err.log";
    };

  # Nerd Font for the terminal; nix-darwin installs it under /Library/Fonts/Nix Fonts.
  fonts.packages = [ pkgs.nerd-fonts.caskaydia-mono ];

  system.stateVersion = 6;
}
