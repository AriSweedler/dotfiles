#!/usr/bin/env zsh
# alttab-free-cert — ensure a local self-signed code-signing identity exists and is trusted.
#
# macOS keys every permission grant (Accessibility, Screen Recording) to the app's designated
# code requirement. An ad-hoc signature makes that requirement the binary's own hash, so each
# rebuild is a new app and the grants have to be redone. Signing with one stable local
# certificate makes the requirement "this bundle id, signed by this certificate", which every
# rebuild satisfies, so permissions are granted once per machine.
#
# alttab-free-build runs this before every build; it is also safe to run by hand. Creating the
# certificate happens once and needs one administrator password prompt, to trust it for code
# signing. Same recipe as upstream scripts/codesign/setup_local.sh, with a 10-year validity.

set -euo pipefail

readonly SCRIPT_DIR="${0:A:h}"
readonly SKILLS_DIR="${HOME}/.claude/skills"
readonly LIB_LOGGING="${SKILLS_DIR}/ari-skill-shellscripts/lib/logging.zsh"
if [[ ! -r "${LIB_LOGGING}" ]]; then
  print -u2 "[ERROR] missing shared logging lib | path='${LIB_LOGGING}'"
  exit 1
fi
source "${LIB_LOGGING}"

# --- Constants ---

readonly DEFAULT_NAME="AltTab Free Local"
readonly OPENSSL="/usr/bin/openssl"   # macOS's LibreSSL: its PKCS#12 output needs no -legacy flag
readonly CODESIGN="/usr/bin/codesign"
readonly VALID_DAYS=3650

DRY_RUN=false
WORK_DIR=""

# --- Prerequisites ---

#######################################
# Check that required binaries are installed.
# Globals: OPENSSL, CODESIGN
# Arguments: None
# Returns: 1 if any are missing
#######################################
check_prerequisites() {
  local missing=()
  for cmd in security "${OPENSSL}" "${CODESIGN}" mktemp awk; do
    command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
  done
  if (( ${#missing} > 0 )); then
    log::err "Missing required commands | missing='${(j:, :)missing}'"
    return 1
  fi
}

# --- Keychain queries ---

#######################################
# SHA-1 of every valid (trusted, unexpired, key present) code-signing identity with this exact name.
# Arguments: $1 identity name
# Outputs: one sha1 per line; empty if none
#######################################
valid_identity_sha1s() {
  local name="${1}"
  security find-identity -v -p codesigning 2>/dev/null \
    | awk -v q="\"${name}\"" '$1 ~ /^[0-9]+\)$/ && index($0, q) { print $2 }'
}

#######################################
# SHA-1 of a certificate with this name in the search list, valid identity or not. Empty if none.
# Arguments: $1 certificate name
#######################################
certificate_sha1() {
  local name="${1}"
  # find-certificate exits 44 when nothing matches; that is the "none" answer, not an error.
  security find-certificate -c "${name}" -Z 2>/dev/null | awk '/^SHA-1 hash:/ { print $3 }' || true
}

#######################################
# Path of the login keychain, unquoted.
#######################################
login_keychain() {
  security login-keychain | awk '{ gsub(/"/, ""); sub(/^[ \t]+/, ""); print }'
}

# --- Creation steps ---

#######################################
# Generate a self-signed code-signing certificate and wrap key and cert into a PKCS#12 file.
# Arguments: $1 work dir, $2 identity name
# Writes: cert.crt, cert.p12 and cert.pass (the throwaway PKCS#12 password) into the work dir
#######################################
generate_certificate() {
  local dir="${1}" name="${2}"
  local conf="${dir}/cert.conf" key="${dir}/cert.key" crt="${dir}/cert.crt" p12="${dir}/cert.p12" pass_file="${dir}/cert.pass"
  log::info "Generating self-signed certificate | name='${name}' valid_days='${VALID_DAYS}' openssl='${OPENSSL}'"
  cat > "${conf}" <<EOF
[ req ]
distinguished_name = req_name
prompt = no
[ req_name ]
CN = ${name}
[ extensions ]
basicConstraints = critical,CA:false
keyUsage = critical,digitalSignature
extendedKeyUsage = critical,1.3.6.1.5.5.7.3.3
1.2.840.113635.100.6.1.14 = critical,DER:0500
EOF
  log::debug "Generating RSA key | key='${key}'"
  "${OPENSSL}" genrsa -out "${key}" 2048 2>/dev/null
  log::debug "Signing certificate | crt='${crt}'"
  "${OPENSSL}" req -x509 -new -config "${conf}" -nodes -key "${key}" -extensions extensions \
    -sha256 -days "${VALID_DAYS}" -out "${crt}" 2>/dev/null
  "${OPENSSL}" rand -base64 24 > "${pass_file}"
  log::debug "Wrapping key and certificate into PKCS#12 | p12='${p12}'"
  "${OPENSSL}" pkcs12 -export -inkey "${key}" -in "${crt}" -out "${p12}" -passout "file:${pass_file}"
}

#######################################
# Import the PKCS#12 into the login keychain, letting codesign use the key.
# Arguments: $1 work dir, $2 keychain path
#######################################
import_identity() {
  local dir="${1}" keychain="${2}" result
  local p12="${dir}/cert.p12" pass_file="${dir}/cert.pass"
  log::info "Importing identity into login keychain | keychain='${keychain}' allowed_app='${CODESIGN}'"
  # Not run_cmd: the command line carries the PKCS#12 password.
  result="$(security import "${p12}" -k "${keychain}" -P "$(<"${pass_file}")" -T "${CODESIGN}" 2>&1)"
  log::debug "Import result | result='${result}'"
}

#######################################
# Mark the certificate trusted for code signing in the admin trust store. One admin password prompt.
# Arguments: $1 certificate file (PEM)
#######################################
trust_certificate() {
  local crt="${1}"
  log::warn "macOS will now ask for an administrator password: it trusts this certificate for code signing, once per machine"
  run_cmd security add-trusted-cert -d -r trustRoot -p codeSign "${crt}"
}

# --- Decision ---

#######################################
# Bring the identity into existence: already valid, a present-but-untrusted certificate to repair,
# or nothing yet to create from scratch. One log line per path.
# Arguments: $1 identity name, $2 keychain path, $3 work dir
# Outputs: "present", "repaired" or "created" on stdout
# Returns: 1 if the name is ambiguous
#######################################
ensure_identity() {
  local name="${1}" keychain="${2}" dir="${3}"
  local sha1s count cert_sha1
  sha1s="$(valid_identity_sha1s "${name}")"
  count="$(print -r -- "${sha1s}" | grep -c . || true)"
  if (( count > 1 )); then
    log::err "More than one valid identity carries this name; codesign would call it ambiguous | name='${name}' count='${count}' hint='delete the extras in Keychain Access, or pick another --name'"
    return 1
  fi
  if (( count == 1 )); then
    log::info "Identity already present and valid | name='${name}' sha1='${sha1s}'"
    echo "present"
    return 0
  fi
  cert_sha1="$(certificate_sha1 "${name}")"
  if [[ -n "${cert_sha1}" ]]; then
    log::info "Certificate exists but is not a valid signing identity; re-applying trust | name='${name}' sha1='${cert_sha1}'"
    security find-certificate -c "${name}" -p > "${dir}/cert.crt"
    trust_certificate "${dir}/cert.crt"
    echo "repaired"
    return 0
  fi
  log::info "No identity found; creating one | name='${name}'"
  generate_certificate "${dir}" "${name}"
  import_identity "${dir}" "${keychain}"
  trust_certificate "${dir}/cert.crt"
  echo "created"
}

#######################################
# Remove the temporary key material.
# Globals: WORK_DIR
#######################################
cleanup() {
  [[ -n "${WORK_DIR}" && -d "${WORK_DIR}" ]] && rm -rf "${WORK_DIR}"
  return 0
}

# --- Help ---

help() {
  cat <<EOF
${c_green}alttab-free-cert${c_rst} — ensure a local self-signed code-signing identity exists and is trusted

Signing AltTab with one stable certificate keeps its code requirement constant across rebuilds,
so macOS permission grants (Accessibility, Screen Recording) are done once per machine.

${c_bold}Usage:${c_rst}
  alttab-free-cert [OPTIONS]

${c_bold}Options:${c_rst}
  --name NAME     Common name of the identity (default: "${DEFAULT_NAME}")
  --status        Report whether the identity exists; change nothing. Exit 1 if it is missing
  --dry-run       Say what would happen without changing anything
  --verbose       Enable debug logging
  -h, --help      Show this help

${c_bold}Examples:${c_rst}
  alttab-free-cert                 # create on first run (one admin password prompt), no-op afterwards
  alttab-free-cert --status
  alttab-free-cert --dry-run

${c_bold}Output:${c_rst} key=value lines on stdout: identity, sha1, present, created.

${c_bold}Undo:${c_rst}
  security find-certificate -c "${DEFAULT_NAME}" -p > /tmp/c.pem && sudo security remove-trusted-cert -d /tmp/c.pem
  security delete-identity -c "${DEFAULT_NAME}"
EOF
}

# --- Main ---

main() {
  check_prerequisites || exit 1

  # === PARSE ===
  local verbose=false status_only=false name="${DEFAULT_NAME}"

  while (( $# > 0 )); do case "${1}" in
    -h|--help)   help; return 0 ;;
    --verbose)   verbose=true; shift ;;
    --dry-run)   DRY_RUN=true; shift ;;
    --status)    status_only=true; shift ;;
    --name)      name="${2:?--name requires a value}"; shift 2 ;;
    -*)          log::err "Unknown flag | flag='${1}'"; help; return 1 ;;
    *)           log::err "Unexpected argument | argument='${1}'"; help; return 1 ;;
  esac; done

  export VERBOSE="${verbose}"

  # === VALIDATE ===
  if [[ -z "${name}" || "${name}" == "-" ]]; then
    log::err "Identity name must be a certificate common name | name='${name}' hint='\"-\" is ad-hoc signing, which needs no certificate'"
    return 1
  fi
  log::debug "Parsed args | name='${name}' status_only='${status_only}' dry_run='${DRY_RUN}'"

  # === LOGIC ===
  local sha1 present="false"
  sha1="$(valid_identity_sha1s "${name}" | awk 'NR == 1')"   # not head: an early exit can SIGPIPE the producer under pipefail
  [[ -n "${sha1}" ]] && present="true"

  if [[ "${status_only}" == "true" || "${DRY_RUN}" == "true" ]]; then
    if [[ "${present}" == "true" ]]; then
      log::info "Identity present and valid | name='${name}' sha1='${sha1}'"
    elif [[ -n "$(certificate_sha1 "${name}")" ]]; then
      log::info "Certificate exists but is not trusted for code signing | name='${name}' sha1='$(certificate_sha1 "${name}")'"
      [[ "${DRY_RUN}" == "true" ]] && log::INFO "Would: re-apply trust in the admin trust store (one admin password prompt)"
    else
      log::info "Identity missing | name='${name}'"
      [[ "${DRY_RUN}" == "true" ]] && log::INFO "Would: generate a ${VALID_DAYS}-day self-signed certificate (CN='${name}')
import it into $(login_keychain) with ${CODESIGN} allowed to use the key
trust it for code signing in the admin trust store (one admin password prompt)"
    fi
    cat <<EOF
identity=${name}
sha1=${sha1}
present=${present}
created=false
EOF
    [[ "${status_only}" == "true" && "${present}" == "false" ]] && return 1
    return 0
  fi

  WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/alttab-free-cert.XXXXXX")"
  trap cleanup EXIT

  local outcome created="false"
  outcome="$(ensure_identity "${name}" "$(login_keychain)" "${WORK_DIR}")"
  [[ "${outcome}" == "created" ]] && created="true"

  sha1="$(valid_identity_sha1s "${name}" | awk 'NR == 1')"
  if [[ -z "${sha1}" ]]; then
    log::err "Identity still not valid for code signing | name='${name}' outcome='${outcome}' hint='was the trust prompt cancelled? re-run; or inspect with: security find-certificate -c \"${name}\" -p | security verify-cert -c /dev/stdin -p codeSign'"
    return 1
  fi
  log::ok "Identity ready | name='${name}' sha1='${sha1}' outcome='${outcome}'"
  if [[ "${outcome}" != "present" ]]; then
    log::warn "The first codesign that uses this key may show a Keychain dialog; choose Always Allow"
  fi

  cat <<EOF
identity=${name}
sha1=${sha1}
present=true
created=${created}
EOF
}

main "${@}"
